# Configuration pour l'environnement staging
# Le Circographe - Staging Environment
# Copiez ce fichier vers .env.staging et configurez vos valeurs

# Rails Environment
RAILS_ENV=staging
RAILS_LOG_LEVEL=debug

# Database
DATABASE_URL=sqlite3:storage/staging.sqlite3

# Staging Host Configuration
STAGING_HOST=staging.lecircographe.fr
STAGING_SSL=false

# Email Configuration
STAGING_EMAIL_METHOD=letter_opener
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587

# Performance
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1

# Maintenance Mode (désactivé par défaut en staging)
MAINTENANCE_MODE=false

# Public registration (/registration). false for showcase-only.
PUBLIC_REGISTRATION_ENABLED=true

# SolidCache Configuration
SOLID_CACHE_EXPIRES_IN=86400
SOLID_CACHE_MAX_ENTRIES=5000

# SolidQueue Configuration
SOLID_QUEUE_IN_PUMA=true

# Security (moins strict que production)
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false
