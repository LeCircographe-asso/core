# Configuration pour l'environnement production
# Le Circographe - Production Environment
# Copiez ce fichier vers .env.production et configurez vos valeurs

# Rails Environment
RAILS_ENV=production
RAILS_LOG_LEVEL=info

# Database
DATABASE_URL=sqlite3:storage/production.sqlite3

# Production Host Configuration
PRODUCTION_HOST=lecircographe.fr
PRODUCTION_SSL=true

# Email Configuration (Mailjet)
SMTP_ADDRESS=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=your_mailjet_api_key
SMTP_PASSWORD=your_mailjet_secret_key

# Performance
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=2

# Maintenance Mode — true tant que le site n'est pas lancé publiquement.
# En prod réelle, positionné dans config/deploy.production.yml (env.clear),
# pas via cette variable d'env locale.
MAINTENANCE_MODE=true

# Autorise l'indexation Google (X-Robots-Tag). Peut être activé avant la levée
# de MAINTENANCE_MODE : sans effet tant que la maintenance bloque tout.
SEO_INDEXABLE=true

# Public sign-up (/registration). Set false for showcase-only deploy (login still works).
PUBLIC_REGISTRATION_ENABLED=true

# Account claim / recover member record (link Person to web account). false = disabled.
ACCOUNT_CLAIM_ENABLED=true

# SolidCache Configuration
SOLID_CACHE_EXPIRES_IN=86400
SOLID_CACHE_MAX_ENTRIES=10000

# SolidQueue Configuration
SOLID_QUEUE_IN_PUMA=true

# Security
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true

# External Services
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Social Media URLs
INSTAGRAM_URL=https://www.instagram.com/lecircographe/
FACEBOOK_URL=https://www.facebook.com/lecircographe
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/HUd6jvELxqVD642vfgVXBq
GOOGLE_PAGE_URL=https://share.google/ljLBRjVB5FoNNJV3o
