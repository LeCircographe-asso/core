# Configuration pour l'environnement de développement local
# Le Circographe - Development Environment
# Copiez ce fichier vers .env.development et configurez vos valeurs

# Rails Environment
RAILS_ENV=development
RAILS_LOG_LEVEL=debug

# Database
DATABASE_URL=sqlite3:storage/development.sqlite3

# Development Host Configuration
DEVELOPMENT_HOST=localhost
DEVELOPMENT_PORT=3000

# Email Configuration (letter_opener pour développement)
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=localhost

# Performance
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1

# Maintenance Mode (désactivé par défaut en développement)
MAINTENANCE_MODE=false

# Inscriptions publiques (/registration). false = vitrine (connexion uniquement).
PUBLIC_REGISTRATION_ENABLED=true

# SolidCache Configuration
SOLID_CACHE_EXPIRES_IN=3600
SOLID_CACHE_MAX_ENTRIES=1000

# SolidQueue Configuration
SOLID_QUEUE_IN_PUMA=true

# Security (moins strict que production)
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# External Services (clés de test)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
MAILJET_API_KEY=your_test_mailjet_api_key
MAILJET_SECRET_KEY=your_test_mailjet_secret_key

# Google Analytics (désactivé en développement)
GOOGLE_ANALYTICS_ID=

# Social Media URLs
INSTAGRAM_URL=https://www.instagram.com/lecircographe/
FACEBOOK_URL=https://www.facebook.com/lecircographe
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/HUd6jvELxqVD642vfgVXBq
GOOGLE_PAGE_URL=https://share.google/ljLBRjVB5FoNNJV3o

# Development specific
RAILS_SERVE_STATIC_FILES=true
RAILS_SKIP_ASSET_PRECOMPILATION=false
