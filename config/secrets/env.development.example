# Configuration Development - Le Circographe
# Copier ce fichier vers .env.development et remplir les valeurs

# Rails Environment
RAILS_ENV=development
RAILS_MASTER_KEY=development_key_here

# Database
DATABASE_URL=sqlite3:storage/development.sqlite3

# Mail (Development)
MAILJET_API_KEY=your_development_mailjet_key
MAILJET_SECRET_KEY=your_development_mailjet_secret

# Stripe (Development - Test Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_development_key_here
STRIPE_SECRET_KEY=sk_test_development_key_here
STRIPE_WEBHOOK_SECRET=whsec_development_webhook_secret

# Application
SECRET_KEY_BASE=development_secret_key_base_here
STAGING_MODE=false

# Logging
RAILS_LOG_LEVEL=debug
