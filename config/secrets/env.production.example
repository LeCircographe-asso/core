# Configuration Production - Le Circographe
# Variables d'environnement pour le VPS production

# Rails Environment
RAILS_ENV=production
RAILS_MASTER_KEY=production_master_key_here

# Database
DATABASE_URL=sqlite3:storage/production.sqlite3

# Mail (Production)
MAILJET_API_KEY=your_production_mailjet_key
MAILJET_SECRET_KEY=your_production_mailjet_secret

# Stripe (Production - Live Keys)
STRIPE_PUBLISHABLE_KEY=pk_live_production_key_here
STRIPE_SECRET_KEY=sk_live_production_key_here
STRIPE_WEBHOOK_SECRET=whsec_production_webhook_secret

# Application
SECRET_KEY_BASE=production_secret_key_base_here
STAGING_MODE=false

# Server Configuration
RAILS_SERVE_STATIC_FILES=true
WEB_CONCURRENCY=2
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info

# Kamal Registry
KAMAL_REGISTRY_PASSWORD=your_github_token_for_registry

# Production specific
PRODUCTION_SERVER_IP=your_production_server_ip
