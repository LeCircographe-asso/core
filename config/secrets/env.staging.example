# Configuration Staging - Le Circographe
# Variables d'environnement pour le VPS staging

# Rails Environment
RAILS_ENV=staging
RAILS_MASTER_KEY=staging_master_key_here

# Database
DATABASE_URL=sqlite3:storage/staging.sqlite3

# Mail (Staging - Test)
MAILJET_API_KEY=your_staging_mailjet_key
MAILJET_SECRET_KEY=your_staging_mailjet_secret

# Stripe (Staging - Test Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_staging_key_here
STRIPE_SECRET_KEY=sk_test_staging_key_here
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret

# Application
SECRET_KEY_BASE=staging_secret_key_base_here
STAGING_MODE=true
STAGING_AUTH=true
STAGING_PASSWORD=your_staging_password

# Server Configuration
RAILS_SERVE_STATIC_FILES=true
WEB_CONCURRENCY=0
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info

# Kamal Registry
KAMAL_REGISTRY_PASSWORD=your_github_token_for_registry
