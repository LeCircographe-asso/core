#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

app_root = File.expand_path("..", __dir__)
Dir.chdir(app_root)

lock_dir = File.join(app_root, "tmp", "locks")
FileUtils.mkdir_p(lock_dir)
lock_file = File.join(lock_dir, "rspec.sqlite.lock")

File.open(lock_file, File::RDWR | File::CREAT, 0o644) do |f|
  unless f.flock(File::LOCK_EX | File::LOCK_NB)
    warn "⏳ SQLite test DB busy: waiting for the current RSpec process to finish..."
    warn "   Inspect running test processes with: ps -ef | rg 'bin/test|bin/rspec|guard|rspec'"
    f.flock(File::LOCK_EX)
  end
  exec("bundle", "exec", "rspec", *ARGV)
end
