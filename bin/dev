#!/usr/bin/env bash

# Load RVM if available
if [[ -s "$HOME/.rvm/scripts/rvm" ]]; then
  source "$HOME/.rvm/scripts/rvm"
elif [[ -s "/usr/local/rvm/scripts/rvm" ]]; then
  source "/usr/local/rvm/scripts/rvm"
fi

# Check if foreman is available via PATH or bundle.
FOREMAN_CMD=()
if command -v foreman &> /dev/null; then
  FOREMAN_CMD=(foreman)
elif bundle exec which foreman &> /dev/null; then
  FOREMAN_CMD=(bundle exec foreman)
else
  echo "Installing foreman..."
  # Install into current Ruby/RVM context to avoid user-gem PATH/hook mismatches.
  if gem install foreman 2>/dev/null; then
    if command -v foreman &> /dev/null; then
      FOREMAN_CMD=(foreman)
    elif bundle exec which foreman &> /dev/null; then
      FOREMAN_CMD=(bundle exec foreman)
    else
      echo "Error: foreman was installed but is still unavailable."
      echo "Try running: bundle add foreman --group development"
      exit 1
    fi
  else
    echo "Error: Could not install foreman. Please install it manually: gem install foreman"
    exit 1
  fi
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

# Dev DB guard: warn early when DB looks empty.
DB_USERS_COUNT="$(bundle exec rails runner "print User.count" 2>/dev/null || true)"
if [[ "$DB_USERS_COUNT" == "0" ]]; then
  echo "[dev.db.guard] WARNING: users_count=0 in development DB."
  echo "[dev.db.guard] Run: bin/rails circographe:fix_local_db (or bin/rails db:seed)"
fi

# Dev DB guard: warn if expected system accounts are missing.
DB_SYSTEM_ACCOUNTS_STATUS="$(bundle exec rails runner "emails=%w[super-admin@rails.com admin@rails.com volunteer@rails.com]; missing=emails.reject { |e| User.exists?(email_address: e) }; print missing.join(',')" 2>/dev/null || true)"
if [[ -n "$DB_SYSTEM_ACCOUNTS_STATUS" ]]; then
  echo "[dev.db.guard] WARNING: missing system account(s): $DB_SYSTEM_ACCOUNTS_STATUS"
  echo "[dev.db.guard] Run: bin/rails circographe:seed_system_accounts (or bin/rails circographe:fix_local_db)"
fi

echo "Precompiling assets..."
if ! bundle exec rails assets:precompile; then
  echo "Error: assets:precompile failed."
  exit 1
fi

exec "${FOREMAN_CMD[@]}" start -f Procfile.dev "$@"
