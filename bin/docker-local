#!/usr/bin/env bash
# Run the staging / production images from ghcr.io locally (docker/local/compose.yml).
# Docs: docs/development/docker_local.md
#
#   bin/docker-local login                         docker login ghcr.io with your gh token (needs read:packages)
#   bin/docker-local pull <env> [tag|running]      pull an image; default tag "latest",
#                                                  "running" = the image the VPS runs right now
#   bin/docker-local up <env>                      start on a fresh-or-existing local database, wait for /up
#   bin/docker-local down <env> [--reset]          stop; --reset also deletes that env's local database
#   bin/docker-local logs <env>                    follow the app logs
#   bin/docker-local console <env>                 rails console inside the container
#   bin/docker-local admin <env>                   create the first super admin (interactive)
#   bin/docker-local status                        containers, images and URLs
#
# <env> = staging | production
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$ROOT/docker/local"
ENV_FILE="$DIR/.env.local"
STAGING_URL="http://127.0.0.1:8081"
PRODUCTION_URL="http://127.0.0.1:8082"

usage() { sed -n '5,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

# Everything compose needs (container env + image tags) lives in .env.local, passed both as
# env_file and --env-file: no reliance on exported variables, which Docker Desktop's
# docker.exe does not receive when WSL integration is off.
compose() { require_docker; ensure_env_file; (cd "$DIR" && docker compose --env-file .env.local "$@"); }

# Under WSL, Docker Desktop's "WSL integration" must be enabled for this distro: without it
# `docker` is a shim to docker.exe, which breaks `compose ps/exec` and env forwarding.
require_docker() {
  if grep -qi microsoft /proc/version 2>/dev/null && [ ! -x /usr/bin/docker ]; then
    echo "Docker Desktop's WSL integration is off for this distro (${WSL_DISTRO_NAME:-?})." >&2
    echo "Docker Desktop > Settings > Resources > WSL integration > enable it, Apply & restart." >&2
    exit 1
  fi
  docker info >/dev/null 2>&1 || { echo "Docker daemon unreachable: start Docker Desktop" >&2; exit 1; }
}

ensure_env_file() {
  [ -f "$ENV_FILE" ] && return
  [ -f "$ROOT/config/master.key" ] || { echo "config/master.key missing: ask a maintainer for it" >&2; exit 1; }
  umask 077
  {
    echo "# Generated by bin/docker-local, never commit (gitignored)."
    echo "RAILS_MASTER_KEY=$(cat "$ROOT/config/master.key")"
    echo "SECRET_KEY_BASE=$(openssl rand -hex 64)"
    echo "STAGING_PASSWORD=local"
    echo "STAGING_TAG=latest"
    echo "PRODUCTION_TAG=latest"
  } > "$ENV_FILE"
  echo "Created $ENV_FILE"
}

set_tag() { # set_tag <VAR> <value>
  sed -i "s/^$1=.*/$1=$2/" "$ENV_FILE"
}

# A production image whose entrypoint restores Litestream but predates the
# LITESTREAM_RESTORE_ON_BOOT switch would download the production replica on first boot
# (personal data on a laptop): refuse to start it.
check_litestream_guard() {
  local image entrypoint
  image="$(image_repo production):$(grep '^PRODUCTION_TAG=' "$ENV_FILE" | cut -d= -f2-)"
  entrypoint="$(docker run --rm --pull never --entrypoint cat "$image" bin/docker-entrypoint)" ||
    { echo "Cannot read $image: bin/docker-local pull production first" >&2; exit 1; }
  if grep -q 'litestream:restore' <<<"$entrypoint" && ! grep -q 'LITESTREAM_RESTORE_ON_BOOT' <<<"$entrypoint"; then
    echo "Refusing to start $image: it restores the production Litestream replica on boot" >&2
    echo "and has no LITESTREAM_RESTORE_ON_BOOT switch. Pick a newer tag." >&2
    exit 1
  fi
}

check_env() {
  case "${1:-}" in staging|production) ;; *) usage ;; esac
}

image_repo() { [ "$1" = staging ] && echo "ghcr.io/lecircographe-asso/circographe-staging" || echo "ghcr.io/lecircographe-asso/circographe"; }
tag_var() { [ "$1" = staging ] && echo STAGING_TAG || echo PRODUCTION_TAG; }
url_for() { [ "$1" = staging ] && echo "$STAGING_URL" || echo "$PRODUCTION_URL"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  login)
    require_docker
    gh auth status >/dev/null 2>&1 || { echo "gh is not logged in: gh auth login" >&2; exit 1; }
    if ! gh auth status 2>&1 | grep -qE "(read|write):packages"; then
      echo "Your gh token lacks read:packages. Run once: gh auth refresh -s read:packages" >&2
      exit 1
    fi
    gh auth token | docker login ghcr.io -u "$(gh api user --jq .login)" --password-stdin
    ;;
  pull)
    env="${1:-}"; check_env "$env"; tag="${2:-latest}"
    require_docker
    ensure_env_file
    if [ "$tag" = running ]; then
      tag="$(ssh -n circographe-deploy "docker ps --filter label=service=circographe-$env --filter label=role=web --format '{{.Image}}'" | head -n1 | sed 's/.*://')"
      [ -n "$tag" ] || { echo "No running $env container found on the VPS" >&2; exit 1; }
      echo "VPS runs $env image tag $tag"
    fi
    echo "$tag" | grep -Eq '^[A-Za-z0-9._-]+$' || { echo "Invalid tag: $tag" >&2; exit 1; }
    docker pull "$(image_repo "$env"):$tag"
    set_tag "$(tag_var "$env")" "$tag"
    ;;
  up)
    env="${1:-}"; check_env "$env"
    require_docker
    ensure_env_file
    [ "$env" = production ] && check_litestream_guard
    compose --profile "$env" up -d "$env"
    # Compose does not notice edits to the proxy's inline Caddyfile: always recreate it (1 s).
    compose --profile "$env" up -d --force-recreate proxy
    url="$(url_for "$env")"
    printf "Waiting for %s/up " "$url"
    for _ in $(seq 1 60); do
      if curl -fsS -o /dev/null "$url/up" 2>/dev/null; then
        echo "OK"
        echo "$env: $url"
        [ "$env" = staging ] && echo "  basic auth: staging / $(grep '^STAGING_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
        echo "  first admin: bin/docker-local admin $env"
        exit 0
      fi
      printf "."; sleep 2
    done
    echo; echo "Not healthy after 2 min, last logs:" >&2
    compose --profile "$env" logs --tail 40 "$env" >&2
    exit 1
    ;;
  down)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" stop "$env"
    compose --profile "$env" rm -f "$env"
    if [ "${2:-}" = "--reset" ]; then
      docker volume rm "circographe-local_${env}_storage" && echo "Local $env database deleted"
    fi
    ;;
  logs)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" logs -f --tail 100 "$env"
    ;;
  console)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" exec "$env" bin/rails console
    ;;
  admin)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" exec "$env" bin/rails circographe:create_super_admin
    ;;
  status)
    compose --profile staging --profile production ps
    [ -f "$ENV_FILE" ] && grep -E '^(STAGING|PRODUCTION)_TAG=' "$ENV_FILE"
    echo "staging:    $STAGING_URL"
    echo "production: $PRODUCTION_URL"
    ;;
  ''|-h|--help|help) usage 0 ;;
  *) usage ;;
esac
