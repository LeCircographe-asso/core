#!/usr/bin/env bash
# Run the staging / production images from ghcr.io locally (docker/local/compose.yml).
# Docs: docs/development/docker_local.md
#
#   bin/docker-local login                         docker login ghcr.io with your gh token (needs read:packages)
#   bin/docker-local pull <env> [tag|running]      pull an image; default tag "latest",
#                                                  "running" = the image the VPS runs right now
#   bin/docker-local up <env>                      start on a fresh-or-existing local database, wait for /up
#   bin/docker-local down <env> [--reset]          stop; --reset also deletes that env's local database
#   bin/docker-local logs <env>                    follow the app logs
#   bin/docker-local console <env>                 rails console inside the container
#   bin/docker-local admin <env>                   create the first super admin (interactive)
#   bin/docker-local status                        containers, images and URLs
#   bin/docker-local build                         build the staging image from the working tree (tag "local")
#   bin/docker-local upgrade [from] [to]           staging upgrade rehearsal: demo data on image <from>
#                                                  (default: running), then image <to> (default: local)
#                                                  on the same database, data report compared
#   bin/docker-local upgrade-clean                 remove a rehearsal kept after a failure
#
# <env> = staging | production. Tags: a git sha, latest, running (what the VPS runs),
# local (built from your working tree, uncommitted changes included).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$ROOT/docker/local"
ENV_FILE="$DIR/.env.local"
STAGING_URL="https://127.0.0.1:8081"
PRODUCTION_URL="https://127.0.0.1:8082"

usage() { sed -n '5,22p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

# Everything compose needs (container env + image tags) lives in .env.local, passed both as
# env_file and --env-file: no reliance on exported variables, which Docker Desktop's
# docker.exe does not receive when WSL integration is off.
compose() { require_docker; ensure_env_file; (cd "$DIR" && docker compose --env-file .env.local "$@"); }

# Under WSL, Docker Desktop's "WSL integration" must be enabled for this distro: without it
# `docker` is a shim to docker.exe, which breaks `compose ps/exec` and env forwarding.
require_docker() {
  if grep -qi microsoft /proc/version 2>/dev/null && [ ! -x /usr/bin/docker ]; then
    echo "Docker Desktop's WSL integration is off for this distro (${WSL_DISTRO_NAME:-?})." >&2
    echo "Docker Desktop > Settings > Resources > WSL integration > enable it, Apply & restart." >&2
    exit 1
  fi
  docker info >/dev/null 2>&1 || { echo "Docker daemon unreachable: start Docker Desktop" >&2; exit 1; }
}

ensure_env_file() {
  [ -f "$ENV_FILE" ] && return
  [ -f "$ROOT/config/master.key" ] || { echo "config/master.key missing: ask a maintainer for it" >&2; exit 1; }
  umask 077
  {
    echo "# Generated by bin/docker-local, never commit (gitignored)."
    echo "RAILS_MASTER_KEY=$(cat "$ROOT/config/master.key")"
    echo "SECRET_KEY_BASE=$(openssl rand -hex 64)"
    echo "STAGING_PASSWORD=local"
    echo "STAGING_TAG=latest"
    echo "PRODUCTION_TAG=latest"
  } > "$ENV_FILE"
  echo "Created $ENV_FILE"
}

set_tag() { # set_tag <VAR> <value>
  sed -i "s/^$1=.*/$1=$2/" "$ENV_FILE"
}

# A production image whose entrypoint restores Litestream but predates the
# LITESTREAM_RESTORE_ON_BOOT switch would download the production replica on first boot
# (personal data on a laptop): refuse to start it.
check_litestream_guard() {
  local image entrypoint
  image="$(image_repo production):$(grep '^PRODUCTION_TAG=' "$ENV_FILE" | cut -d= -f2-)"
  entrypoint="$(docker run --rm --pull never --entrypoint cat "$image" bin/docker-entrypoint)" ||
    { echo "Cannot read $image: bin/docker-local pull production first" >&2; exit 1; }
  if grep -q 'litestream:restore' <<<"$entrypoint" && ! grep -q 'LITESTREAM_RESTORE_ON_BOOT' <<<"$entrypoint"; then
    echo "Refusing to start $image: it restores the production Litestream replica on boot" >&2
    echo "and has no LITESTREAM_RESTORE_ON_BOOT switch. Pick a newer tag." >&2
    exit 1
  fi
}

check_env() {
  case "${1:-}" in staging|production) ;; *) usage ;; esac
}

image_repo() { [ "$1" = staging ] && echo "ghcr.io/lecircographe-asso/circographe-staging" || echo "ghcr.io/lecircographe-asso/circographe"; }
tag_var() { [ "$1" = staging ] && echo STAGING_TAG || echo PRODUCTION_TAG; }
url_for() { [ "$1" = staging ] && echo "$STAGING_URL" || echo "$PRODUCTION_URL"; }

# resolve_tag <env> <tag|running>: "running" = the tag of the image the VPS runs right now.
resolve_tag() {
  local tag="$2"
  if [ "$tag" = local ] && [ "$1" != staging ]; then
    echo "Tag local is staging only (production images need production credentials)" >&2; exit 1
  fi
  if [ "$tag" = running ]; then
    tag="$(ssh -n circographe-deploy "docker ps --filter label=service=circographe-$1 --filter label=role=web --format '{{.Image}}'" | head -n1 | sed 's/.*://')"
    [ -n "$tag" ] || { echo "No running $1 container found on the VPS" >&2; exit 1; }
  fi
  echo "$tag" | grep -Eq '^[A-Za-z0-9._-]+$' || { echo "Invalid tag: $tag" >&2; exit 1; }
  echo "$tag"
}

# build_local <log file>: the staging image of the working tree, as deploy-staging builds it
# (same Dockerfile, amd64). config/master.key is excluded by .dockerignore.
build_local() {
  echo "Building $(image_repo staging):local from the working tree (first build: a few minutes)..."
  if ! docker build --platform linux/amd64 -t "$(image_repo staging):local" "$ROOT" > "$1" 2>&1; then
    tail -n 30 "$1" >&2
    echo "Build failed, full log: $1" >&2
    exit 1
  fi
}

# fetch_image <env> <tag>: build "local", pull anything else.
fetch_image() {
  if [ "$2" = local ]; then
    build_local "$ROOT/tmp/docker-local/build.log"
  else
    docker pull -q "$(image_repo "$1"):$2" >/dev/null
  fi
}

# --- Upgrade rehearsal: its own compose project and volume, no proxy, never touches the
# --- local staging database. Same guards as `up` (mounted mail initializer, no recurring jobs).
UPGRADE_PROJECT="circographe-upgrade"
UPGRADE_CONTAINER="$UPGRADE_PROJECT-staging-1"
upgrade_compose() { (cd "$DIR" && docker compose -p "$UPGRADE_PROJECT" --env-file .env.local --profile staging "$@"); }

# wait_up <container>: poll /up from inside the container; fail fast if it stops.
wait_up() {
  local state
  for _ in $(seq 1 150); do
    state="$(docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null || echo missing)"
    [ "$state" = running ] || { echo; echo "Container $1 is $state" >&2; return 1; }
    if docker exec "$1" ruby -rnet/http -e 'exit Net::HTTP.get_response(URI("http://127.0.0.1/up")).is_a?(Net::HTTPSuccess)' 2>/dev/null; then
      echo " up"; return 0
    fi
    printf "."; sleep 2
  done
  echo; echo "Container $1 not healthy after 5 min" >&2; return 1
}

# data_report <container> <host output> [host before.json]: run ops/data_report.rb inside the
# container (copied in, so it also works on images that predate it). Exit 1 = problems found.
data_report() {
  local rc=0 env_args=(-e DATA_REPORT_OUTPUT=/tmp/data_report.json)
  docker cp -q "$ROOT/ops/data_report.rb" "$1:/tmp/data_report.rb"
  if [ -n "${3:-}" ]; then
    docker cp -q "$3" "$1:/tmp/data_report_before.json"
    env_args+=(-e DATA_REPORT_BEFORE=/tmp/data_report_before.json)
  fi
  docker exec "${env_args[@]}" "$1" bin/rails runner /tmp/data_report.rb >/dev/null || rc=$?
  docker cp -q "$1:/tmp/data_report.json" "$2" 2>/dev/null || { echo "Data report failed to run (exit $rc)" >&2; return 2; }
  return "$rc"
}

upgrade_failed() { # upgrade_failed <out dir> <reason>
  upgrade_compose logs --no-color --no-log-prefix staging > "$1/new-image.log" 2>&1 || true
  echo "UPGRADE FAILED: $2" >&2
  echo "  reports and logs: $1" >&2
  echo "  kept for inspection: docker logs $UPGRADE_CONTAINER | docker exec -it $UPGRADE_CONTAINER bin/rails console" >&2
  echo "  then: bin/docker-local upgrade-clean" >&2
  exit 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  login)
    require_docker
    gh auth status >/dev/null 2>&1 || { echo "gh is not logged in: gh auth login" >&2; exit 1; }
    if ! gh auth status 2>&1 | grep -qE "(read|write):packages"; then
      echo "Your gh token lacks read:packages. Run once: gh auth refresh -s read:packages" >&2
      exit 1
    fi
    gh auth token | docker login ghcr.io -u "$(gh api user --jq .login)" --password-stdin
    ;;
  pull)
    env="${1:-}"; check_env "$env"
    require_docker
    ensure_env_file
    tag="$(resolve_tag "$env" "${2:-latest}")"
    [ "${2:-}" = running ] && echo "VPS runs $env image tag $tag"
    docker pull "$(image_repo "$env"):$tag"
    set_tag "$(tag_var "$env")" "$tag"
    ;;
  up)
    env="${1:-}"; check_env "$env"
    require_docker
    ensure_env_file
    [ "$env" = production ] && check_litestream_guard
    compose --profile "$env" up -d "$env"
    # Compose does not notice edits to the proxy's inline Caddyfile: always recreate it (1 s).
    compose --profile "$env" up -d --force-recreate proxy
    url="$(url_for "$env")"
    printf "Waiting for %s/up " "$url"
    for _ in $(seq 1 60); do
      if curl -kfsS -o /dev/null "$url/up" 2>/dev/null; then
        echo "OK"
        echo "$env: $url"
        [ "$env" = staging ] && echo "  basic auth: staging / $(grep '^STAGING_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
        echo "  first admin: bin/docker-local admin $env"
        exit 0
      fi
      printf "."; sleep 2
    done
    echo; echo "Not healthy after 2 min, last logs:" >&2
    compose --profile "$env" logs --tail 40 "$env" >&2
    exit 1
    ;;
  down)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" stop "$env"
    compose --profile "$env" rm -f "$env"
    # The proxy serves both ports: keep it while the other environment runs, drop it otherwise.
    if [ -z "$(compose --profile staging --profile production ps -q staging production)" ]; then
      compose --profile "$env" stop proxy
      compose --profile "$env" rm -f proxy
    fi
    if [ "${2:-}" = "--reset" ]; then
      docker volume rm "circographe-local_${env}_storage" && echo "Local $env database deleted"
    fi
    ;;
  logs)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" logs -f --tail 100 "$env"
    ;;
  console)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" exec "$env" bin/rails console
    ;;
  admin)
    env="${1:-}"; check_env "$env"
    compose --profile "$env" exec "$env" bin/rails circographe:create_super_admin
    ;;
  status)
    compose --profile staging --profile production ps
    [ -f "$ENV_FILE" ] && grep -E '^(STAGING|PRODUCTION)_TAG=' "$ENV_FILE"
    echo "staging:    $STAGING_URL"
    echo "production: $PRODUCTION_URL"
    ;;
  build)
    require_docker
    ensure_env_file
    mkdir -p "$ROOT/tmp/docker-local"
    build_local "$ROOT/tmp/docker-local/build.log"
    set_tag STAGING_TAG local
    echo "Done. bin/docker-local up staging now runs this image."
    ;;
  upgrade)
    require_docker
    ensure_env_file
    from="$(resolve_tag staging "${1:-running}")"
    to="$(resolve_tag staging "${2:-local}")"
    out="$ROOT/tmp/docker-local/upgrade-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$out"
    echo "Upgrade rehearsal (staging): $from -> $to"
    [ "$from" != "$to" ] || echo "  note: both tags are the same image, this only checks a restart"
    fetch_image staging "$from"
    fetch_image staging "$to"
    upgrade_compose down -v --remove-orphans >/dev/null 2>&1 || true

    printf "1/4 fresh database + demo data on %s " "${from:0:12}"
    STAGING_TAG="$from" SEED_DEMO=true SEED_LEAN=false upgrade_compose up -d staging >/dev/null 2>&1
    wait_up "$UPGRADE_CONTAINER" || upgrade_failed "$out" "the old image did not boot"
    upgrade_compose logs --no-color --no-log-prefix staging > "$out/old-image.log" 2>&1

    echo "2/4 data report before"
    data_report "$UPGRADE_CONTAINER" "$out/before.json" || upgrade_failed "$out" "data report on the old image"
    docker exec "$UPGRADE_CONTAINER" ruby -rjson -e '
      r = JSON.parse(File.read("/tmp/data_report.json")); t = r["tables"]
      puts "    schema #{r["schema_version"]}, #{t.values.sum} rows, #{t["people"].to_i} people, #{t["payments"].to_i} payments"
      warn "    WARNING: little data, the old image may not support SEED_DEMO" if t["people"].to_i < 10'

    printf "3/4 image %s on the same database (what kamal deploy does) " "${to:0:12}"
    STAGING_TAG="$to" SEED_DEMO=true SEED_LEAN=false upgrade_compose up -d staging >/dev/null 2>&1
    wait_up "$UPGRADE_CONTAINER" || upgrade_failed "$out" "the new image did not boot (migration error? see new-image.log)"
    upgrade_compose logs --no-color --no-log-prefix staging > "$out/new-image.log" 2>&1
    grep -E "^== [0-9]+ .*: migrated" "$out/new-image.log" | sed -E 's/ =+$//; s/^/    migration /' || echo "    no migration to run"

    echo "4/4 data report after, compared"
    rc=0; data_report "$UPGRADE_CONTAINER" "$out/after.json" "$out/before.json" || rc=$?
    [ "$rc" -le 1 ] || upgrade_failed "$out" "data report on the new image"
    docker exec "$UPGRADE_CONTAINER" ruby -rjson -e '
      r = JSON.parse(File.read("/tmp/data_report.json")); b = JSON.parse(File.read("/tmp/data_report_before.json"))
      puts "    schema #{b["schema_version"]} -> #{r["schema_version"]}, rows #{b["tables"].values.sum} -> #{r["tables"].values.sum}"
      r["problems"].each { |p| puts "    PROBLEM #{p}" }'
    [ "$rc" -eq 0 ] || upgrade_failed "$out" "data lost or broken by the upgrade"
    upgrade_compose down -v --remove-orphans >/dev/null 2>&1
    echo "UPGRADE OK ($from -> $to). Reports: $out"
    ;;
  upgrade-clean)
    require_docker
    upgrade_compose down -v --remove-orphans
    ;;
  ''|-h|--help|help) usage 0 ;;
  *) usage ;;
esac
