<div style="display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%;">


  <div class="donation-container" style="display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 20px;">
    <label for="donation_amount">Faire un don :</label>
    <%= number_field_tag :donation_amount, nil, min: 1, step: 1, placeholder: "Montant", style: "width: 100px;" %>
    <%= button_to 'Donner', admin_payment_path, class: "purple-button", method: :post %>
  </div>

  <p>Produit déjà ajouté : <%= @product_order.product.product_name %> - Prix : 
  <%= @product_order.product.price_entries.order(created_at: :desc).first.price_catalog.price %> €</p>
  
  <div style="display: flex; justify-content: center; width: 100%; margin-bottom: 20px;">
    <%= button_to 'Payer', admin_payments_path,params:{payment:{ product_order_id: @product_order , user_id: @user}}, method: :post ,class: "purple-button" %>
  </div>
</div>
