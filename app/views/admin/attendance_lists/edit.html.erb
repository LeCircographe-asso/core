<% content_for :title, "Modifier la liste de présence" %>

<div class="min-h-screen py-6">
  <div class="page-container max-w-3xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Modifier la liste de présence</h1>
      <p class="mt-2 text-sm text-gray-500">Modifiez les informations de la liste de présence</p>
    </div>

    <!-- Form -->
    <div class="surface-card">
      <div class="px-6 py-5 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Informations de la liste</h2>
      </div>
      <div class="px-6 py-5">
        <%= form_with model: @attendance_list, url: admin_attendance_list_path(@attendance_list), method: :patch, class: "space-y-6" do |form| %>
          <div>
            <%= form.label :name, "Nom de la liste", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-tag text-gray-400"></i>
              </div>
              <%= form.text_field :name, 
                  class: "pl-10 block w-full py-2 pr-10 mt-1 focus:ring-[#1F5C55] focus:border-[#1F5C55] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
              %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Nom permettant d'identifier facilement cette liste</p>
          </div>
          
          <div>
            <%= form.label :list_type, "Type de liste", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-list-ul text-gray-400"></i>
              </div>
              <%= form.select :list_type, 
                  AttendanceList.list_types.keys.map { |type| [type.humanize, type] },
                  {},
                  { class: "pl-10 block w-full py-2 pr-10 mt-1 focus:ring-[#1F5C55] focus:border-[#1F5C55] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" }
              %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Le type détermine la catégorie de la liste (formation, événement, réunion)</p>
          </div>

          <div>
            <%= form.label :status, "Statut", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-lock text-gray-400"></i>
              </div>
              <%= form.select :status, 
                  AttendanceList.statuses.keys.map { |status| [status.humanize, status] },
                  {},
                  { class: "pl-10 block w-full py-2 pr-10 mt-1 focus:ring-[#1F5C55] focus:border-[#1F5C55] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" }
              %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Déterminez si la liste est ouverte, fermée ou archivée</p>
          </div>

          <div class="flex items-center justify-end space-x-3 pt-5 border-t border-gray-200">
            <%= link_to "Annuler", admin_attendance_lists_path, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Mettre à jour", class: "px-4 py-2 bg-[#1F5C55] hover:bg-[#194A45] text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Delete button section -->
    <div class="surface-card mt-6">
      <div class="px-6 py-5 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Zone de danger</h2>
      </div>
      <div class="px-6 py-5">
        <div class="flex flex-col">
          <p class="mb-4 text-sm text-gray-500">Cette action est irréversible. Toutes les données associées à cette liste seront définitivement supprimées.</p>
          <%= button_to 'Supprimer la liste', 
              admin_attendance_list_path(@attendance_list), 
              method: :delete, 
              form: { data: { turbo_confirm: 'Êtes-vous sûr de vouloir supprimer cette liste ? Cette action est irréversible.' } }, 
              class: 'self-start px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500' 
          %>
        </div>
      </div>
    </div>
  </div>
</div>
