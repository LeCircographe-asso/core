<% content_for :title, "Créer une nouvelle liste de présence" %>

<div class="min-h-screen py-6">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <!-- En-tête -->
    <div class="mb-6">
      <div class="flex items-center">
        <%= link_to admin_attendance_lists_path, class: "mr-4 text-gray-500 hover:text-[#1F5C55]" do %>
          <i class="fas fa-arrow-left"></i>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">Nouvelle liste de présence</h1>
      </div>
      <p class="mt-2 text-sm text-gray-500">Créez une nouvelle liste pour gérer les présences à un événement, une formation ou une réunion</p>
    </div>

    <!-- Formulaire -->
    <div class="bg-white shadow overflow-hidden rounded-lg">
      <div class="px-6 py-5 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Informations de la liste</h2>
      </div>
      <div class="px-6 py-5">
        <%= form_with model: AttendanceList.new, url: admin_attendance_lists_path, method: :post, class: "space-y-6" do |form| %>
          <div>
            <%= form.label :list_type, "Type de liste", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-list-ul text-gray-400"></i>
              </div>
              <%= form.select :list_type, 
                  AttendanceList.list_types.keys.map { |type| [type.humanize, type] },
                  { include_blank: "Sélectionnez un type" },
                  { class: "pl-10 block w-full py-2 pr-10 mt-1 focus:ring-[#1F5C55] focus:border-[#1F5C55] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" }
              %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Le type détermine la catégorie de la liste (formation, événement, réunion)</p>
          </div>

          <div>
            <%= form.label :start_date, "Date et heure de début", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-calendar-alt text-gray-400"></i>
              </div>
              <%= form.datetime_local_field :start_date, 
                  class: "pl-10 block w-full py-2 pr-10 mt-1 focus:ring-[#1F5C55] focus:border-[#1F5C55] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
              %>
            </div>
            <p class="mt-1 text-xs text-gray-500">La date de fin sera automatiquement fixée à la fin de la journée sélectionnée</p>
          </div>

          <div class="flex items-center justify-end">
            <%= link_to "Annuler", admin_attendance_lists_path, class: "mr-4 text-sm font-medium text-gray-700 hover:text-gray-500" %>
            <%= form.submit "Créer la liste", class: "px-4 py-2 bg-[#1F5C55] hover:bg-[#194A45] text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>