<% content_for :title, "Registre de présence" %>

<div class="min-h-screen py-6">
  <div class="page-container-wide">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="mb-6">
      <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-gray-900">Registre de présence</h1>
        <%= link_to new_admin_attendance_list_path, class: "px-4 py-2 bg-[#1F5C55] hover:bg-[#194A45] text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55] flex items-center" do %>
          <i class="fas fa-plus mr-0 md:mr-2"></i> <span class="hidden md:inline">Créer un registre</span>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-gray-500">Gérez les registres de présence du jour pour les formations, événements et réunions</p>
    </div>

    <!-- Type filter tiles -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      <!-- All -->
      <%= link_to admin_attendance_lists_path(search: params[:search], month: params[:month], status: params[:status], sort: params[:sort]),
          class: "p-4 rounded-md text-center transition-colors #{params[:list_type].blank? ? 'bg-[#1F5C55] text-white' : 'surface-card text-gray-900 hover:bg-gray-50'}" do %>
        <div class="flex flex-col items-center gap-2">
          <i class="fas fa-list text-lg"></i>
          <span class="text-sm font-medium">Tous</span>
        </div>
      <% end %>

      <!-- Training -->
      <%= link_to admin_attendance_lists_path(list_type: :training, search: params[:search], month: params[:month], status: params[:status], sort: params[:sort]),
          class: "p-4 rounded-md text-center transition-colors #{params[:list_type] == 'training' ? 'bg-[#1F5C55] text-white' : 'surface-card text-gray-900 hover:bg-gray-50'}" do %>
        <div class="flex flex-col items-center gap-2">
          <i class="fas fa-graduation-cap text-lg"></i>
          <span class="text-sm font-medium">Entraînement</span>
        </div>
      <% end %>

      <!-- Event -->
      <%= link_to admin_attendance_lists_path(list_type: :event, search: params[:search], month: params[:month], status: params[:status], sort: params[:sort]),
          class: "p-4 rounded-md text-center transition-colors #{params[:list_type] == 'event' ? 'bg-[#1F5C55] text-white' : 'surface-card text-gray-900 hover:bg-gray-50'}" do %>
        <div class="flex flex-col items-center gap-2">
          <i class="fas fa-calendar-check text-lg"></i>
          <span class="text-sm font-medium">Événement</span>
        </div>
      <% end %>

      <!-- Meeting -->
      <%= link_to admin_attendance_lists_path(list_type: :meeting, search: params[:search], month: params[:month], status: params[:status], sort: params[:sort]),
          class: "p-4 rounded-md text-center transition-colors #{params[:list_type] == 'meeting' ? 'bg-[#1F5C55] text-white' : 'surface-card text-gray-900 hover:bg-gray-50'}" do %>
        <div class="flex flex-col items-center gap-2">
          <i class="fas fa-users text-lg"></i>
          <span class="text-sm font-medium">Réunion</span>
        </div>
      <% end %>
    </div>

    <!-- Filter panel -->
    <div class="admin-filter-panel mb-6">
      <%= form_with url: admin_attendance_lists_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
        <!-- Search -->
        <div class="flex-1">
          <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Recherche</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <%= form.text_field :search,
                id: "search",
                value: params[:search],
                placeholder: "Nom du registre...",
                class: "search-input pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <% if params[:search].present? %>
              <button type="button"
                      class="absolute inset-y-0 right-0 pr-3 flex items-center"
                      onclick="document.getElementById('search').value = ''; this.closest('form').submit();">
                <svg class="h-4 w-4 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Month filter -->
        <div class="md:w-48">
          <label for="month" class="block text-sm font-medium text-gray-700 mb-1">Mois</label>
          <%= form.month_field :month,
              value: params[:month],
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
        </div>

        <!-- Sort -->
        <div class="md:w-48">
          <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">Tri</label>
          <%= form.select :sort,
              options_for_select([
                ['Plus récent d\'abord', 'desc'],
                ['Plus ancien d\'abord', 'asc']
              ], params[:sort] || 'desc'),
              {},
              {
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
                onchange: "this.form.submit()"
              } %>
        </div>

        <!-- Status filter -->
        <div class="md:w-48">
          <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
          <%= form.select :status,
              options_for_select([
                ['Tous', ''],
                ['Ouvert', 'open'],
                ['Fermé', 'close'],
                ['Archivé', 'archived']
              ], params[:status]),
              {},
              {
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
                onchange: "this.form.submit()"
              } %>
        </div>

        <!-- Keep hidden the list_type param set by tiles -->
        <%= hidden_field_tag :list_type, params[:list_type] %>

        <!-- Search button -->
        <div class="flex items-end">
          <%= form.submit "Filtrer", class: "admin-btn-primary" %>
        </div>
      <% end %>
    </div>

    <!-- Desktop Table View (hidden on mobile) -->
    <div class="hidden md:block">
      <div class="surface-card">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date de début</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date de fin</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if @attendance_list.present? %>
                <% @attendance_list.each do |attendance_list| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      <%= link_to attendance_list.name, admin_attendance_list_path(attendance_list), class: "text-[#1F5C55] hover:text-[#194A45]" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center">
                        <% 
                          icon_class = case attendance_list.list_type 
                          when "training" then "fas fa-graduation-cap text-blue-500"
                          when "event" then "fas fa-calendar-check text-purple-500"
                          when "meeting" then "fas fa-users text-green-500"
                          else "fas fa-list text-gray-500"
                          end
                        %>
                        <i class="<%= icon_class %> mr-2"></i>
                        <span class="text-sm font-medium text-gray-900"><%= attendance_list.list_type.humanize %></span>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= attendance_list.start_date.strftime("%d/%m/%Y %H:%M") %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= attendance_list.end_date.strftime("%d/%m/%Y %H:%M") %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% 
                        status_class = case attendance_list.status 
                        when "open" then "bg-green-100 text-green-800"
                        when "close" then "bg-amber-100 text-amber-800"
                        when "archived" then "bg-gray-100 text-gray-800"
                        else "bg-gray-100 text-gray-800"
                        end
                        
                        status_icon = case attendance_list.status
                        when "open" then "fas fa-lock-open"
                        when "close" then "fas fa-lock"
                        when "archived" then "fas fa-archive"
                        else "fas fa-question"
                        end
                      %>
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                        <i class="<%= status_icon %> mr-1"></i>
                        <%= attendance_list.status.humanize %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                      <div class="flex space-x-2">
                        <%= link_to admin_attendance_list_path(attendance_list.id), class: "px-3 py-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center", title: "Voir les détails" do %>
                          <i class="fas fa-eye mr-1"></i> <span>Voir</span>
                        <% end %>
                        
                        <%= link_to edit_admin_attendance_list_path(attendance_list.id), class: "px-3 py-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center", title: "Modifier la liste" do %>
                          <i class="fas fa-edit mr-1"></i> <span>Modifier</span>
                        <% end %>
                        
                        <%= link_to new_admin_attendance_list_attendance_path(attendance_list.id), class: "px-3 py-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center", title: "Ajouter un participant" do %>
                          <i class="fas fa-user-plus mr-1"></i> <span>Ajouter</span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                    <div class="flex flex-col items-center py-6">
                      <i class="fas fa-list text-gray-400 text-3xl mb-3"></i>
                      <p>Aucune liste de présence disponible</p>
                      <p class="mt-1 text-xs">Créez une nouvelle liste pour commencer</p>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Mobile Card View (shown only on mobile) -->
    <div class="md:hidden space-y-4">
      <% if @attendance_list.present? %>
        <% @attendance_list.each do |attendance_list| %>
          <div class="surface-card">
            <div class="p-4 border-b border-gray-200">
              <div class="flex justify-between items-center">
                <h3 class="font-semibold text-lg text-gray-900">
                  <%= link_to attendance_list.name, admin_attendance_list_path(attendance_list), class: "text-[#1F5C55] hover:text-[#194A45]" %>
                </h3>
                
                <% 
                  status_class = case attendance_list.status 
                  when "open" then "bg-green-100 text-green-800"
                  when "close" then "bg-amber-100 text-amber-800"
                  when "archived" then "bg-gray-100 text-gray-800"
                  else "bg-gray-100 text-gray-800"
                  end
                  
                  status_icon = case attendance_list.status
                  when "open" then "fas fa-lock-open"
                  when "close" then "fas fa-lock"
                  when "archived" then "fas fa-archive"
                  else "fas fa-question"
                  end
                %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                  <i class="<%= status_icon %> mr-1"></i>
                  <%= attendance_list.status.humanize %>
                </span>
              </div>
            </div>
            
            <div class="px-4 py-3 border-b border-gray-200">
              <div class="flex items-center mb-2">
                <% 
                  icon_class = case attendance_list.list_type 
                  when "training" then "fas fa-graduation-cap text-blue-500"
                  when "event" then "fas fa-calendar-check text-purple-500"
                  when "meeting" then "fas fa-users text-green-500"
                  else "fas fa-list text-gray-500"
                  end
                %>
                <i class="<%= icon_class %> mr-2 w-5"></i>
                <span class="text-sm font-medium text-gray-900"><%= attendance_list.list_type.humanize %></span>
              </div>
              
              <div class="grid grid-cols-2 gap-2 text-xs text-gray-600">
                <div>
                  <div class="font-medium">Début:</div>
                  <div><%= attendance_list.start_date.strftime("%d/%m/%Y %H:%M") %></div>
                </div>
                <div>
                  <div class="font-medium">Fin:</div>
                  <div><%= attendance_list.end_date.strftime("%d/%m/%Y %H:%M") %></div>
                </div>
              </div>
            </div>
            
            <div class="px-4 py-3 flex justify-between space-x-2">
              <%= link_to admin_attendance_list_path(attendance_list.id), class: "px-3 py-2 flex-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center justify-center", title: "Voir les détails" do %>
                <i class="fas fa-eye"></i>
              <% end %>
              
              <%= link_to edit_admin_attendance_list_path(attendance_list.id), class: "px-3 py-2 flex-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center justify-center", title: "Modifier la liste" do %>
                <i class="fas fa-edit"></i>
              <% end %>
              
              <%= link_to new_admin_attendance_list_attendance_path(attendance_list.id), class: "px-3 py-2 flex-1 bg-[#1F5C55] hover:bg-[#194A45] text-white text-xs font-medium rounded flex items-center justify-center", title: "Ajouter un participant" do %>
                <i class="fas fa-user-plus"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="surface-card p-6 text-center">
          <i class="fas fa-list text-gray-400 text-3xl mb-3"></i>
          <p class="text-gray-500">Aucune liste de présence disponible</p>
          <p class="mt-1 text-xs text-gray-500">Créez une nouvelle liste pour commencer</p>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @attendance_list.present? %>
      <div class="mt-6">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  </div>
</div>
