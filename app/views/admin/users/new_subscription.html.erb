<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <div class="bg-white shadow-lg rounded-lg p-6">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Créer une Cotisation</h1>
        <p class="mt-2 text-sm text-gray-600">
          Ajouter un carnet d'entrées pour <%= @person.full_name %>
        </p>
      </div>
      
      <!-- Formulaire de création de cotisation -->
      <div class="bg-white shadow-lg rounded-lg p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Sélectionner un plan de cotisation</h2>
        
        <%= form_with url: create_subscription_admin_user_path(@person), method: :post, local: true, class: "space-y-4" do |form| %>
          <div>
            <%= form.label :subscription_plan_id, "Plan de cotisation", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :subscription_plan_id, 
                options_from_collection_for_select(@subscription_plans, :id, :name_with_price), 
                { prompt: "Sélectionner un plan de cotisation" },
                { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm", required: true } %>
            <% if @subscription_plans.empty? %>
              <p class="text-red-500 text-sm mt-1">⚠️ Aucun plan de cotisation disponible</p>
            <% end %>
          </div>
          
          <div>
            <%= form.label :payment_method, "Méthode de paiement", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :payment_method, 
                options_for_select(payment_method_options(include_pending: true)),
                { selected: 'cash' },
                { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" } %>
          </div>
          
          <div class="flex justify-end">
            <%= form.submit "Créer la cotisation", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
      
      <!-- Retour -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <%= link_to "← Retour à la fiche", admin_user_path("person_#{@person.id}"), 
            class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
      </div>
    </div>
  </div>
</div>
