<% content_for :title, "Gestion des Adhérents - ViewComponents" %>

<div class="min-h-screen py-6" data-controller="admin-users">
  <div class="max-w-7xl mx-auto">
    <%= render 'shared/breadcrumbs' %>

    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Gestion des Adhérents - ViewComponents</h1>
        <p class="text-white/80 mt-1">
          Version avec ViewComponents (au lieu de partials)
        </p>
      </div>

      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Statistiques</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            <div class="stat-card bg-blue-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-blue-500">Total personnes</p>
              <p class="text-2xl font-bold text-blue-800"><%= @total_people %></p>
            </div>

            <div class="stat-card bg-teal-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-teal-500">Nouveaux (hier)</p>
              <p class="text-2xl font-bold text-teal-800"><%= @new_users_yesterday %></p>
            </div>

            <div class="stat-card bg-green-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type="basic"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-green-500">Adhésions Basic</p>
              <p class="text-2xl font-bold text-green-800"><%= @basic_memberships %></p>
            </div>

            <div class="stat-card bg-indigo-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type="circus"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-indigo-500">Adhésions Cirque</p>
              <p class="text-2xl font-bold text-indigo-800"><%= @circus_memberships %></p>
            </div>

            <div class="stat-card bg-purple-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type="active"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-purple-500">Adhésions Actives</p>
              <p class="text-2xl font-bold text-purple-800"><%= @active_memberships %></p>
            </div>

            <div class="stat-card bg-orange-50 rounded-lg p-4 cursor-pointer"
                 data-admin-users-target="statCard"
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-orange-500">Utilisateurs (ce mois)</p>
              <p class="text-2xl font-bold text-orange-800"><%= @users_this_month %></p>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-semibold text-gray-900">Liste des Adhérents (ViewComponents)</h2>
          <%= link_to "Ajouter un adhérent", new_admin_user_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
        </div>

        <!-- Filtres et recherche -->
        <div class="mb-6 flex flex-wrap items-center gap-4">
          <%= form_with url: admin_users_path, method: :get, class: "flex-grow flex flex-wrap items-center gap-4" do |form| %>
            <div class="flex-grow">
              <%= form.label :search, "Rechercher", class: "sr-only" %>
              <%= form.text_field :search,
                                  value: params[:search],
                                  placeholder: "Rechercher par nom, email, téléphone...",
                                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
            <div>
              <%= form.label :filter, "Filtrer par", class: "sr-only" %>
              <%= form.select :filter,
                              options_for_select([
                                ['Tous', ''],
                                ['Adhésion active', 'with_active_membership'],
                                ['Adhésion expirant bientôt', 'with_expiring_membership'],
                                ['Adhésion expirée', 'with_expired_membership'],
                                ['Sans adhésion', 'without_membership'],
                                ['Avec compte web', 'with_user_account'],
                                ['Sans compte web', 'without_user_account']
                              ], params[:filter]),
                              {},
                              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
            <%= form.submit "Appliquer", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= link_to "Réinitialiser", admin_users_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
          <% end %>
        </div>

        <!-- Tableau des adhérents -->
        <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Nom</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Contact</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Statut Adhésion</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type Adhésion</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Cotisations</th>
                <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900">Compte Web</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% if @people.any? %>
                <% @people.each do |person| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= display_name(person) %>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <div class="space-y-1">
                        <div><%= display_email(person) %></div>
                        <div><%= display_phone(person) %></div>
                      </div>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <%= render MembershipStatusBadgeComponent.new(person: person) %>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <%= render MembershipTypeBadgeComponent.new(person: person) %>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <%= render SubscriptionStatusBadgeComponent.new(person: person) %>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                      <%= render WebAccountIconComponent.new(person: person) %>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                      <%= render ContextualActionsComponent.new(person: person) %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="7" class="px-6 py-10 text-center text-gray-500">
                    <div class="empty-state flex flex-col items-center">
                      <svg class="h-12 w-12 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                      </svg>
                      <p class="text-lg font-medium">Aucun adhérent trouvé</p>
                      <p class="text-sm text-gray-500">Ajustez vos filtres ou ajoutez un nouvel adhérent.</p>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="mt-4 flex justify-center">
          <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
        </div>

        <!-- Navigation -->
        <div class="mt-6 flex justify-between">
          <%= link_to "Version Partials", admin_users_index_refactored_path, 
                      class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
          <%= link_to "Retour à la liste originale", admin_users_path, 
                      class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45]" %>
        </div>
      </div>
    </div>
  </div>
</div>
