<div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
  <h4 class="text-md font-medium text-blue-900 mb-3">
    <i class="fas fa-shopping-cart mr-2"></i>
    Acheter une cotisation pour enregistrer la présence
  </h4>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <% available_plans.each do |plan| %>
      <div class="bg-white rounded-lg p-3 border border-gray-200">
        <h5 class="font-medium text-gray-900 text-sm"><%= plan.name %></h5>
        <p class="text-xs text-gray-500 mb-2"><%= plan.duration_humanized %></p>
        <div class="text-lg font-bold text-[#1F5C55] mb-2"><%= plan.price_euros %>€</div>
        
        <%= form_with url: admin_subscription_plans_path, 
                      method: :post, 
                      data: { turbo_stream: true },
                      class: "space-y-2" do |form| %>
          <%= form.hidden_field :subscription_plan_id, value: plan.id %>
          <%= form.hidden_field :person_id, value: person.id %>
          <%= form.hidden_field :record_attendance, value: true %>
          <%= form.hidden_field :attendance_date, value: date %>
          
          <%= form.select :payment_method, 
              options_for_select([
                ['Espèces', 'cash'],
                ['Chèque', 'check'],
                ['Virement', 'transfer'],
                ['Carte', 'card']
              ]),
              { selected: 'cash' },
              { class: "w-full text-xs border-gray-300 rounded-md" } %>
              
          <%= form.submit "Acheter & Enregistrer", 
              class: "w-full bg-[#1F5C55] text-white py-2 px-3 rounded-md text-xs hover:bg-[#194A45]" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
