<div class="min-h-screen bg-gray-100 py-6 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- En-tête -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-purple-600 to-indigo-600 px-6 py-4">
        <h1 class="text-2xl font-bold text-white flex items-center gap-2">
          Profil #<%= @user.id %>
          <span class="text-sm bg-white/20 px-2 py-1 rounded-full"><%= @user.system_role.humanize %></span>
        </h1>
        <p class="text-white/80 mt-1"><%= @user.first_name %> <%= @user.last_name %></p>
      </div>

      <!-- Informations principales -->
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Colonne gauche -->
          <div class="space-y-4">
            <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Informations personnelles</h2>
            
            <div class="space-y-3">
              <div class="flex items-center">
                <span class="text-gray-500 w-32">Email:</span>
                <span class="text-gray-900"><%= @user.email_address %></span>
              </div>
              
              <div class="flex items-center">
                <span class="text-gray-500 w-32">Date de naissance:</span>
                <span class="text-gray-900"><%= @user.birthdate&.strftime("%d/%m/%Y") || "Non renseigné" %></span>
              </div>

              <div class="flex items-center">
                <span class="text-gray-500 w-32">Téléphone:</span>
                <span class="text-gray-900"><%= @user.phone_number || "Non renseigné" %></span>
              </div>

              <div class="flex items-start">
                <span class="text-gray-500 w-32">Adresse:</span>
                <div class="text-gray-900">
                  <%= @user.address || "Non renseignée" %><br>
                  <%= @user.zip_code %> <%= @user.town %><br>
                  <%= @user.country %>
                </div>
              </div>
            </div>
          </div>

          <!-- Colonne droite -->
          <div class="space-y-4">
            <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Adhésion & Activités</h2>
            
            <div class="space-y-3">
              <div class="flex items-center">
                <span class="text-gray-500 w-32">Statut:</span>
                <% if @user.user_memberships.exists?(status: "active") %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Membre actif
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    Non adhérent
                  </span>
                <% end %>
              </div>

              <div class="flex items-center">
                <span class="text-gray-500 w-32">Type d'adhésion:</span>
                <span class="text-gray-900">
                  <% active_membership = @user.user_memberships.find_by(status: "active") %>
                  <%= active_membership&.membership&.type_name&.humanize || "Aucune" %>
                </span>
              </div>

              <% if active_membership&.end_date.present? %>
                <div class="flex items-center">
                  <span class="text-gray-500 w-32">Expire le:</span>
                  <span class="text-gray-900"><%= active_membership.end_date.strftime("%d/%m/%Y") %></span>
                </div>
              <% end %>

              <div class="flex items-center">
                <span class="text-gray-500 w-32">Abonnement:</span>
                <span class="text-gray-900">
                </span>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-gray-500 w-32">Spécialités:</span>
              <div class="text-gray-900">
                <p><%= @user.occupation %></p>
                <p class="text-sm text-gray-500 mt-1"><%= @user.specialty %></p>
              </div>
            </div>

            <div class="flex items-center">
              <span class="text-gray-500 w-32">Droit à l'image:</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.image_rights ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= @user.image_rights ? "Accordé" : "Non accordé" %>
              </span>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 border-t pt-6 flex flex-wrap gap-4">
          <%= button_to "Cotisation", admin_user_orders_path(user_id: @user.id, order_id: @order), 
              method: :post, 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
          
          <%= link_to "Modifier", edit_admin_user_path, 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
          
          <%= link_to "Historique des paiements", admin_payments_path(user_id: @user.id),
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
          
          <%= link_to "Retour à la liste", admin_users_path,
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
          
          <%= button_to "Supprimer", [:admin, @user], 
              method: :delete,
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500",
              data: { confirm: "Êtes-vous sûr de vouloir supprimer cet utilisateur ?" } %>
        </div>
      </div>
    </div>
  </div>

  <div>
  <% if true  %>
          <%= button_to "Souscrire à un abonnement", admin_user_orders_path(@user), method: :post, params: {order: { user_id: @user.id}}, class: "purple-button", form: { data: { turbo: false } } %>
        <% elsif @user.user_memberships.where(status: "pending").exists? %>
          <%= button_to "Souscrire à une adhésion", admin_user_orders_path(@user), method: :post, params: {order: { user_id: @user.id}}, class: "purple-button", form: { data: { turbo: false } } %>
        <% else %>
          <!-- Si l'adhésion et l'abonnement sont actifs, ne rien afficher ou autre logique -->
        <% end %>
    <%= link_to "Voir historique de payment", admin_payments_path(user_id: @user.id)%>
    <%= link_to "Edit this user", edit_admin_user_path(@user) %> |
    <%= link_to "Back to users", admin_users_path %>


    <%= button_to "Destroy this user", [:admin, @user], method: :delete %>
    
  </div>
</div>