<h1>Profil <%= @user.id %></h1>
<div class="profile-container">
  <h1 class="profile-name"><%= @user.first_name %> <%= @user.last_name %></h1>
  <h2 class="profile-section-title">Informations</h2>
  <div class="profile-info">
    <div class="info-group">
      <p><strong>Email:</strong> <%= @user.email_address %></p>
      <p><strong>Date de naissance:</strong> <%= @user.birthdate %></p>
      <p><strong>Adresse:</strong> <%= @user.address %></p>
      <p><strong>Code Postal:</strong> <%= @user.zip_code %></p>
      <p><strong>Ville:</strong> <%= @user.town %></p>
      <p><strong>Pays:</strong> <%= @user.country %></p>
      <p><strong>N° de téléphone:</strong> <%= @user.phone_number %></p>
      <p><strong>Profession ou spécialité:</strong> <%= @user.occupation %></p>
      <p><strong>Disciplines pratiquées:</strong> <%= @user.specialty %></p>
      <p><strong>Droit à l'image:</strong> <%= @user.image_rights %></p>
      <p><strong>Adherent :</strong>
        <% @user.user_memberships.each do |user_membership| %>
            <% if user_membership.status == "active" %>
              <%= user_membership.membership.type_name %>
            <% else %>
            <% end %>
        <% end %>
      </p>
      <p><strong>Abonnement en cours :</strong>
          <% if @user.payments.last && @user.payments.last.product_order && @user.payments.last.product_order.product %>
            <%= @user.payments.last.product_order.product.product_name %>
          <% else %>
            Aucun abonnement actif
          <% end %>
        </p>

      <% @user.user_memberships.where(status: "active").each do |user_membership| %>

        <p><strong>Expire le :</strong>
        <%= user_membership.end_date.strftime("%d/%m/%Y")%>
        <% end %></p>


        <% if @user.user_memberships.where(status: "active").exists? %>
          <%= button_to "Souscrire à un abonnement", admin_user_orders_path(@user), method: :post, params: {order: { user_id: @user.id}}, class: "purple-button", form: { data: { turbo: false } } %>
        <% elsif @user.user_memberships.where(status: "pending").exists? %>
          <%= button_to "Souscrire à une adhésion", admin_user_orders_path(@user), method: :post, params: {order: { user_id: @user.id}}, class: "purple-button", form: { data: { turbo: false } } %>
        <% else %>
          <!-- Si l'adhésion et l'abonnement sont actifs, ne rien afficher ou autre logique -->
        <% end %>

      <%= link_to "editer", edit_admin_user_path, class: "purple-button" %>

    </div>
  </div>
  <div>
    <%= link_to "Voir historique de payment", admin_payments_path(user_id: @user.id)%>
    <%= link_to "Edit this user", edit_admin_user_path(@user) %> |
    <%= link_to "Back to users", admin_users_path %>
    <%= button_to "Destroy this user", [:admin, @user], method: :delete %>
  </div>
</div>