<div id="<%= dom_id user %>" class="bg-white shadow-lg rounded-lg overflow-hidden">
  <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
    <div class="flex justify-between items-center">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <%= user.full_name %>
          <span class="text-sm bg-white/20 px-2 py-1 rounded-full"><%= user.system_role.humanize %></span>
        </h2>
        <p class="text-white/80 mt-1"><%= user.email_address %></p>
      </div>
    </div>
  </div>

  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Personal Information -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Informations personnelles</h3>
        <div class="space-y-2">
          <p><strong>Email:</strong> <%= user.email_address %></p>
          <p><strong>Prénom:</strong> <%= user.first_name %></p>
          <p><strong>Nom:</strong> <%= user.last_name %></p>
          <p><strong>Date de naissance:</strong> <%= user.birthdate&.strftime("%d/%m/%Y") || "Non renseigné" %></p>
          <p><strong>Téléphone:</strong> <%= user.phone_number || "Non renseigné" %></p>
        </div>
      </div>

      <!-- Membership Information -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Informations d'adhésion</h3>
        <div class="space-y-2">
          <% begin %>
            <% if user.user_memberships.any? %>
              <p><strong>Inscription:</strong> Oui</p>
              <p><strong>Date d'inscription:</strong> <%= registration_date(user) %></p>
              <% current_membership = latest_membership(user) %>
              <p><strong>Type d'abonnement:</strong> <%= membership_type_name(current_membership) %></p>
              <p><strong>Statut de l'abonnement:</strong> <%= membership_status(current_membership) %></p>
            <% else %>
              <p><strong>Inscription:</strong> Non</p>
              <p><strong>Date d'inscription:</strong> N/A</p>
              <p><strong>Type d'abonnement:</strong> Aucun</p>
              <p><strong>Statut de l'abonnement:</strong> Inactif</p>
            <% end %>
          <% rescue => e %>
            <p><strong>Inscription:</strong> Non</p>
            <p><strong>Date d'inscription:</strong> N/A</p>
            <p><strong>Type d'abonnement:</strong> Aucun</p>
            <p><strong>Statut de l'abonnement:</strong> Inactif</p>
          <% end %>
        </div>
      </div>

      <!-- Additional Information -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Informations additionnelles</h3>
        <div class="space-y-2">
          <p><strong>Adresse:</strong> <%= user.address || "Non renseigné" %></p>
          <p><strong>Code postal:</strong> <%= user.zip_code || "Non renseigné" %></p>
          <p><strong>Ville:</strong> <%= user.town || "Non renseigné" %></p>
          <p><strong>Pays:</strong> <%= user.country || "Non renseigné" %></p>
          <p><strong>Profession:</strong> <%= user.occupation || "Non renseigné" %></p>
          <p><strong>Spécialité:</strong> <%= user.specialty || "Non renseigné" %></p>
        </div>
      </div>

      <!-- Preferences -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Préférences</h3>
        <div class="space-y-2">
          <p><strong>Newsletter:</strong> <%= user.newsletter_subscribed? ? "Oui" : "Non" %></p>
          <p><strong>Droits à l'image:</strong> <%= user.image_rights? ? "Oui" : "Non" %></p>
          <p><strong>Souhaite s'impliquer:</strong> <%= user.get_involved? ? "Oui" : "Non" %></p>
          <p><strong>Police dyslexique:</strong> <%= user.dyslexic_font? ? "Oui" : "Non" %></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex justify-end space-x-3">
      <%= link_to "Voir", admin_user_path(user), class: "px-4 py-2 bg-[#1F5C55] text-white rounded-md hover:bg-[#194A45] transition-colors" %>
    </div>
  </div>
</div>