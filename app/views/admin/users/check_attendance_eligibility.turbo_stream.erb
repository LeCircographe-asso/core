<%= turbo_stream.update "attendance-frame-#{@person.id}" do %>
  <% if @result.needs_confirmation? %>
    <%= render "admin/users/attendance_book_confirmation", 
               person: @person, 
               book_of_entry: @result.book_of_entry, 
               date: @date %>
               
  <% elsif @result.can_record_directly? %>
    <%= render "admin/users/attendance_direct_confirmation", 
               person: @person, 
               membership_type: @result.membership_type, 
               date: @date %>
               
  <% elsif @result.needs_subscription? %>
    <%= render "admin/users/attendance_subscription_options", 
               person: @person, 
               available_plans: @result.available_plans, 
               date: @date %>
               
  <% elsif @result.already_present? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex items-center">
        <i class="fas fa-check-circle text-blue-600 mr-3"></i>
        <p class="text-sm text-blue-800"><%= @result.message %></p>
      </div>
    </div>
    
  <% elsif @result.no_membership? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex items-center">
        <i class="fas fa-exclamation-triangle text-yellow-600 mr-3"></i>
        <p class="text-sm text-yellow-800"><%= @result.message %></p>
      </div>
    </div>
    
  <% else %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center">
        <i class="fas fa-times-circle text-red-600 mr-3"></i>
        <p class="text-sm text-red-800"><%= @result.message %></p>
      </div>
    </div>
  <% end %>
<% end %>
