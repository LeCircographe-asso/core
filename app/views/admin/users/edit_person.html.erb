<div class="min-h-screen bg-gray-50 py-6">
  <div class="page-container max-w-2xl">
    <!-- Header -->
    <div class="admin-page-header">
      <div class="px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Modifier les informations</h1>
        <p class="text-green-100 mt-1"><%= @person.full_name %></p>
      </div>
    </div>

    <!-- Formulaire -->
    <div class="surface-card">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Informations personnelles</h2>
      </div>

      <div class="p-6">
        <%= form_with model: @person, url: admin_user_path(Admin::Users::PersonRouteKey.call(@person)), method: :patch, local: true, class: "space-y-6" do |form| %>
          <% if @person.errors.any? %>
            <div class="bg-red-50 border border-red-200 rounded-md p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">Erreurs à corriger :</h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc list-inside space-y-1">
                      <% @person.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :first_name, "Prénom", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :first_name, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :last_name, "Nom", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :last_name, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
            <%= form.email_field :email, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Optionnel - requis seulement pour la newsletter</p>
          </div>

          <div>
            <%= form.label :phone, "Téléphone", class: "block text-sm font-medium text-gray-700" %>
            <%= form.telephone_field :phone, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div>
            <%= form.label :address, "Adresse", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_area :address, rows: 2,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <%= form.label :zip_code, "Code postal", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :zip_code, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :town, "Ville", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :town, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :country, "Pays", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :country, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :birth_date, "Date de naissance", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :birth_date, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :emergency_contact_name, "Contact d'urgence", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :emergency_contact_name, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :emergency_contact_phone, "Téléphone d'urgence", class: "block text-sm font-medium text-gray-700" %>
              <%= form.telephone_field :emergency_contact_phone, 
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :notes, "Notes", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_area :notes, rows: 3,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="space-y-4">
            <h3 class="text-sm font-medium text-gray-700">Préférences</h3>
            
            <div class="flex items-center">
              <%= form.check_box :newsletter_subscribed, { class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded", checked: @person.newsletter_subscribed? }, "1", "0" %>
              <%= form.label :newsletter_subscribed, "S'abonner à la newsletter", class: "ml-2 block text-sm text-gray-700" %>
            </div>

            <div class="flex items-center">
              <%= form.check_box :get_involved, class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded" %>
              <%= form.label :get_involved, "Souhaite s'impliquer", class: "ml-2 block text-sm text-gray-700" %>
            </div>

            <div class="flex items-center">
              <%= form.check_box :image_rights, class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded" %>
              <%= form.label :image_rights, "Droits à l'image", class: "ml-2 block text-sm text-gray-700" %>
            </div>

            <div class="flex items-center">
              <%= form.check_box :is_minor, class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded" %>
              <%= form.label :is_minor, "Mineur", class: "ml-2 block text-sm text-gray-700" %>
            </div>
          </div>

          <!-- Reduced Rate Section -->
          <div class="pt-4 border-t border-gray-200" data-controller="reduced-rate">
            <div class="flex items-center">
              <%= form.check_box :reduced_rate_eligible, class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded", data: { reduced_rate_target: "checkbox", action: "change->reduced-rate#checkboxChanged" } %>
              <%= form.label :reduced_rate_eligible, "Tarif réduit éligible", class: "ml-2 block text-sm text-gray-700" %>
            </div>
            
            <div class="mt-3" data-reduced-rate-target="details">
              <%= form.label :reduced_rate_reason, "Justificatif", class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :reduced_rate_reason,
                  options_for_select(['RSA', 'Mineur', 'Situation Handicap', 'Étudiant', 'Autre']),
                  { include_blank: "Sélectionner..." },
                  { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
                    data: { reduced_rate_target: "reason", action: "change->reduced-rate#reasonChanged" } } %>
            </div>

            <div class="mt-3 <%= @person.reduced_rate_reason == 'Autre' ? '' : 'hidden' %>" data-reduced-rate-target="proof">
              <%= form.label :reduced_rate_proof, "Précision", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :reduced_rate_proof,
                  placeholder: "Préciser le motif ou le justificatif",
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
          </div>

          <div class="flex justify-end space-x-3">
            <%= link_to "Annuler", admin_user_path(Admin::Users::PersonRouteKey.call(@person)),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Mettre à jour",
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
