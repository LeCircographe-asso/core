<% content_for :title, "Créer un nouvel utilisateur" %>

<div class="min-h-screen py-6">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- En-tête -->
    <div class="mb-6">
      <div class="flex items-center">
        <%= link_to admin_users_path, class: "mr-4 text-gray-500 hover:text-[#1F5C55]" do %>
          <i class="fas fa-arrow-left"></i>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">Créer un nouvel utilisateur</h1>
      </div>
      <p class="mt-2 text-sm text-gray-500">Ajoutez un nouvel utilisateur au système</p>
    </div>

    <!-- Formulaire -->
    <div class="bg-white shadow overflow-hidden rounded-lg">
      <div class="px-6 py-5 border-b border-gray-200">
        <h2 class="text-lg leading-6 font-medium text-gray-900">Informations de l'utilisateur</h2>
      </div>
      <div class="p-6">
        <%= form_with(model: [:admin, @user], class: "space-y-6") do |form| %>
          <% if @user.errors.any? %>
            <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i class="fas fa-exclamation-circle text-red-400"></i>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= pluralize(@user.errors.count, "erreur") %> <%= @user.errors.count > 1 ? "empêchent" : "empêche" %> la sauvegarde de cet utilisateur :
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @user.errors.each do |error| %>
                        <li><%= error.full_message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :email_address, "Adresse email", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1 relative rounded-md shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-envelope text-gray-400"></i>
                </div>
                <%= form.email_field :email_address, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md", placeholder: "email@exemple.com" %>
              </div>
            </div>

            <div></div>

            <div>
              <%= form.label :first_name, "Prénom", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1 relative rounded-md shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-user text-gray-400"></i>
                </div>
                <%= form.text_field :first_name, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md" %>
              </div>
            </div>

            <div>
              <%= form.label :last_name, "Nom", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1 relative rounded-md shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-user text-gray-400"></i>
                </div>
                <%= form.text_field :last_name, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md" %>
              </div>
            </div>

            <div class="md:col-span-2">
              <div class="flex items-center">
                <%= form.check_box :newsletter_subscribed, class: "h-4 w-4 text-[#1F5C55] focus:ring-[#1F5C55] border-gray-300 rounded" %>
                <%= form.label :newsletter_subscribed, "Inscrire à la newsletter", class: "ml-2 block text-sm text-gray-700" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">L'utilisateur recevra les communications par email</p>
            </div>
          </div>

          <div class="bg-gray-50 p-4 rounded-md mt-4">
            <div class="flex items-center mb-2">
              <i class="fas fa-info-circle text-blue-500 mr-2"></i>
              <h3 class="text-sm font-medium text-gray-800">Informations importantes</h3>
            </div>
            <p class="text-sm text-gray-600">Un mot de passe temporaire sera généré automatiquement et l'utilisateur recevra un email avec les instructions pour se connecter.</p>
          </div>

          <div class="flex justify-end pt-5 border-t border-gray-200">
            <%= link_to "Annuler", admin_users_path, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Créer l'utilisateur", class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>