<% content_for :title, "Créer un nouvel utilisateur" %>

<div class="min-h-screen py-6">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Créer un nouvel utilisateur</h1>
      <p class="mt-2 text-sm text-gray-500">Ajoutez un nouvel utilisateur au système</p>
    </div>

    <!-- Form -->
        <div class="bg-white shadow overflow-hidden rounded-lg">
          <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg leading-6 font-medium text-gray-900">Informations de l'utilisateur</h2>
          </div>
          <div class="p-6">
            <%= form_with(model: [:admin, @user],method: :post, data: { turbo: false }, class: "space-y-6") do |form| %>
          <% if @user.errors.any? %>
            <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i class="fas fa-exclamation-circle text-red-400"></i>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= pluralize(@user.errors.count, "erreur") %> <%= @user.errors.count > 1 ? "empêchent" : "empêche" %> la sauvegarde de cet utilisateur :
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @user.errors.each do |error| %>
                        <li><%= error.full_message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Section Compte web (optionnel) -->
          <div class="mb-6">
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <%= form.check_box :create_web_account, { class: "focus:ring-[#1F5C55] h-4 w-4 text-[#1F5C55] border-gray-300 rounded", checked: @person.present?, onclick: "toggleWebAccountFields()" }, "true", "false" %>
                  </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">Créer un compte web</h3>
                  <p class="text-sm text-gray-600">Permettre à cette personne de se connecter et gérer son profil en ligne</p>
                </div>
              </div>
              
              <!-- Champs conditionnels pour le compte web -->
              <div id="web-account-fields" class="mt-4 space-y-4" style="<%= @person.present? ? 'display: block;' : 'display: none;' %>">
                <% if Current.user&.admin? || Current.user&.super_admin? %>
                  <!-- Admin/Super Admin peut choisir le rôle -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <%= form.label :system_role, "Rôle système", class: "block text-sm font-medium text-gray-700" %>
                      <%= form.select :system_role, 
                          options_for_select([
                            ['Visiteur web', 'web_visitor'],
                            ['Bénévole', 'volunteer'],
                            ['Administrateur', 'admin']
                          ], 'web_visitor'), 
                          {}, 
                          { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" } %>
                    </div>
                    <div>
                      <div class="bg-blue-50 border border-blue-200 rounded-md p-3">
                        <div class="flex">
                          <div class="flex-shrink-0">
                            <i class="fas fa-key text-blue-400"></i>
                          </div>
                          <div class="ml-3">
                            <p class="text-sm text-blue-700">Un mot de passe temporaire sera généré et envoyé par email</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <!-- Bénévole ne peut que créer des comptes web_visitor -->
                  <div class="bg-green-50 border border-green-200 rounded-md p-3">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <i class="fas fa-user text-green-400"></i>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm text-green-700">Un compte "Visiteur web" sera créé avec un mot de passe temporaire</p>
                      </div>
                    </div>
                  </div>
                  <%= form.hidden_field :system_role, value: 'web_visitor' %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Section Person (Données réelles) -->
          <div class="mb-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Informations personnelles</h3>
            <%= form.fields_for :person, @user.person || @user.build_person do |person_form| %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <%= person_form.label :first_name, "Prénom", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-user text-gray-400"></i>
                    </div>
                    <%= person_form.text_field :first_name, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md" %>
                  </div>
                </div>

                <div>
                  <%= person_form.label :last_name, "Nom", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-user text-gray-400"></i>
                    </div>
                    <%= person_form.text_field :last_name, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md" %>
                  </div>
                </div>

                <div>
                  <%= person_form.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-envelope text-gray-400"></i>
                    </div>
                    <%= person_form.email_field :email, { class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md", placeholder: "email@exemple.com", id: "person_email_field" } %>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Obligatoire si compte web activé</p>
                </div>

                <div>
                  <%= person_form.label :phone, "Téléphone", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-phone text-gray-400"></i>
                    </div>
                    <%= person_form.telephone_field :phone, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md", placeholder: "06 12 34 56 78" %>
                  </div>
                </div>

                <div>
                  <%= person_form.label :birth_date, "Date de naissance", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-calendar text-gray-400"></i>
                    </div>
                    <%= person_form.date_field :birth_date, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md" %>
                  </div>
                </div>

                <div>
                  <%= person_form.label :address, "Adresse", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-map-marker-alt text-gray-400"></i>
                    </div>
                    <%= person_form.text_field :address, class: "pl-10 block w-full focus:ring-[#1F5C55] focus:border-[#1F5C55] sm:text-sm border-gray-300 rounded-md", placeholder: "123 rue de la Paix" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Section Préférences et Options -->
          <div class="mb-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Préférences et Options</h3>
            <%= form.fields_for :person, @user.person || @user.build_person do |person_form| %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                  <div class="flex items-center">
                    <%= person_form.check_box :newsletter_subscribed, { class: "focus:ring-[#1F5C55] h-4 w-4 text-[#1F5C55] border-gray-300 rounded", id: "newsletter_checkbox", onclick: "toggleNewsletterNote()" } %>
                    <%= person_form.label :newsletter_subscribed, "S'abonner à la newsletter", class: "ml-2 block text-sm text-gray-900" %>
                  </div>
                  <p class="text-xs text-gray-500 ml-6" id="newsletter_note" style="display: none;">⚠️ Un email est requis pour la newsletter</p>
                  
                  <div class="flex items-center">
                    <%= person_form.check_box :get_involved, { class: "focus:ring-[#1F5C55] h-4 w-4 text-[#1F5C55] border-gray-300 rounded" } %>
                    <%= person_form.label :get_involved, "Souhaite s'impliquer / nous aider", class: "ml-2 block text-sm text-gray-900" %>
                  </div>
                  
                  <div class="flex items-center">
                    <%= person_form.check_box :image_rights, { class: "focus:ring-[#1F5C55] h-4 w-4 text-[#1F5C55] border-gray-300 rounded" } %>
                    <%= person_form.label :image_rights, "Droit à l'image accordé", class: "ml-2 block text-sm text-gray-900" %>
                  </div>
                </div>
                
                <div class="space-y-4">
                  
                  <div>
                    <div class="flex items-center">
                      <%= person_form.check_box :is_minor, { class: "focus:ring-[#1F5C55] h-4 w-4 text-[#1F5C55] border-gray-300 rounded" } %>
                      <%= person_form.label :is_minor, "Personne mineure", class: "ml-2 block text-sm text-gray-900" %>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Cochez si la personne a moins de 18 ans</p>
                  </div>
                  
                  <div>
                    <%= person_form.label :specialty, "Spécialité", class: "block text-sm font-medium text-gray-700" %>
                    <%= person_form.text_field :specialty, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm", placeholder: "Jonglage, Acrobatie, etc." %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="bg-gray-50 p-4 rounded-md mt-4">
            <div class="flex items-center mb-2">
              <i class="fas fa-info-circle text-blue-500 mr-2"></i>
              <h3 class="text-sm font-medium text-gray-800">Informations importantes</h3>
            </div>
            <p class="text-sm text-gray-600">Après la création, vous serez redirigé vers la page de création d'adhésion pour finaliser l'inscription.</p>
          </div>

          <div class="flex justify-end pt-5 border-t border-gray-200">
            <%= link_to "Annuler", admin_users_path, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Créer l'utilisateur", class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function toggleWebAccountFields() {
  const checkbox = document.querySelector('input[name="user[create_web_account]"]');
  const webAccountFields = document.getElementById('web-account-fields');
  
  if (checkbox && webAccountFields) {
    if (checkbox.checked) {
      webAccountFields.style.display = 'block';
    } else {
      webAccountFields.style.display = 'none';
    }
  }
  
  // Mettre à jour l'état de l'email
  updateEmailRequirement();
}

function toggleNewsletterNote() {
  const checkbox = document.getElementById('newsletter_checkbox');
  const note = document.getElementById('newsletter_note');
  
  if (checkbox && note) {
    if (checkbox.checked) {
      note.style.display = 'block';
    } else {
      note.style.display = 'none';
    }
  }
  
  // Mettre à jour l'état de l'email
  updateEmailRequirement();
}

function updateEmailRequirement() {
  const emailField = document.getElementById('person_email_field');
  const webAccountCheckbox = document.querySelector('input[name="user[create_web_account]"]');
  const newsletterCheckbox = document.getElementById('newsletter_checkbox');
  
  if (emailField) {
    // Email obligatoire si compte web OU newsletter coché
    const webAccountChecked = webAccountCheckbox ? webAccountCheckbox.checked : false;
    const newsletterChecked = newsletterCheckbox ? newsletterCheckbox.checked : false;
    
    emailField.required = webAccountChecked || newsletterChecked;
  }
}
</script>


