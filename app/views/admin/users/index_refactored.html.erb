<% content_for :title, "Gestion des Adhérents (Refactorisé)" %>

<div class="min-h-screen py-6" data-controller="admin-users">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header avec gradient -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Gestion des Adhérents (Refactorisé)</h1>
        <p class="text-white/80 mt-1">
          Interface unifiée pour gérer les personnes, adhésions et cotisations - Version avec ViewComponents
        </p>
      </div>

      <div class="p-6">
        <!-- Statistiques -->
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Statistiques</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            <!-- Total personnes -->
            <div class="stat-card bg-blue-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-blue-500">Total personnes</p>
              <p class="text-2xl font-bold text-blue-800"><%= @total_people %></p>
            </div>
            
            <!-- Nouveaux d'hier -->
            <div class="stat-card bg-teal-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-teal-500">Nouveaux (hier)</p>
              <p class="text-2xl font-bold text-teal-800"><%= @new_users_yesterday %></p>
            </div>
            
            <!-- Adhésions Basic -->
            <div class="stat-card bg-green-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type="basic"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-green-500">Adhésions Basic</p>
              <p class="text-2xl font-bold text-green-800"><%= @basic_memberships %></p>
            </div>
            
            <!-- Adhésions Circus -->
            <div class="stat-card bg-indigo-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type="circus"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-indigo-500">Adhésions Circus</p>
              <p class="text-2xl font-bold text-indigo-800"><%= @circus_memberships %></p>
            </div>
            
            <!-- Adhésions actives -->
            <div class="stat-card bg-emerald-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type="active"
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-emerald-500">Adhésions actives</p>
              <p class="text-2xl font-bold text-emerald-800"><%= @active_memberships %></p>
            </div>
            
            <!-- Utilisateurs ce mois -->
            <div class="stat-card bg-purple-50 rounded-lg p-4 cursor-pointer" 
                 data-admin-users-target="statCard" 
                 data-stat-type=""
                 data-action="click->admin-users#statCardClick">
              <p class="text-sm text-purple-500">Utilisateurs (mois)</p>
              <p class="text-2xl font-bold text-purple-800"><%= @users_this_month %></p>
            </div>
          </div>
        </div>

        <!-- Filtres et recherche -->
        <div class="mb-6 flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <%= form_with url: admin_users_path, method: :get, local: true, class: "flex gap-2" do |form| %>
              <%= form.text_field :search, 
                    value: params[:search], 
                    placeholder: "Rechercher par nom, email, téléphone...", 
                    class: "flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#1F5C55] focus:border-transparent" %>
              <%= form.submit "Rechercher", class: "px-4 py-2 bg-[#1F5C55] text-white rounded-md hover:bg-[#194A45] transition-colors" %>
            <% end %>
          </div>
          
          <div class="flex gap-2">
            <%= link_to "Tous", admin_users_path, 
                  class: "px-3 py-2 rounded-md text-sm font-medium #{'bg-[#1F5C55] text-white' if params[:filter].blank?} #{'bg-gray-100 text-gray-700 hover:bg-gray-200' if params[:filter].present?}" %>
            <%= link_to "Avec adhésion active", admin_users_path(filter: 'with_active_membership'), 
                  class: "px-3 py-2 rounded-md text-sm font-medium #{'bg-[#1F5C55] text-white' if params[:filter] == 'with_active_membership'} #{'bg-gray-100 text-gray-700 hover:bg-gray-200' if params[:filter] != 'with_active_membership'}" %>
            <%= link_to "Sans adhésion", admin_users_path(filter: 'without_membership'), 
                  class: "px-3 py-2 rounded-md text-sm font-medium #{'bg-[#1F5C55] text-white' if params[:filter] == 'without_membership'} #{'bg-gray-100 text-gray-700 hover:bg-gray-200' if params[:filter] != 'without_membership'}" %>
            <%= link_to "Avec compte web", admin_users_path(filter: 'with_user_account'), 
                  class: "px-3 py-2 rounded-md text-sm font-medium #{'bg-[#1F5C55] text-white' if params[:filter] == 'with_user_account'} #{'bg-gray-100 text-gray-700 hover:bg-gray-200' if params[:filter] != 'with_user_account'}" %>
          </div>
        </div>

        <!-- Tableau des adhérents -->
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Nom
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Contact
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Statut
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Type
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Cotisations
                  </th>
                  <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Compte Web
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if @people.any? %>
                  <% @people.each do |person| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        <%= display_name(person) %>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <div class="space-y-1">
                          <div><%= display_email(person) %></div>
                          <div><%= display_phone(person) %></div>
                        </div>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <%= render MembershipStatusBadgeComponent.new(person: person) %>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <%= render MembershipTypeBadgeComponent.new(person: person) %>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <%= render SubscriptionStatusBadgeComponent.new(person: person) %>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                        <%= render WebAccountIconComponent.new(person: person) %>
                      </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <%= render ContextualActionsComponent.new(person: person) %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="7" class="px-6 py-10 text-center text-gray-500">
                      <div class="empty-state flex flex-col items-center">
                        <svg class="h-12 w-12 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                        </svg>
                        <p class="text-lg font-medium">Aucun adhérent trouvé</p>
                        <p class="text-sm text-gray-400 mt-1">Essayez de modifier vos critères de recherche</p>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Pagination -->
        <% if @pagy %>
          <div class="mt-6 flex justify-center">
            <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
