<% content_for :title, "Utilisateurs" %>

<div class="min-h-screen py-6">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Gestion des utilisateurs</h1>
        <p class="text-white/80 mt-1">
          <% if @showing_deleted %>
            Affichage des utilisateurs supprimés
          <% else %>
            Voir et gérer tous les utilisateurs actifs
          <% end %>
        </p>
      </div>

      <div class="p-6">
        <!-- Statistics -->
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Statistiques</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            <!-- Total personnes -->
            <div class="bg-blue-50 rounded-lg p-4">
              <p class="text-sm text-blue-500">Total personnes</p>
              <p class="text-2xl font-bold text-blue-800"><%= @total_people %></p>
            </div>
            
            <!-- Nouveaux d'hier -->
            <div class="bg-teal-50 rounded-lg p-4">
              <p class="text-sm text-teal-500">Nouveaux (hier)</p>
              <p class="text-2xl font-bold text-teal-800"><%= @new_users_yesterday %></p>
            </div>
            
            <!-- Adhésions Basic -->
            <div class="bg-green-50 rounded-lg p-4">
              <p class="text-sm text-green-500">Adhésions Basic</p>
              <p class="text-2xl font-bold text-green-800"><%= @basic_memberships %></p>
            </div>
            
            <!-- Adhésions Circus -->
            <div class="bg-indigo-50 rounded-lg p-4">
              <p class="text-sm text-indigo-500">Adhésions Circus</p>
              <p class="text-2xl font-bold text-indigo-800"><%= @circus_memberships %></p>
            </div>
            
            <!-- Adhésions actives totales -->
            <div class="bg-purple-50 rounded-lg p-4">
              <p class="text-sm text-purple-500">Adhésions actives</p>
              <p class="text-2xl font-bold text-purple-800"><%= @active_memberships %></p>
            </div>
            
            <!-- Personnes sans compte -->
            <div class="bg-orange-50 rounded-lg p-4">
              <p class="text-sm text-orange-500">Sans compte</p>
              <p class="text-2xl font-bold text-orange-800"><%= @people_without_user %></p>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-3 mb-8">
          <% unless @showing_deleted %>
            <%= link_to "Créer un Adhérent", new_admin_user_path, 
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            
            <%= link_to "Export CSV", all_users_admin_exports_path, 
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          <% end %>
          
          <!-- Toggle deleted users view -->
          <div class="ml-auto">
            <% if @showing_deleted %>
              <%= link_to "Afficher les utilisateurs actifs", admin_users_path(show_deleted: 'false'), 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <% else %>
              <%= link_to "Afficher les utilisateurs supprimés", admin_users_path(show_deleted: 'true'), 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <% end %>
          </div>
        </div>

        <!-- Section Title -->
        <h2 class="text-lg font-semibold text-gray-900 border-b pb-2 mb-4">
          <% if @showing_deleted %>
            Liste des utilisateurs supprimés
          <% else %>
            Liste des utilisateurs
          <% end %>
        </h2>

        <!-- Explicit wrapper for the array -->
        <div class="user-table-container" style="overflow-x: auto !important;">
          <div class="user-table">
            <table class="min-w-full bg-white border border-gray-200 rounded-lg">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Id</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rôle</th>
                  <% unless @showing_deleted %>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Abonnement</th>
                  <% else %>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Supprimé le</th>
                  <% end %>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% if @people.any? %>
                      <% @people.each do |person| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= person.id %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= person.full_name.present? ? person.full_name : "Non renseigné" %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <% if person.user %>
                          <%= person.user.email_address %>
                        <% else %>
                          <span class="text-gray-400 italic">Pas de compte</span>
                        <% end %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <% if person.user %>
                          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                            <%= person.user.system_role.humanize %>
                          </span>
                        <% else %>
                          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                            Sans compte
                          </span>
                        <% end %>
                      </td>
                      
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                          <% if person.has_active_membership? %>
                            <% current_membership = person.current_membership %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                              <%= current_membership.membership_type.name %> (Actif)
                            </span>
                          <% elsif person.memberships.exists? %>
                            <% last_membership = person.memberships.order(:created_at).last %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                              <%= last_membership.membership_type.name %> (Expiré)
                            </span>
                          <% else %>
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                              Pas d'adhésion
                            </span>
                          <% end %>
                        </td>
                      
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <!-- Lien vers la fiche Person (unifié) -->
                        <%= link_to "Voir", admin_user_path("person_#{person.id}"), 
                            class: "text-grey-600 hover:text-purple-900 mr-3", 
                            data: { turbo: false } %>
                        
                        <% if person.user %>
                          <% if @showing_deleted %>
                            <%= link_to "Restaurer", admin_user_path(person.user), 
                                class: "text-green-600 hover:text-green-900",
                                data: { turbo: false } %>
                          <% else %>
                            <%= link_to "Modifier", edit_admin_user_path(person.user), 
                                class: "text-blue-600 hover:text-blue-900" %>
                          <% end %>
                        <% else %>
                          <%= link_to "Créer compte", new_admin_user_path(person_id: person.id), 
                              class: "text-green-600 hover:text-green-900 mr-3", 
                              data: { turbo: false } %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                      <% if @showing_deleted %>
                        Aucun utilisateur supprimé n'a été trouvé.
                      <% else %>
                        Aucun utilisateur n'a été trouvé.
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>