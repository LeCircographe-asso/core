<% content_for :title, "Utilisateurs" %>

<div class="min-h-screen py-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Gestion des utilisateurs</h1>
        <p class="text-white/80 mt-1">Voir et gérer tous les utilisateurs</p>
      </div>

      <div class="p-6">
        <!-- Statistics -->
        <div class="mb-6 bg-green-50 p-4 rounded-lg">
          <p class="text-green-800 font-medium">
            <span class="font-bold">Nombre d'utilisateurs :</span> <%= @users.count %>
          </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-3 mb-8">
          <%= link_to "Modifier les horaires", edit_admin_opening_hours_path, 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
          
          <%= link_to "Créer un Adhérent", new_admin_user_path, 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" %>
        </div>

        <!-- Section Title -->
        <h2 class="text-lg font-semibold text-gray-900 border-b pb-2 mb-4">Liste des utilisateurs</h2>

        <!-- Explicit wrapper for the array -->
        <div class="user-table-container" style="overflow-x: auto !important;">
          <div class="user-table">
            <table class="min-w-full bg-white border border-gray-200 rounded-lg">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Id</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rôle</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Abonnement</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% @users.each do |user| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= user.id %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.email_address %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                        <%= user.system_role.humanize %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <% if user.user_memberships.exists? %>
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= user.user_memberships.exists?(status: "active") ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                          <%= user.user_memberships.order(:created_at).last.membership.type_name %>
                        </span>
                      <% else %>
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                          Non adhérent
                        </span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                      <%= link_to "Voir", admin_user_path(user), 
                          class: "text-grey-600 hover:text-purple-900 mr-3", 
                          data: { turbo: false } %>
                      <%= link_to "Modifier", edit_admin_user_path(user), 
                          class: "text-blue-600 hover:text-blue-900" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>