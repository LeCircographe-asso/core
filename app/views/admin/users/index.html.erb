
<% content_for :title, "Users" %>
<div class="admin-dashboard">
    <h1 class="dashboard-title">Tableau de bord administrateur</h1>
    <h1 class="dashboard-title">Tableau de bord administrateur</h1>

  <div class="dashboard-stats">
    <p><strong>Nombre d'utilisateurs :</strong> <%= @users.count %></p>
    <p><strong>Nombre d'Adhesion active :</strong> <%=@total_user_memberships%></p>

  </div>

  <div class="dashboard-actions">
    <%= link_to "Modifier les horaires", edit_admin_opening_hours_path, class: "purple-button" %>
    <%= link_to "Creer un Adhérent (basique)", new_admin_user_path, class: "purple-button"%>
   
  </div>

  <h2 class="dashboard-subtitle">Liste des utilisateurs</h2>

  <table class="dashboard-table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Email</th>
        <th>Rôle</th>
        <th>Abonnement</th>
        <th>Action</th>
        <th>Adhesion en cours</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.email_address %></td>
        <td>
          <%= user.system_role%>
        </td>
        <td>
          <%= link_to "voir", admin_user_path(user), class: "purple-button", data: { turbo: false } %>
        </td>
        <td>
          <%= link_to "Editer", edit_admin_user_path(user), method: :get, class: "purple-button" %>
        </td>        
        </td>
        <td>
          <% user.user_memberships.where(status: "active").each do |user_membership| %>
            <li><%= user_membership.membership.type_name %></li>
          <% end %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>