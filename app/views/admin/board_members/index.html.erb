<div class="min-h-screen bg-gray-50/40 py-6 px-4">
  <div class="max-w-3xl mx-auto space-y-5">
    <%= render 'shared/breadcrumbs' %>

    <div class="flex items-end justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Conseil d'administration</h1>
        <p class="text-sm text-gray-400 mt-0.5">
          <%= BoardMember.count %> membre<%= "s" if BoardMember.count != 1 %> · glisser pour réordonner
        </p>
      </div>
      <%= link_to t("admin.board_members.index.new"), new_admin_board_member_path,
            data: { turbo_frame: "modal" },
            class: "btn-primary text-sm" %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
      <% if @board_members.any? %>
        <%= render layout: "admin/shared/sortable_list", locals: { reorder_url: reorder_admin_board_members_path } do %>
          <% @board_members.each_with_index do |member, i| %>
            <%= render "admin/shared/sortable_row", item: member, index: i,
                edit_path: edit_admin_board_member_path(member),
                edit_text: t("admin.board_members.index.edit"),
                delete_path: admin_board_member_path(member),
                confirm_delete_text: t("admin.board_members.index.confirm_delete") do %>
              <div class="shrink-0 w-10 h-10 rounded-full overflow-hidden bg-gray-100">
                <% if member.avatar.attached? %>
                  <%= image_tag member.avatar.variant(resize_to_fill: [ 80, 80 ]), class: "w-full h-full object-cover" %>
                <% else %>
                  <%= image_tag "placeholder_avatar.webp", class: "w-full h-full object-cover" %>
                <% end %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 leading-snug"><%= member.name %></p>
                <p class="text-xs text-gray-400 mt-0.5 line-clamp-1"><%= member.role %></p>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="px-4 py-5 text-sm text-gray-400 italic text-center"><%= t("admin.board_members.index.empty") %></p>
      <% end %>
    </div>

  </div>
</div>

<%= turbo_frame_tag "modal" %>
