<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-xl font-bold text-gray-900 mb-6">Paramètres FAQ</h1>

  <%= form_with url: admin_faq_path, method: :patch do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :hero, "Titre hero", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :hero, value: @faq_data[:hero], name: "faq[hero]", class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
      </div>

      <div>
        <%= f.label :cta_label, "Label CTA", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :cta_label, value: @faq_data[:cta_label], name: "faq[cta_label]", class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
      </div>

      <% @faq_data[:entries].each_with_index do |entry, i| %>
        <div class="border border-gray-200 rounded p-3 space-y-2">
          <input type="text" name="faq[entries][<%= i %>][question]" value="<%= entry[:question] %>" placeholder="Question" class="block w-full border-gray-300 rounded-md shadow-sm text-sm">
          <textarea name="faq[entries][<%= i %>][answer]" placeholder="Réponse" class="block w-full border-gray-300 rounded-md shadow-sm text-sm"><%= entry[:answer] %></textarea>
        </div>
      <% end %>

      <%= f.submit "Enregistrer", class: "btn-primary" %>
    </div>
  <% end %>
</div>
