<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" id="faq-modal">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg mx-4 p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">
          <%= faq.persisted? ? t("admin.faqs.form.edit_title") : t("admin.faqs.form.new_title") %>
        </h2>
        <%= link_to "✕", admin_faqs_path, data: { turbo_frame: "modal" }, class: "text-gray-400 hover:text-gray-600 text-xl" %>
      </div>

      <%= form_with model: [:admin, faq], class: "space-y-4" do |f| %>
        <div>
          <%= f.label :label, t("admin.faqs.form.label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :label, Faq::LABELS.map { |l| [l.capitalize, l] },
                { selected: faq.label },
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= f.label :question, t("admin.faqs.form.question"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :question, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm",
                placeholder: t("admin.faqs.form.question_placeholder") %>
        </div>

        <div>
          <%= f.label :answer, t("admin.faqs.form.answer"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :answer, rows: 4, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm",
                placeholder: t("admin.faqs.form.answer_placeholder") %>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <%= link_to t("admin.faqs.form.cancel"), admin_faqs_path,
                data: { turbo_frame: "modal" },
                class: "text-sm text-gray-600 hover:underline" %>
          <%= f.submit faq.persisted? ? t("admin.faqs.form.save") : t("admin.faqs.form.create"),
                class: "btn-primary text-sm" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
