<div class="min-h-screen py-6 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">FAQ</h1>
      <%= link_to t("admin.faqs.index.new"), new_admin_faq_path,
            data: { turbo_frame: "modal" },
            class: "btn-primary" %>
    </div>

    <% @labels.each do |label| %>
      <% entries = @faqs[label] || [] %>
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-3 capitalize"><%= label %></h2>

        <% if entries.any? %>
          <div class="space-y-2">
            <% entries.each do |faq| %>
              <div class="bg-white rounded-lg border border-gray-200 p-4 flex items-start justify-between gap-4">
                <div class="flex-1">
                  <p class="font-medium text-gray-900"><%= faq.question %></p>
                  <p class="text-sm text-gray-500 mt-1"><%= faq.answer %></p>
                </div>
                <div class="flex gap-2 shrink-0">
                  <%= link_to t("admin.faqs.index.edit"), edit_admin_faq_path(faq),
                        data: { turbo_frame: "modal" },
                        class: "text-sm text-blue-600 hover:underline" %>
                  <%= button_to t("admin.faqs.index.delete"), admin_faq_path(faq),
                        method: :delete,
                        data: { turbo_confirm: t("admin.faqs.index.confirm_delete") },
                        class: "text-sm text-red-600 hover:underline bg-transparent border-0 cursor-pointer" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 italic"><%= t("admin.faqs.index.empty") %></p>
        <% end %>

        <%= link_to "+ #{t('admin.faqs.index.add_to_label', label: label)}", new_admin_faq_path(label: label),
              data: { turbo_frame: "modal" },
              class: "mt-2 inline-block text-sm text-gray-500 hover:text-gray-700" %>
      </section>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
