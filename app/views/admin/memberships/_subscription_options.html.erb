<div class="bg-white shadow-lg rounded-lg p-6">
  <h2 class="text-xl font-semibold text-gray-900 mb-4">Options de Cotisation</h2>
  
  <% if @person.can_buy_subscription_plans? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @subscription_plans.each do |subscription_plan| %>
        <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
          <h3 class="text-lg font-medium text-gray-900"><%= subscription_plan.name %></h3>
          <p class="text-sm text-gray-600 mt-1"><%= subscription_plan.description %></p>
          
          <div class="mt-3">
            <p class="text-2xl font-bold text-[#1F5C55]"><%= subscription_plan.price_euros %> €</p>
            <% if subscription_plan.sessions_count %>
              <p class="text-sm text-gray-500"><%= subscription_plan.sessions_count %> séances</p>
            <% end %>
            <% if subscription_plan.validity_days %>
              <p class="text-sm text-gray-500">Valide <%= subscription_plan.validity_days %> jours</p>
            <% end %>
          </div>
          
          <div class="mt-4">
            <%= form_with url: admin_user_path("person_#{@person.id}"), method: :post, local: true do |form| %>
              <%= form.hidden_field :subscription_plan_id, value: subscription_plan.id %>
              <%= form.hidden_field :payment_method, value: 'cash' %>
              <%= form.submit "Acheter", 
                  class: "w-full inline-flex justify-center items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]",
                  name: "create_subscription" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">
            Adhésion Cirque requise
          </h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p>Cette personne doit avoir une adhésion Cirque (plein tarif ou réduit) pour acheter des plans d'abonnement.</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
