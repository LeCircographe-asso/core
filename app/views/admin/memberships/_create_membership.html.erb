<div class="bg-white shadow-lg rounded-lg p-6 mb-6">
  <% if @is_upgrade %>
    <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 p-4">
      <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Passage en adhésion Cirque</h2>
          <p class="mt-1 text-sm text-gray-700">
            <strong>Adhésion actuelle :</strong>
            <%= @current_membership.membership_type.name %> - <%= @current_membership.membership_type.price_euros %>€
          </p>
        </div>
        <div class="rounded-md border border-yellow-200 bg-yellow-50 px-3 py-2 text-sm text-yellow-900">
          <strong>Règle d'upgrade :</strong>
          <%= upgrade_membership_rule_hint %>
        </div>
      </div>

      <% if @person.reduced_rate_eligible? %>
        <p class="mt-3 text-sm text-blue-800">
          <strong>Tarif réduit éligible :</strong>
          <%= @person.reduced_rate_reason %>
        </p>
      <% end %>
    </div>
  <% else %>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Créer une Adhésion</h2>

    <% if @person&.reduced_rate_eligible? %>
      <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <div>
          <p class="text-sm font-medium text-amber-800">
            Tarif réduit applicable — <%= @person.reduced_rate_reason %>
          </p>
          <p class="mt-0.5 text-xs text-amber-700">
            Seuls les types d'adhésion correspondants à ce statut sont proposés ci-dessous.
          </p>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= form_with model: [:admin, @membership || Membership.new], url: admin_memberships_path, method: :post, local: true, class: "space-y-4", data: { controller: "offer-fields reduced-rate" } do |form| %>
    <%= form.hidden_field :person_id, value: @person.id %>
    <%= form.hidden_field :upgrade, value: @is_upgrade %>

    <% default_type_id = @person&.reduced_rate_eligible? ? @membership_types.find(&:reduced_rate?)&.id : nil %>
    <% reduced_rate_preselected = default_type_id.present? %>

    <div>
      <%= form.label :membership_type_id, @is_upgrade ? "Nouvelle adhésion Cirque" : "Type d'adhésion", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :membership_type_id,
          options_for_select(membership_type_select_options(@membership_types), default_type_id),
          { prompt: @is_upgrade ? "Sélectionner le nouveau type" : "Sélectionner un type d'adhésion" },
          { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
            required: true,
            data: { "reduced-rate-target": "select", action: "change->reduced-rate#selectChanged" } } %>
      <% if @membership_types.empty? %>
        <p class="text-red-500 text-sm mt-1">⚠️ Aucun type d'adhésion disponible</p>
      <% end %>
      <% if @is_upgrade %>
        <div class="mt-2 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm text-gray-700">
          Le prix affiche est celui qui sera enregistre sur le paiement d'upgrade.
        </div>
      <% end %>
    </div>

    <div class="<%= 'hidden' unless reduced_rate_preselected %>" data-reduced-rate-target="details">
      <%= label_tag :reduced_rate_reason, "Justificatif du tarif réduit", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag :reduced_rate_reason,
          options_for_select(Person::REDUCED_RATE_REASONS, @person.reduced_rate_reason),
          include_blank: "Sélectionner...",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
          data: { "reduced-rate-target": "reason", action: "change->reduced-rate#reasonChanged" } %>
    </div>

    <div class="<%= 'hidden' unless reduced_rate_preselected && @person.reduced_rate_reason == 'Autre' %>" data-reduced-rate-target="proof">
      <%= label_tag :reduced_rate_proof, "Précision", class: "block text-sm font-medium text-gray-700" %>
      <%= text_field_tag :reduced_rate_proof, @person.reduced_rate_proof,
          placeholder: "Préciser le motif ou le justificatif",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
    </div>

    <div>
      <%= form.label :payment_method, "Méthode de paiement", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :payment_method, 
          options_for_select(payment_method_options),
          { selected: 'cash' },
          { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
            data: { offer_fields_target: "paymentMethod", action: "change->offer-fields#refresh" } } %>
    </div>

    <div class="hidden" data-offer-fields-target="offerReason">
      <%= form.label :offer_reason, "Raison de l'offre", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :offer_reason,
          rows: 2,
          placeholder: "Ex: Bénévolat, geste commercial, partenariat...",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
          data: { offer_fields_target: "offerReasonInput" } %>
    </div>

    <div>
      <%= form.label :donation_amount, "Don additionnel (€) (optionnel)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :donation_amount,
          step: 0.01,
          min: 0,
          placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
    </div>
    
    <div class="flex justify-end">
      <%= form.submit @is_upgrade ? "Upgrader l'adhésion" : "Créer l'adhésion", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
    </div>
  <% end %>
</div>
