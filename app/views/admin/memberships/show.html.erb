<% content_for :title, "Détails de l'adhésion" %>

<div class="min-h-screen py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Main content -->
    <div id="membership-container" data-controller="membership-container">
      <div id="membership-container">
        <% if @person.has_active_membership? %>
          <%= render "membership_details" %>
        <% else %>
          <%= render "create_membership" %>
        <% end %>
      </div>
    </div>
    
    <%= turbo_frame_tag "membership_container" %>
    
    <% if @person.has_active_membership? %>
      <%= render "subscription_options" %>
    <% end %>
  </div>
</div>
