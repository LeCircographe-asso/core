<div class="min-h-screen bg-gray-50 py-8">
  <div class="page-container max-w-4xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <div class="surface-card p-6">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900"><%= @is_upgrade ? "Upgrade d'adhésion" : "Créer une adhésion" %></h1>
        <p class="mt-2 text-sm text-gray-600">
          <%= @is_upgrade ? "Passer l'adhésion de #{@person.full_name} en Cirque" : "Créer une adhésion pour #{@person.full_name}" %>
        </p>
      </div>
      
      <!-- Formulaire de création d'adhésion -->
      <%= render 'create_membership' %>
      
      <!-- Retour -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <%= link_to "← Retour à la fiche", admin_member_path(@person),
            class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
      </div>
    </div>
  </div>
</div>
