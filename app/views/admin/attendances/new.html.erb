<% content_for :title, "Ajouter des participants" %>

<div class="min-h-screen py-6">
  <div class="page-container max-w-5xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center">
        <% if @attendance_list %>
          <%= link_to admin_attendance_list_path(@attendance_list), class: "mr-4 text-gray-500 hover:text-[#1F5C55]" do %>
            <i class="fas fa-arrow-left"></i>
          <% end %>
        <% else %>
          <%= link_to admin_attendances_path, class: "mr-4 text-gray-500 hover:text-[#1F5C55]" do %>
            <i class="fas fa-arrow-left"></i>
          <% end %>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">Ajouter des participants</h1>
      </div>
      <% if @attendance_list %>
        <div class="mt-2">
          <p class="text-sm text-gray-500">
            Ajout de présences pour <span class="font-medium"><%= @attendance_list.list_type.humanize %></span> du
            <span class="font-medium"><%= @attendance_list.start_date.strftime("%d/%m/%Y") %></span>
          </p>
        </div>
      <% end %>
    </div>

    <!-- List of available people -->
    <div class="surface-card">
      <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-900">Personnes disponibles</h2>
        <p class="text-sm text-gray-500"><%= pluralize(@people_available.count, "personne", "personnes") %> disponible(s)</p>
      </div>

      <% if @people_available.present? %>
        <ul class="divide-y divide-gray-200">
          <% @people_available.each do |person| %>
            <li class="flex items-center justify-between hover:bg-gray-50 px-6 py-4">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <div class="h-10 w-10 rounded-full bg-[#1F5C55]/10 flex items-center justify-center">
                    <span class="text-[#1F5C55] font-medium">
                      <%= "#{person.first_name&.first}#{person.last_name&.first}".strip.presence || "?" %>
                    </span>
                  </div>
                </div>

                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900">
                    <%= [ person.first_name, person.last_name ].compact.join(" ") %>
                  </div>
                  <div class="text-sm text-gray-500 flex items-center gap-2">
                    <%= person.email.presence || "Pas d'email" %>
                    <%= render MembershipStatusBadgeComponent.new(person: person) %>
                  </div>
                </div>
              </div>

              <%= button_to(
                    @attendance_list ? admin_attendance_list_attendances_path(@attendance_list) : admin_attendances_path,
                    method: :post,
                    params: {
                      attendance: {
                        person_id: person.id,
                        attendance_list_id: @attendance_list&.id
                      }
                    },
                    class: "px-3 py-1.5 bg-[#1F5C55] hover:bg-[#194A45] text-white text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55] flex items-center"
                  ) do %>
                <i class="fas fa-plus mr-1.5"></i> Ajouter
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="p-6 text-center">
          <div class="flex flex-col items-center py-6">
            <i class="fas fa-check-circle text-green-500 text-3xl mb-3"></i>
            <p class="text-gray-500">Toutes les personnes ont déjà été ajoutées à cette liste</p>
            <% if @attendance_list %>
              <p class="mt-1 text-xs text-gray-500">
                <%= link_to "Retour à la liste des participants", admin_attendance_list_path(@attendance_list), class: "text-[#1F5C55] hover:underline" %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
