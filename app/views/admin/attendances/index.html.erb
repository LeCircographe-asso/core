<% content_for :title, "Présences" %>

<div class="min-h-screen py-6">
  <div class="page-container max-w-5xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center">
        <%= link_to admin_attendance_lists_path, class: "mr-4 text-gray-500 hover:text-[#1F5C55]" do %>
          <i class="fas fa-arrow-left"></i>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">Présences</h1>
      </div>
      <div class="mt-2">
        <p class="text-sm text-gray-500">
          <span class="font-medium"><%= pluralize(@pagy.count, "présence") %></span> enregistrée(s)
        </p>
      </div>
    </div>

    <!-- Filter panel -->
    <div class="admin-filter-panel mb-6">
      <%= form_with url: admin_attendances_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
        <!-- Search -->
        <div class="flex-1">
          <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Recherche</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <%= form.text_field :search,
                id: "search",
                value: params[:search],
                placeholder: "Nom, email... (Ctrl+K pour focus)",
                class: "search-input pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <% if params[:search].present? %>
              <button type="button"
                      data-action="click->admin-payments#clearSearch"
                      class="absolute inset-y-0 right-0 pr-3 flex items-center">
                <svg class="h-4 w-4 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Event filter -->
        <div class="md:w-48">
          <label for="event_id" class="block text-sm font-medium text-gray-700 mb-1">Événement</label>
          <%= form.select :event_id,
              options_for_select([
                ['Tous', '']
              ] + Event.order(:name).map { |e| [e.name, e.id] }, params[:event_id]),
              {},
              {
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
                onchange: "this.form.submit()"
              } %>
        </div>

        <!-- Date filter -->
        <div class="md:w-48">
          <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Date</label>
          <%= form.date_field :date,
              value: params[:date],
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
        </div>

        <!-- Search button -->
        <div class="flex items-end">
          <%= form.submit "Filtrer", class: "admin-btn-primary" %>
        </div>
      <% end %>
    </div>

    <!-- List of attendances -->
    <div class="surface-card">
      <% if @attendances.present? %>
        <ul class="divide-y divide-gray-200">
          <% @attendances.each do |attendance| %>
            <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <div class="h-10 w-10 rounded-full bg-[#1F5C55]/10 flex items-center justify-center">
                    <span class="text-[#1F5C55] font-medium">
                      <%= "#{attendance.person.first_name&.first}#{attendance.person.last_name&.first}".strip.presence || "?" %>
                    </span>
                  </div>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900">
                    <%= link_to attendance.person.full_name, admin_member_path(attendance.person), class: "hover:text-[#1F5C55] hover:underline" %>
                  </div>
                  <div class="text-sm text-gray-500"><%= attendance.person.email.presence || "Pas d'email" %></div>
                </div>
              </div>
              <div class="text-right">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <i class="far fa-clock mr-1"></i>
                  <%= attendance.date.strftime("%d/%m/%Y") %>
                </span>
                <% if attendance.event.present? %>
                  <div class="text-xs text-gray-500 mt-1"><%= attendance.event.name %></div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        <div class="px-6 py-4">
          <%== pagy_nav(@pagy) %>
        </div>
      <% else %>
        <div class="p-6 text-center">
          <div class="flex flex-col items-center py-6">
            <i class="fas fa-users text-gray-400 text-3xl mb-3"></i>
            <p class="text-gray-500">Aucune présence enregistrée</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
