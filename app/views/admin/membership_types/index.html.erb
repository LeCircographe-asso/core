<div class="min-h-screen bg-gray-50 py-6">
  <div class="page-container-wide">
    <!-- Header -->
    <div class="admin-page-header">
      <div class="px-6 py-4 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-white">Types d'Adhésion</h1>
          <p class="text-green-100 mt-1">Gérer les types d'adhésion et leurs prix</p>
        </div>
        <% if Current.user&.can_administer? %>
          <div>
            <%= link_to "Nouveau type", new_admin_membership_type_path,
                class: "inline-flex items-center px-4 py-2 border border-white rounded-md shadow-sm text-sm font-medium text-[#1F5C55] bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 max-w-4xl mx-auto">
      <% @membership_types.each do |membership_type| %>
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-4 hover:shadow-lg transition-shadow duration-200">
          <div class="flex justify-between items-start mb-3">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-900 mb-1"><%= membership_type.name %></h3>
              <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= case membership_type.category
                      when 'basic' then 'bg-blue-100 text-blue-800'
                      when 'circus' then 'bg-green-100 text-green-800'
                      when 'event' then 'bg-yellow-100 text-yellow-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= membership_type.category_humanized %>
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= membership_type.rate_kind_badge_class %>">
                  <%= membership_type.rate_kind_humanized %>
                </span>
                <span class="text-sm text-gray-500">
                  <%= membership_type.memberships.count %> membres
                </span>
              </div>
            </div>
            <div class="text-right">
              <div class="text-xl font-bold text-[#1F5C55]"><%= membership_type.price_euros %>€</div>
            </div>
          </div>

          <div class="mb-4">
            <p class="text-sm text-gray-600 leading-relaxed"><%= membership_type.description %></p>
          </div>

          <% if Current.user&.can_administer? %>
            <div class="flex justify-end">
              <%= render "admin/shared/row_actions",
                  edit_path: edit_admin_membership_type_path(membership_type),
                  edit_text: "Modifier",
                  delete_path: membership_type.memberships.empty? ? admin_membership_type_path(membership_type) : nil,
                  delete_text: "Supprimer",
                  confirm_delete_text: "Êtes-vous sûr de vouloir supprimer ce type d'adhésion ?" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @archived_membership_types.any? %>
      <details class="mt-6 max-w-4xl mx-auto">
        <summary class="cursor-pointer text-sm font-medium text-gray-600 hover:text-gray-900">
          Historique (<%= @archived_membership_types.count %> version<%= "s" if @archived_membership_types.count > 1 %> archivée<%= "s" if @archived_membership_types.count > 1 %>)
        </summary>
        <div class="mt-3 space-y-2">
          <% @archived_membership_types.each do |archived| %>
            <div class="bg-gray-50 rounded-lg border border-gray-200 p-3 flex justify-between items-center text-sm text-gray-600">
              <span>
                <%= archived.name %> — v<%= archived.version %> — <%= archived.price_euros %>€
                (<%= archived.effective_from&.strftime("%d/%m/%Y") %> → <%= archived.effective_until&.strftime("%d/%m/%Y") %>)
              </span>
              <div class="flex items-center space-x-3">
                <% if Current.user&.can_administer? %>
                  <%= button_to "Désarchiver", unarchive_admin_membership_type_path(archived),
                      method: :post,
                      class: "text-[#1F5C55] hover:underline" %>
                <% end %>
                <%= link_to "Voir", admin_membership_type_path(archived), class: "text-[#1F5C55] hover:underline" %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <!-- Actions -->
    <div class="mt-6 flex justify-between">
      <%= link_to "Retour au tableau de bord", admin_dashboard_index_path,
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
    </div>
  </div>
</div>
