<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] rounded-lg shadow-lg mb-6">
      <div class="px-6 py-4 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-white">Types d'Adhésion</h1>
          <p class="text-green-100 mt-1">Gérer les types d'adhésion et leurs prix</p>
        </div>
        <div>
          <%= link_to "Nouveau type", new_admin_membership_type_path, 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-white bg-opacity-20 hover:bg-opacity-30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white" %>
        </div>
      </div>
    </div>

    <!-- Liste des types d'adhésion -->
    <div class="bg-white rounded-lg shadow-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Types d'Adhésion Disponibles</h2>
        <p class="text-sm text-gray-600 mt-1">Configurez les types d'adhésion et leurs tarifs</p>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Catégorie</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prix</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Membres</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @membership_types.each do |membership_type| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= membership_type.name %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= case membership_type.category
                        when 'basic' then 'bg-blue-100 text-blue-800'
                        when 'circus_full' then 'bg-green-100 text-green-800'
                        when 'circus_reduced' then 'bg-yellow-100 text-yellow-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= membership_type.category.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-semibold text-[#1F5C55]"><%= membership_type.price_euros %>€</div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm text-gray-900 max-w-xs truncate"><%= membership_type.description %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= membership_type.memberships.count %> membres
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <%= link_to "Voir", admin_membership_type_path(membership_type), 
                        class: "text-[#1F5C55] hover:text-[#194A45]" %>
                    <%= link_to "Modifier", edit_admin_membership_type_path(membership_type), 
                        class: "text-blue-600 hover:text-blue-900" %>
                    <% if membership_type.memberships.empty? %>
                      <%= link_to "Supprimer", admin_membership_type_path(membership_type), 
                          method: :delete, 
                          data: { confirm: "Êtes-vous sûr de vouloir supprimer ce type d'adhésion ?" },
                          class: "text-red-600 hover:text-red-900" %>
                    <% else %>
                      <span class="text-gray-400">Supprimer</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-6 flex justify-between">
      <%= link_to "Retour au tableau de bord", admin_dashboard_index_path,
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
    </div>
  </div>
</div>
