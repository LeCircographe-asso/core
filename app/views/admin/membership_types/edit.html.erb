<div class="min-h-screen bg-gray-50 py-6">
  <div class="page-container max-w-2xl">
    <!-- Header -->
    <div class="admin-page-header">
      <div class="px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Modifier le Type d'Adhésion</h1>
        <p class="text-green-100 mt-1"><%= @membership_type.name %></p>
      </div>
    </div>

    <!-- Formulaire -->
    <div class="surface-card">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Informations du Type d'Adhésion</h2>
      </div>

      <div class="p-6">
        <%= form_with model: [:admin, @membership_type], local: true, class: "space-y-6" do |form| %>
          <% if @membership_type.errors.any? %>
            <div class="bg-red-50 border border-red-200 rounded-md p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">Erreurs à corriger :</h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc list-inside space-y-1">
                      <% @membership_type.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div>
            <%= form.label :name, "Nom du type d'adhésion", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :name, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div>
            <p class="block text-sm font-medium text-gray-700">Catégorie / type tarifaire</p>
            <p class="mt-1 text-sm text-gray-600">
              <%= @membership_type.category_humanized %> — <%= @membership_type.rate_kind_humanized %> —
              non modifiable (réinterpréterait les adhésions déjà achetées). Créez un nouveau type si besoin.
            </p>
          </div>

          <div>
            <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_area :description,
                rows: 3,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="flex justify-end space-x-3">
            <%= link_to "Annuler", admin_membership_type_path(@membership_type),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Mettre à jour",
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Changement de prix : action séparée, ne mute jamais une version déjà vendue -->
    <div class="surface-card mt-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Changer le prix</h2>
        <p class="mt-1 text-sm text-gray-500">
          Prix actuel : <strong><%= @membership_type.price_euros %>€</strong> —
          <%= pluralize(@membership_type.memberships.count, "adhésion") %> déjà vendue<%= "s" if @membership_type.memberships.count > 1 %> sur cette version.
        </p>
        <p class="mt-1 text-sm text-gray-500">
          <% if @membership_type.memberships.empty? %>
            Jamais vendue à ce prix : la correction remplacera le prix actuel sans créer de nouvelle version.
          <% else %>
            Déjà vendue : le nouveau prix ouvrira une nouvelle version à partir d'aujourd'hui. Les adhésions déjà achetées gardent leur prix d'origine.
          <% end %>
        </p>
      </div>

      <div class="p-6">
        <%= form_with url: change_price_admin_membership_type_path(@membership_type), method: :post, local: true, class: "space-y-4" do |form| %>
          <div>
            <%= form.label :price, "Nouveau prix (€)", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :price, step: "0.01", min: "0", value: @membership_type.price_euros,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div>
            <%= form.label :reason, "Raison du changement", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :reason,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="flex justify-end">
            <%= form.submit "Changer le prix",
                data: { turbo_confirm: "Confirmer le changement de prix ?" },
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Archivage -->
    <div class="surface-card mt-6">
      <div class="px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900">Archiver</h2>
        <p class="mt-1 text-sm text-gray-500">
          N'apparaît plus pour de nouveaux achats, sans supprimer l'historique. Les adhésions déjà créées restent intactes.
        </p>
        <%= button_to "Archiver ce type", archive_admin_membership_type_path(@membership_type),
            method: :post,
            form: { data: { turbo_confirm: "Archiver #{@membership_type.name} ? Il ne sera plus proposé aux nouveaux achats." } },
            class: "mt-3 inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
      </div>
    </div>
  </div>
</div>
