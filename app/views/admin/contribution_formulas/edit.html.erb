<div class="min-h-screen bg-gray-50 py-6">
  <div class="page-container max-w-2xl">
    <!-- Header -->
    <div class="admin-page-header">
      <div class="px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Modifier la formule de cotisation</h1>
        <p class="text-green-100 mt-1"><%= @contribution_formula.name %></p>
      </div>
    </div>

    <!-- Formulaire -->
    <div class="surface-card">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Informations de la formule</h2>
      </div>

      <div class="p-6">
        <%= form_with model: [:admin, @contribution_formula], local: true, class: "space-y-6" do |form| %>
          <% if @contribution_formula.errors.any? %>
            <div class="bg-red-50 border border-red-200 rounded-md p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">Erreurs à corriger :</h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc list-inside space-y-1">
                      <% @contribution_formula.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div>
            <%= form.label :name, "Nom du plan de cotisation", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :name, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div>
            <%= form.label :duration, "Type de plan", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :duration, 
                options_for_select([
                  ['Journée', 'day'],
                  ['Trimestriel', 'trimester'],
                  ['Annuel', 'annual'],
                  ['Pack de séances', 'pack10']
                ], @contribution_formula.duration),
                {},
                { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" } %>
            <p class="mt-1 text-sm text-gray-500">
              <strong>Journée</strong> : Accès pour une journée<br>
              <strong>Trimestriel</strong> : Accès pour 3 mois<br>
              <strong>Annuel</strong> : Accès pour 1 an<br>
              <strong>Pack de séances</strong> : Nombre limité de séances
            </p>
          </div>

          <div>
            <%= form.label :membership_type_id, "Type d'adhésion requis", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :membership_type_id, 
                options_from_collection_for_select(MembershipType.circus_types, :id, :name, @contribution_formula.membership_type_id),
                {},
                { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" } %>
            <p class="mt-1 text-sm text-gray-500">Seuls les adhérents Cirque peuvent acheter des cotisations</p>
          </div>

          <div>
            <%= form.label :price_cents, "Prix (en centimes)", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :price_cents, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Entrez le prix en centimes (ex: 3000 = 30€)</p>
          </div>

          <div>
            <%= form.label :sessions_count, "Nombre de séances", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :sessions_count, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Laissez vide pour un accès illimité (journée, trimestre, annuel)</p>
          </div>

          <div>
            <%= form.label :validity_days, "Validité (en jours)", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :validity_days, 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Nombre de jours de validité du plan</p>
          </div>

          <div>
            <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_area :description, 
                rows: 3,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
          </div>

          <div class="flex justify-end space-x-3">
            <%= link_to "Annuler", admin_contribution_formula_path(@contribution_formula),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Mettre à jour",
                class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
