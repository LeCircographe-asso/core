<% content_for :title, "Nouvelle cotisation" %>

<div class="min-h-screen py-6">
  <div class="page-container max-w-4xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="surface-card mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Nouvelle cotisation</h1>
        <p class="text-white/80 mt-1">
          <% if @person %>
            Pour <%= @person.full_name %>
          <% else %>
            Sélectionnez une formule de cotisation
          <% end %>
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="surface-card">
      <div class="p-6">
        <% if @person&.can_buy_contribution_formulas? %>
          <!-- Formules disponibles -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
            <% @contribution_formulas.each do |formula| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <h3 class="text-lg font-medium text-gray-900"><%= formula.name %></h3>
                <p class="text-sm text-gray-600 mt-1"><%= formula.description %></p>
                
                <div class="mt-3">
                  <p class="text-2xl font-bold text-[#1F5C55]"><%= formula.price_euros %> €</p>
                  <% if formula.sessions_count %>
                    <p class="text-sm text-gray-500"><%= formula.sessions_count %> séances</p>
                  <% end %>
                  <% if formula.validity_days %>
                    <p class="text-sm text-gray-500">Valide <%= formula.validity_days %> jours</p>
                  <% end %>
                </div>
                
                <div class="mt-4">
                  <%= form_with url: admin_contribution_formulas_path, method: :post, local: true, scope: :contribution_formula, class: "space-y-3" do |form| %>
                    <%= form.hidden_field :contribution_formula_id, value: formula.id %>
                    <%= form.hidden_field :person_id, value: @person.id %>
                    
                    <div>
                      <%= form.label :payment_method, "Mode de paiement", class: "block text-sm font-medium text-gray-700 mb-1" %>
                      <%= form.select :payment_method, 
                          options_for_select(payment_method_options),
                          { selected: 'cash' },
                          { class: "w-full text-sm border-gray-300 rounded-md focus:border-[#1F5C55] focus:ring-[#1F5C55]" } %>
                    </div>
                    
                    <div id="custom-amount-<%= formula.id %>" class="hidden">
                      <%= form.label :custom_amount_cents, "Montant personnalisé (€)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                      <%= form.number_field :custom_amount_cents, 
                          step: 0.01, 
                          min: 0,
                          placeholder: "0.00",
                          class: "w-full text-sm border-gray-300 rounded-md focus:border-[#1F5C55] focus:ring-[#1F5C55]" %>
                    </div>

                    <div id="offer-reason-<%= formula.id %>" class="hidden">
                      <%= form.label :offer_reason, "Raison de l'offre", class: "block text-sm font-medium text-gray-700 mb-1" %>
                      <%= form.text_area :offer_reason,
                          rows: 2,
                          placeholder: "Ex: Bénévolat, geste commercial, partenariat...",
                          class: "w-full text-sm border-gray-300 rounded-md focus:border-[#1F5C55] focus:ring-[#1F5C55]" %>
                    </div>

                    <div>
                      <%= form.label :donation_amount, "Donation (€) (optionnel)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                      <%= form.number_field :donation_amount,
                          step: 0.01,
                          min: 0,
                          placeholder: "0.00",
                          class: "w-full text-sm border-gray-300 rounded-md focus:border-[#1F5C55] focus:ring-[#1F5C55]" %>
                    </div>
                    
                    <%= form.submit "Acheter la cotisation", 
                        class: "w-full inline-flex justify-center items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
            <p class="text-yellow-800 text-sm">Cette personne doit avoir une adhésion Cirque pour acheter une cotisation.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() 
    document.querySelectorAll('form[action*="/admin/contribution_formulas"]').forEach(function(form) {
      const select = form.querySelector('select[name="contribution_formula[payment_method]"]');
      if (!select) return;
      select.addEventListener('change', function() {
        const idInput = form.elements.namedItem('contribution_formula[contribution_formula_id]');
        const planId = idInput ? idInput.value : null;
        if (!planId) return;
        const customAmountDiv = document.getElementById('custom-amount-' + planId);
        const offerReasonDiv = document.getElementById('offer-reason-' + planId);
        const offerReasonField = offerReasonDiv ? offerReasonDiv.querySelector('textarea') : null;
        
        if (this.value === 'offered') {
          if (customAmountDiv) customAmountDiv.classList.remove('hidden');
          if (offerReasonDiv) {
            offerReasonDiv.classList.remove('hidden');
            if (offerReasonField) offerReasonField.required = true;
          }
        } else {
          if (customAmountDiv) customAmountDiv.classList.add('hidden');
          if (offerReasonDiv) {
            offerReasonDiv.classList.add('hidden');
            if (offerReasonField) offerReasonField.required = false;
          }
        }
      });
    });
  });
</script>
