<% content_for :title, t(".title") %>

<div class="min-h-screen py-4" data-controller="import-modal" data-import-modal-url-value="<%= admin_imports_path %>" data-import-modal-progress-url-value="<%= progress_admin_imports_path %>" data-import-modal-progress-template-value="<%= t(".modal.progress") %>">
  <div class="page-container">
    <%= render 'shared/breadcrumbs' %>

    <div class="admin-page-header mb-6">
      <div class="px-6 py-6">
        <h1 class="text-2xl font-bold text-white mb-1"><%= t(".title") %></h1>
        <p class="text-white/80 text-base"><%= t(".subtitle") %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Import Section -->
      <div class="surface-card">
        <div class="bg-gradient-to-r from-brand-primary to-brand-primary-dark px-4 py-3">
          <h2 class="text-base font-semibold text-white flex items-center">
            <i class="fas fa-upload mr-2"></i> <%= t(".import.title") %>
          </h2>
        </div>
        <div class="p-6">
          <p class="text-gray-600 text-sm mb-4">
            <%= t(".import.description") %>
          </p>

          <div class="mb-4">
            <h3 class="text-sm font-semibold text-gray-900 mb-2"><%= t(".import.columns_title") %></h3>
            <ul class="text-xs text-gray-600 space-y-1">
              <% t(".import.columns").each do |column| %>
                <li>• <%= column %></li>
              <% end %>
            </ul>
          </div>

          <button type="button" class="w-full bg-brand-primary hover:bg-brand-primary-dark text-white font-medium py-2 rounded-lg transition-colors cursor-pointer" data-action="click->import-modal#open">
            <i class="fas fa-upload mr-2"></i> <%= t(".import.button") %>
          </button>
        </div>
      </div>

      <!-- Export Section -->
      <div class="surface-card">
        <div class="bg-gradient-to-r from-brand-primary to-brand-primary-dark px-4 py-3">
          <h2 class="text-base font-semibold text-white flex items-center">
            <i class="fas fa-download mr-2"></i> <%= t(".export.title") %>
          </h2>
        </div>
        <div class="p-6">
          <p class="text-gray-600 text-sm mb-4">
            <%= t(".export.description") %>
          </p>

          <%= link_to admin_exports_path, class: "w-full inline-flex items-center justify-center bg-brand-primary hover:bg-brand-primary-dark text-white font-medium py-2 rounded-lg transition-colors" do %>
            <i class="fas fa-download mr-2"></i> <%= t(".export.button") %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Info Box -->
    <div class="mt-6 surface-card border-l-4 border-l-brand-primary">
      <div class="p-4">
        <h3 class="text-sm font-semibold text-gray-900 mb-2">
          <i class="fas fa-info-circle text-brand-primary mr-2"></i> <%= t(".notes.title") %>
        </h3>
        <ul class="text-xs text-gray-600 space-y-1">
          <% t(".notes.items").each do |note| %>
            <li>• <%= note %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Import Modal -->
  <div
    class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4"
    data-import-modal-target="modal"
    data-action="click->import-modal#handleBackdropClick"
  >
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[85vh] overflow-hidden flex flex-col">
      <!-- Header -->
      <div class="bg-gradient-to-r from-brand-primary to-brand-primary-dark px-6 py-4 flex items-center justify-between flex-shrink-0">
        <h2 class="text-lg font-bold text-white"><%= t(".modal.title") %></h2>
        <button type="button" class="text-white/80 hover:text-white" data-action="click->import-modal#close">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>

      <!-- Dropzone state -->
      <div data-import-modal-target="dropzone" class="p-8">
        <div
          class="border-2 border-dashed border-gray-300 rounded-lg p-12 text-center transition-colors cursor-pointer"
          data-action="dragover->import-modal#dragOver dragleave->import-modal#dragLeave drop->import-modal#drop click->import-modal#triggerFilePicker"
        >
          <i class="fas fa-file-csv text-4xl text-gray-400 mb-4"></i>
          <p class="text-gray-700 font-medium mb-1"><%= t(".modal.drop") %></p>
          <p class="text-gray-500 text-sm"><%= t(".modal.pick") %></p>
          <p class="text-gray-400 text-xs mt-3"><%= t(".modal.format") %></p>
        </div>
        <input type="file" accept=".csv,.txt" class="hidden" data-import-modal-target="fileInput" data-action="change->import-modal#onFileSelected">
      </div>

      <!-- Loading state -->
      <div data-import-modal-target="loading" class="hidden p-12 text-center">
        <i class="fas fa-circle-notch fa-spin text-4xl text-brand-primary mb-4"></i>
        <p class="text-gray-700 font-medium"><%= t(".modal.loading") %></p>
        <p class="text-gray-500 text-sm mt-1" data-import-modal-target="fileName"></p>
        <p class="text-brand-primary text-sm font-medium mt-3 tabular-nums" data-import-modal-target="progress" aria-live="polite"></p>
      </div>

      <!-- Result state -->
      <div data-import-modal-target="result" class="hidden flex-1 overflow-y-auto flex flex-col">
        <div data-import-modal-target="resultContent"></div>
      </div>
    </div>
  </div>
</div>
