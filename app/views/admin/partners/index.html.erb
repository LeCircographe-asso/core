<div class="min-h-screen bg-gray-50/40 py-6 px-4">
  <div class="max-w-3xl mx-auto space-y-5">
    <%= render 'shared/breadcrumbs' %>

    <div class="flex items-end justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Partenaires</h1>
        <p class="text-sm text-gray-400 mt-0.5">
          <%= Partner.count %> partenaire<%= "s" if Partner.count != 1 %> · glisser pour réordonner
        </p>
      </div>
      <%= link_to t("admin.partners.index.new"), new_admin_partner_path,
            data: { turbo_frame: "modal" },
            class: "btn-primary text-sm" %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
      <% if @partners.any? %>
        <%= render layout: "admin/shared/sortable_list", locals: { reorder_url: reorder_admin_partners_path } do %>
          <% @partners.each_with_index do |partner, i| %>
            <%= render "admin/shared/sortable_row", item: partner, index: i,
                edit_path: edit_admin_partner_path(partner),
                edit_text: t("admin.partners.index.edit"),
                delete_path: admin_partner_path(partner),
                confirm_delete_text: t("admin.partners.index.confirm_delete") do %>
              <div class="shrink-0 w-10 h-10 rounded-lg overflow-hidden bg-gray-100 flex items-center justify-center">
                <% if partner.logo.attached? %>
                  <%= image_tag partner.logo.variant(resize_to_limit: [ 80, 80 ]), class: "max-w-full max-h-full object-contain" %>
                <% else %>
                  <span class="text-xs font-semibold text-brand-primary"><%= partner.initials_label %></span>
                <% end %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 leading-snug"><%= partner.name %></p>
                <p class="text-xs text-gray-400 mt-0.5 line-clamp-1"><%= partner.category %></p>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="px-4 py-5 text-sm text-gray-400 italic text-center"><%= t("admin.partners.index.empty") %></p>
      <% end %>
    </div>

  </div>
</div>

<%= turbo_frame_tag "modal" %>
