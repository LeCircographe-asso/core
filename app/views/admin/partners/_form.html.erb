<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 overflow-y-auto py-8" id="partner-modal">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg mx-4 p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">
          <%= partner.persisted? ? t("admin.partners.form.edit_title") : t("admin.partners.form.new_title") %>
        </h2>
        <%= link_to "✕", admin_partners_path, data: { turbo_frame: "modal" }, class: "text-gray-400 hover:text-gray-600 text-xl" %>
      </div>

      <% if partner.errors.any? %>
        <div class="mb-4 text-sm text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2">
          <%= partner.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: [ :admin, partner ], data: { turbo_frame: "_top" }, class: "space-y-4" do |f| %>
        <% if partner.logo.attached? %>
          <div class="w-16 h-16 rounded-lg overflow-hidden bg-gray-100 flex items-center justify-center">
            <%= image_tag partner.logo.variant(resize_to_limit: [ 128, 128 ]), class: "max-w-full max-h-full object-contain" %>
          </div>
        <% end %>

        <div>
          <%= f.label :name, t("admin.partners.form.name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= f.label :category, t("admin.partners.form.category"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :category, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= f.label :bio, t("admin.partners.form.bio"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :bio, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= f.label :url, t("admin.partners.form.url"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.url_field :url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <%= f.label :initials, t("admin.partners.form.initials"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :initials, maxlength: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :logo, t("admin.partners.form.logo"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.file_field :logo, accept: "image/*", class: "block text-sm text-gray-700" %>
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <%= link_to t("admin.partners.form.cancel"), admin_partners_path,
                data: { turbo_frame: "modal" },
                class: "text-sm text-gray-600 hover:underline" %>
          <%= f.submit partner.persisted? ? t("admin.partners.form.save") : t("admin.partners.form.create"),
                class: "btn-primary text-sm" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
