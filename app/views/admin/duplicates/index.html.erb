<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Détection de doublons</h1>
    <p class="mt-2 text-gray-600">Identifiez et fusionnez les fiches membres en doublon</p>
  </div>

  <% if @duplicates.any? %>
    <div class="space-y-6">
      <% @duplicates.each do |duplicate| %>
        <div class="bg-white shadow rounded-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">
              <%= duplicate[:type] == :email ? "Email" : "Nom" %> : <%= duplicate[:value] %>
            </h3>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
              <%= duplicate[:count] %> doublons
            </span>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% duplicate[:people].each do |person| %>
              <div class="border rounded-lg p-4 hover:bg-gray-50">
                <div class="flex items-center justify-between mb-2">
                  <h4 class="font-medium text-gray-900"><%= person.full_name %></h4>
                  <span class="text-sm text-gray-500">ID: <%= person.id %></span>
                </div>
                
                <div class="text-sm text-gray-600 space-y-1">
                  <p><strong>Email:</strong> <%= person.email.present? ? person.email : "Non renseigné" %></p>
                  <p><strong>Téléphone:</strong> <%= person.phone.present? ? person.phone : "Non renseigné" %></p>
                  <p><strong>Adhésions:</strong> <%= person.memberships.count %></p>
                  <p><strong>Paiements:</strong> <%= person.payments.count %></p>
                  <p><strong>Compte web:</strong> <%= person.user.present? ? "✅" : "❌" %></p>
                </div>
                
                <div class="mt-3 flex space-x-2">
                  <%= link_to "Voir", admin_user_path("person_#{person.id}"), 
                              class: "text-sm text-blue-600 hover:text-blue-800" %>
                  <% if person != duplicate[:people].first %>
                    <%= link_to "Fusionner vers #{duplicate[:people].first.full_name}", 
                                admin_duplicate_merge_path(source_id: person.id, target_id: duplicate[:people].first.id),
                                method: :post,
                                class: "text-sm text-red-600 hover:text-red-800",
                                data: { 
                                  confirm: "Êtes-vous sûr de vouloir fusionner #{person.full_name} vers #{duplicate[:people].first.full_name} ? Cette action est irréversible." 
                                } %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="mx-auto h-12 w-12 text-green-500">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun doublon détecté</h3>
      <p class="mt-1 text-sm text-gray-500">Toutes les fiches membres sont uniques.</p>
    </div>
  <% end %>
</div>
