<% 
  authenticated?
  params[:creator_id] = current_user.id
%>

<div class="form-container bg-white shadow-lg rounded-lg overflow-hidden p-6 max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-[#1F5C55] mb-4">Modifier l'événement</h1>

  <%= form_with model: @event, url: event_path, method: "put" do |form| %>
    <div class="space-y-4">
      <!-- Champ Titre -->
      <div class="form-group">
        <%= form.text_field :title, required: true, value: @event.title, placeholder: "ex.: Concert Super Cool", maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Description Haute -->
      <div class="form-group">
        <%= form.text_area :upper_description, required: false, value: @event.upper_description, placeholder: "Description haute", maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Description Milieu -->
      <div class="form-group">
        <%= form.text_area :middle_description, required: true, value: @event.middle_description, placeholder: "Description milieu", maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Description Basse -->
      <div class="form-group">
        <%= form.text_area :bottom_description, required: false, value: @event.bottom_description, placeholder: "Description basse", maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Lieu -->
      <div class="form-group">
        <%= form.text_field :location, required: true, value: @event.location, placeholder: "ex.: Toulouse", maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Date -->
      <div class="form-group">
        <%= form.date_field :date, required: true, value: @event.date, maxlength: 72, class: "w-full p-3 border border-gray-300 rounded-md bg-gray-50 focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
      </div>

      <!-- Champ Hidden (Creator) -->
      <%= form.hidden_field :creator, value: current_user %>

      <!-- Bouton de soumission -->
      <div class="mt-6">
        <%= form.submit "Modifier l'événement", class: "inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
      </div>
    </div>
  <% end %>
</div>
