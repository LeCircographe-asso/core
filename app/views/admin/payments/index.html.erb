<% content_for :title, "Historique des paiements" %>

<div class="min-h-screen py-6" data-controller="admin-payments payment-modal">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header avec gradient -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-[#194A45] px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Historique des paiements</h1>
        <p class="text-white/80 mt-1">
          Gestion et suivi de tous les paiements de l'association
        </p>
      </div>

      <div class="p-6">
        <!-- Actions principales -->
        <div class="flex flex-wrap gap-3 mb-6">
          <%= render Ui::DisabledButtonComponent.new(
              text: "Nouveau paiement",
              disabled: true,
              disabled_reason: "Création de paiement temporairement désactivée"
            ) %>
          
          <%= link_to "Export CSV", admin_payments_path(format: :csv), 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#5836a5] hover:bg-[#4c2d8a] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#5836a5]" %>
        </div>
        
        <!-- Modal pour création -->
        <div data-payment-modal-target="container"
             class="hidden fixed inset-0 z-50 overflow-y-auto"
             aria-labelledby="modal-title"
             role="dialog"
             aria-modal="true">
          <%= render "modal" %>
        </div>

        <!-- Barre de recherche et filtres -->
        <div class="filter-section bg-gray-50 rounded-lg p-4 mb-6">
          <%= form_with url: admin_payments_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
            <!-- Recherche -->
            <div class="flex-1">
              <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Recherche</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <%= form.text_field :search, 
                    id: "search",
                    value: params[:search],
                    placeholder: "Nom, email, montant... (Ctrl+K pour focus)",
                    class: "search-input pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
                <% if params[:search].present? %>
                  <button type="button" 
                          data-action="click->admin-payments#clearSearch"
                          class="absolute inset-y-0 right-0 pr-3 flex items-center">
                    <svg class="h-4 w-4 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                <% end %>
              </div>
            </div>
            
            <!-- Filtres -->
            <div class="md:w-48">
              <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
              <%= form.select :status, 
                  options_for_select([
                    ['Tous', ''],
                    ['Succès', 'success'],
                    ['En attente', 'pending'],
                    ['Annulé', 'cancel']
                  ], params[:status]),
                  {},
                  { 
                    class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm",
                    onchange: "this.form.submit()"
                  } %>
            </div>

            <div class="md:w-48">
              <label for="start_date" class="block text-sm font-medium text-gray-700 mb-1">Date début</label>
              <%= form.date_field :start_date, 
                  value: params[:start_date], 
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>

            <div class="md:w-48">
              <label for="end_date" class="block text-sm font-medium text-gray-700 mb-1">Date fin</label>
              <%= form.date_field :end_date, 
                  value: params[:end_date], 
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#1F5C55] focus:ring-[#1F5C55] sm:text-sm" %>
            </div>
            
            <!-- Bouton de recherche -->
            <div class="flex items-end">
              <%= form.submit "Filtrer", class: "px-4 py-2 bg-[#1F5C55] text-white rounded-md hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-[#1F5C55]" %>
            </div>
          <% end %>
        </div>

        <!-- Résumé des paiements (#payment-summary est défini dans le partial pour les mises à jour Turbo) -->
        <%= render "payment_summary",
                   payments: @payments_for_summary,
                   total_amount: @total_amount,
                   total_donation: @total_donation %>

        <!-- Tableau des paiements -->
        <div class="bg-white shadow overflow-hidden rounded-lg">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Personne</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Méthode</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Détails</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Enregistré par</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody id="payments" class="bg-white divide-y divide-gray-200">
                <% if @payments.any? %>
                  <% @payments.each do |payment| %>
                    <%= render "payment_row", payment: payment, list_filter_params: @filter_params.to_unsafe_h %>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="8" class="px-6 py-10 text-center text-gray-500">
                      <div class="empty-state flex flex-col items-center">
                        <svg class="h-12 w-12 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                        <p class="text-lg font-medium">Aucun paiement trouvé</p>
                        <p class="text-sm">
                          <% if params[:search].present? || params[:status].present? || params[:start_date].present? %>
                            Essayez de modifier votre recherche ou vos filtres.
                          <% else %>
                            Commencez par créer votre premier paiement.
                          <% end %>
                        </p>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Pagination -->
        <% if @pagy.pages > 1 %>
          <div class="mt-6 flex justify-center">
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6 rounded-lg shadow">
              <div class="flex-1 flex justify-between sm:hidden">
                <% if @pagy.prev %>
                  <%= link_to "Précédent", admin_payments_path(page: @pagy.prev, search: params[:search], status: params[:status], start_date: params[:start_date], end_date: params[:end_date]), 
                      class: "relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                <% end %>
                <% if @pagy.next %>
                  <%= link_to "Suivant", admin_payments_path(page: @pagy.next, search: params[:search], status: params[:status], start_date: params[:start_date], end_date: params[:end_date]), 
                      class: "ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                <% end %>
              </div>
              
              <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div class="flex items-center space-x-4">
                  <p class="text-sm text-gray-700">
                    Affichage de 
                    <span class="font-medium"><%= @pagy.from %></span>
                    à 
                    <span class="font-medium"><%= @pagy.to %></span>
                    sur 
                    <span class="font-medium"><%= @pagy.count %></span>
                    résultats
                  </p>
                  
                  <!-- Sélecteur d'éléments par page -->
                  <div class="flex items-center space-x-2">
                    <label for="items-per-page" class="text-sm text-gray-700">Par page:</label>
                    <select id="items-per-page" 
                            data-action="change->admin-payments#changeItemsPerPage"
                            class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:ring-[#1F5C55] focus:border-[#1F5C55]">
                      <option value="10" <%= 'selected' if params[:items] == '10' %>>10</option>
                      <option value="15" <%= 'selected' if params[:items] == '15' || params[:items].blank? %>>15</option>
                      <option value="25" <%= 'selected' if params[:items] == '25' %>>25</option>
                      <option value="50" <%= 'selected' if params[:items] == '50' %>>50</option>
                    </select>
                  </div>
                </div>
                <div>
                  <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <% if @pagy.prev %>
                      <%= link_to admin_payments_path(page: @pagy.prev, search: params[:search], status: params[:status], start_date: params[:start_date], end_date: params[:end_date]), 
                          class: "relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" do %>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <% @pagy.series.each do |item| %>
                      <% if item.is_a?(Integer) %>
                        <%= link_to item, admin_payments_path(page: item, search: params[:search], status: params[:status], start_date: params[:start_date], end_date: params[:end_date]), 
                            class: "relative inline-flex items-center px-4 py-2 border text-sm font-medium #{item == @pagy.page ? 'z-10 bg-[#1F5C55] border-[#1F5C55] text-white' : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-50'}" %>
                      <% elsif item == :gap %>
                        <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                          ...
                        </span>
                      <% end %>
                    <% end %>
                    
                    <% if @pagy.next %>
                      <%= link_to admin_payments_path(page: @pagy.next, search: params[:search], status: params[:status], start_date: params[:start_date], end_date: params[:end_date]), 
                          class: "relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" do %>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      <% end %>
                    <% end %>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>