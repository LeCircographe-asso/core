<%
  payments = local_assigns[:payments] || []

  total_count = payments.count
  successful_count = payments.where(status: :success).count
  pending_count = payments.where(status: :pending).count
  canceled_count = payments.where(status: :cancel).count

  successful_scope = payments.where(status: :success)
  payments_total = successful_scope.sum(:total_cents) / 100.0
  donations_total = PaymentLine
    .where(payment_id: successful_scope.select(:id), item_type: "Donation")
    .sum(:amount_cents) / 100.0
%>

<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
  <div class="bg-white p-4 rounded-lg shadow border">
    <div class="text-sm text-gray-500">Total Paiements</div>
    <div class="text-2xl font-bold text-gray-900"><%= total_count %></div>
  </div>
  
  <div class="bg-white p-4 rounded-lg shadow border">
    <div class="text-sm text-gray-500">Paiements Réussis</div>
    <div class="text-2xl font-bold text-green-600"><%= successful_count %></div>
  </div>
  
  <div class="bg-white p-4 rounded-lg shadow border">
    <div class="text-sm text-gray-500">Paiements En Attente</div>
    <div class="text-2xl font-bold text-yellow-600"><%= pending_count %></div>
  </div>
  
  <div class="bg-white p-4 rounded-lg shadow border">
    <div class="text-sm text-gray-500">Montant Total</div>
    <div class="text-2xl font-bold text-gray-900">
      <%= number_to_currency(payments_total, unit: "€", format: "%n %u") %>
    </div>
  </div>
  
  <div class="bg-white p-4 rounded-lg shadow border">
    <div class="text-sm text-gray-500">Total Donations</div>
    <div class="text-2xl font-bold text-purple-600">
      <%= number_to_currency(donations_total, unit: "€", format: "%n %u") %>
    </div>
  </div>
</div> 