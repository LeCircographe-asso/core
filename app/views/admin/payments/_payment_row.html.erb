<tr id="payment_row_<%= payment.id %>" class="table-row hover:bg-gray-50" data-admin-payments-target="tableRow">
  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
    <%= payment_date_display(payment) %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
    <%= payment_person_display(payment) %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap text-sm">
    <%= payment_status_display(payment) %>
  </td>

  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
    <%= payment_method_display(payment) %>
  </td>

  <td class="px-6 py-4 text-sm text-gray-500">
    <%= payment_lines_display(payment) %>
  </td>

  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
    <%= payment_amount_display(payment) %>
  </td>

  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
    <%= payment_recorded_by_display(payment) %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
    <%= render "payment_actions",
               payment: payment,
               list_filter_params: local_assigns.fetch(:list_filter_params, {}) %>
  </td>
</tr>
