<% content_for :title, "Adhésions & Cotisations" %>

<div class="min-h-screen py-12">
  <div class="page-container max-w-3xl">
    <!-- Header -->
    <div class="mb-12">
      <%= link_to admin_dashboard_index_path, class: "text-sm text-gray-600 hover:text-gray-900 mb-6 inline-flex items-center" do %>
        <i class="fas fa-arrow-left mr-2"></i> Retour au dashboard
      <% end %>

      <h1 class="text-3xl font-bold text-gray-900 mb-2">Adhésions & Cotisations</h1>
      <p class="text-gray-600">Sélectionnez le type de configuration à modifier</p>
    </div>

    <!-- Selection Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Types d'adhésion -->
      <div class="group">
        <%= link_to admin_membership_types_path, class: "block h-full" do %>
          <div class="surface-card h-full p-8 hover:shadow-lg transition-all duration-300 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1F5C55] to-[#194A45] rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <i class="fas fa-id-card text-white text-2xl"></i>
            </div>
            <h2 class="text-xl font-semibold text-gray-900 mb-3">Types d'adhésion</h2>
            <p class="text-gray-600 mb-6">Configurer les adhésions (basique, cirque complète, réduite)</p>
            <span class="inline-flex items-center px-4 py-2 rounded-lg bg-[#1F5C55]/10 text-[#1F5C55] text-sm font-medium group-hover:bg-[#1F5C55] group-hover:text-white transition-colors">
              Gérer les types <i class="fas fa-arrow-right ml-2"></i>
            </span>
          </div>
        <% end %>
      </div>

      <!-- Formules de cotisation -->
      <div class="group">
        <%= link_to admin_contribution_formulas_path, class: "block h-full" do %>
          <div class="surface-card h-full p-8 hover:shadow-lg transition-all duration-300 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1F5C55] to-[#194A45] rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <i class="fas fa-ticket-alt text-white text-2xl"></i>
            </div>
            <h2 class="text-xl font-semibold text-gray-900 mb-3">Formules de cotisation</h2>
            <p class="text-gray-600 mb-6">Configurer les cotisations (jour, trimestre, annuel, carnet)</p>
            <span class="inline-flex items-center px-4 py-2 rounded-lg bg-[#1F5C55]/10 text-[#1F5C55] text-sm font-medium group-hover:bg-[#1F5C55] group-hover:text-white transition-colors">
              Gérer les formules <i class="fas fa-arrow-right ml-2"></i>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
