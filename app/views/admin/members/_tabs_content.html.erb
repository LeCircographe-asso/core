<div class="<%= wrapper_class %>">
  <div class="tab-content" id="personal-tab" data-tabs-target="panel" data-tabs-name-value="personal">
    <%= render Admin::Members::MemberInfoComponent.new(
      user: user,
      person: person,
      is_person_without_user: is_person_without_user
    ) %>
  </div>

  <div class="tab-content hidden" id="membership-tab" data-tabs-target="panel" data-tabs-name-value="membership">
    <%= render Admin::Members::MembershipDisplayComponent.new(person: person) %>
  </div>

  <div class="tab-content hidden" id="payments-tab" data-tabs-target="panel" data-tabs-name-value="payments">
    <%= render "payments_tab", recent_payments: recent_payments, person: person %>
  </div>
</div>
