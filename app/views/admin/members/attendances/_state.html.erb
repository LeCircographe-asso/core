<% btn_class = "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>

<div class="bg-white rounded-lg border border-gray-200 p-4">
  <% if already_present_today %>
    <p class="text-sm text-gray-600">
      <i class="fas fa-check-circle text-green-600 mr-1"></i>
      <%= t("admin.members.attendances.already_present", name: person.first_name) %>
    </p>

  <% elsif needs_membership %>
    <p class="text-sm text-gray-600"><%= t("admin.members.attendances.needs_membership") %></p>

  <% elsif usable_contribution %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <h4 class="text-md font-medium text-green-900 mb-2">
        <i class="fas fa-check-circle mr-2"></i><%= t("admin.members.attendances.confirm_title") %>
      </h4>
      <p class="text-sm text-gray-700 mb-3">
        <%= usable_contribution.contribution_formula.name %>
        <% if usable_contribution.has_session_limit? %>
          — <%= pluralize(usable_contribution.sessions_remaining, "séance restante") %>
        <% end %>
      </p>
      <%= button_to t("admin.members.attendances.confirm_button"),
            admin_member_attendances_path(person),
            method: :post,
            data: { turbo_stream: true },
            class: "#{btn_class} bg-green-600 hover:bg-green-700 focus:ring-green-500" %>
    </div>

  <% else %>
    <div class="space-y-4">
      <p class="text-sm text-gray-700"><%= t("admin.members.attendances.no_usable_contribution") %></p>

      <%= link_to t("admin.members.attendances.buy_and_record"),
            new_admin_contribution_path(person_id: person.id),
            class: btn_class,
            data: { turbo_frame: "_top" } %>

      <div class="border-t border-gray-200 pt-4">
        <p class="text-sm font-medium text-gray-700 mb-2"><%= t("admin.members.attendances.lend_prompt") %></p>

        <%= form_with url: new_admin_member_attendance_path(person), method: :get, class: "flex gap-2" do |form| %>
          <%= form.text_field :q, value: lender_query,
                placeholder: t("admin.members.attendances.search_placeholder"),
                class: "flex-1 border-gray-300 rounded-md shadow-sm text-sm focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
          <%= form.submit t("admin.members.attendances.search_submit"),
                class: "px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <% end %>

        <% if lender_query.present? %>
          <ul class="mt-3 divide-y divide-gray-100">
            <% if lenders.empty? %>
              <li class="text-sm text-gray-500 py-2"><%= t("admin.members.attendances.no_lenders_found") %></li>
            <% else %>
              <% lenders.each do |candidate, contribution| %>
                <li class="flex items-center justify-between py-2">
                  <span class="text-sm text-gray-800">
                    <%= candidate.full_name %> — <%= pluralize(contribution.sessions_remaining, "séance restante") %>
                  </span>
                  <%= button_to t("admin.members.attendances.use_lender_button"),
                        admin_member_attendances_path(person),
                        method: :post,
                        params: { contribution_id: contribution.id },
                        data: { turbo_stream: true },
                        class: "px-3 py-1.5 border border-transparent rounded-md shadow-sm text-xs font-medium text-white bg-blue-600 hover:bg-blue-700" %>
                </li>
              <% end %>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
