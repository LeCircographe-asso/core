
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%;">
  <h1>Liste des Cotisations</h1>
  <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; align-items: center; width: 100%;">
    <table style="width: 80%; margin: 0 auto; border-collapse: collapse; text-align: left;">
      <thead>
        <tr>
          <th>Cotisations</th>
          <th>Prix</th>
          <th>Cotiser</th>
        </tr>
      </thead>
      <tbody>
        <% @product_subscription.each do |product| %>
          <tr>
            <td><%= product.product_name %></td>
            <td>
              <% if product.price_entries.any? %>
                <% latest_price = product.price_entries.order(created_at: :desc).first %>
                <%= latest_price.price_catalog.price %> €
              <% else %>
                Non défini
              <% end %>
            </td>
            <td>
              <%= button_to 'Ajouter', admin_product_orders_path, params: { product_order: { order_id: @order, product_id: product, user_id: @user } }, method: :post, class: "purple-button", data: { turbo_stream: true } %>
            </td>
            <td>
              <%# <%= button_to 'Supprimer', admin_user_order_product_order_path(order_id: @order.id, product_order_id: @product_order), method: :delete, data: { turbo_stream: true }, class: "delete-button" %> %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
</div>
</div>