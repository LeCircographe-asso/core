<aside class="admin-sidebar">
  <div class="sidebar-logo p-4">
    <%= link_to admin_dashboard_index_path do %>
      <%= image_tag "circo-admin.webp", class: "image-main" %>
    <% end %>
  </div>

  <div class="px-4 py-2">
    <div class="text-sm font-medium text-gray-600 mb-1">
      Administration
    </div>
    <ul class="sidebar-menu">
      <li><%= link_to admin_dashboard_index_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-home mr-2"></i> Accueil
          <% end %>
      </li>
      <li><%= link_to admin_users_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-users mr-2"></i> Liste d'adhérents
          <% end %>
      </li>
      <li><%= link_to admin_events_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-calendar-alt mr-2"></i> Événements
          <% end %>
      </li>
      <li><%= link_to edit_admin_opening_hours_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-clock mr-2"></i> Modifier les horaires
          <% end %>
      </li>
      <li><%= link_to new_admin_user_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-user-plus mr-2"></i> Créer un Adhérent
          <% end %>
      </li>
      <li><%= link_to edit_admin_notepad_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-sticky-note mr-2"></i> Bloc notes
          <% end %>
      </li>
      <li><%= link_to admin_attendance_lists_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-clipboard-list mr-2"></i> Liste de présence
          <% end %>
      </li>
      <li><%= link_to admin_exports_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-file-export mr-2"></i> Export
          <% end %>
      </li>
      <li><%= link_to new_admin_blog_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-file-export mr-2"></i> Nouveau blog
          <% end %>
      </li>
    </ul>
  </div>

  <div class="border-t border-gray-200 mt-2 pt-2 px-4">
    <div class="text-sm font-medium text-gray-600 mb-1">
      Navigation
    </div>
    <ul class="sidebar-menu">
      <li><%= link_to root_path, class: "sidebar-link flex items-center" do %>
            <i class="fas fa-arrow-left mr-2"></i> Retour au site
          <% end %>
      </li>
      <li><%= link_to user_path(current_user), class: "sidebar-link flex items-center" do %>
            <i class="fas fa-user mr-2"></i> Votre Profil
          <% end %>
      </li>
      <li><%= button_to admin_session_path, method: :delete, class: "sidebar-link w-full text-left flex items-center" do %>
            <i class="fas fa-sign-out-alt mr-2"></i> Se déconnecter
          <% end %>
      </li>
    </ul>
  </div>
</aside>