<aside class="admin-sidebar" id="admin-sidebar" data-sidebar-target="sidebar">
    <!-- Bouton retour au site en haut -->
    <div class="px-4 py-1 border-b border-gray-200">
      <button type="button" id="sidebar-toggle" class="sidebar-link flex items-center mb-1 w-full" data-action="click->sidebar#toggle">
        <i class="fas fa-bars mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Menu</span>
      </button>
      <%= link_to root_path, class: "sidebar-link flex items-center w-full bg-[#1F5C55]/10 hover:bg-[#1F5C55]/20 text-[#1F5C55] rounded p-2" do %>
        <i class="fas fa-door-open mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Voir le site</span>
      <% end %>
    </div>
    <div class="sidebar-logo">
      <%= link_to admin_dashboard_index_path do %>
        <%= image_tag "circo-admin.webp", class: "image-main" %>
      <% end %>
    </div>
    
    
    <!-- GESTION -->
    <div class="px-4 py-2 sidebar-section">
      <div class="text-sm font-medium text-gray-600 mb-1 sidebar-text">Gestion</div>
      <ul class="sidebar-menu">
        <% if current_user.can_manage_users? %>
        <li><%= link_to admin_members_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-users mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Liste d'adhérents</span>
            <% end %>
        </li>
        <% end %>
        <% if current_user.can_manage_payments? %>
        <li><%= link_to admin_payments_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-money-bill-wave mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Paiements</span>
            <% end %>
        </li>
        <% end %>
        <% if current_user.can_manage_attendance_lists? %>
        <li><%= link_to admin_attendance_lists_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-clipboard-list mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Registre de présence</span>
            <% end %>
        </li>
        <% end %>
        <!-- Adhésions & Cotisations (hub link) -->
        <% if current_user.can_administer? %>
        <li><%= link_to admin_hubs_memberships_path, class: "sidebar-link flex items-center justify-between" do %>
              <span class="flex items-center flex-1">
                <i class="fas fa-id-card mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Adhésions & Cotisations</span>
              </span>
              <i class="fas fa-chevron-right text-xs ml-auto flex-shrink-0 sidebar-icon hidden-chevron"></i>
            <% end %>
        </li>
        <% end %>
        <% if current_user.can_administer? %>
        <li><%= link_to admin_duplicates_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-clone mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Doublons</span>
            <% end %>
        </li>
        <% end %>
      </ul>
    </div>

    <!-- ÉVÉNEMENTS & ACTUALITÉS -->
    <div class="px-4 py-2 sidebar-section">
      <div class="text-sm font-medium text-gray-600 mb-1 sidebar-text">Événements & Actualités</div>
      <ul class="sidebar-menu">
        <% if current_user.can_manage_events? %>
        <li><%= link_to admin_events_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-calendar-alt mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Événements</span>
            <% end %>
        </li>
        <% end %>
        <% if current_user.can_manage_blogs? %>
        <li><%= link_to admin_blogs_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-blog mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Blog / Actualités</span>
            <% end %>
        </li>
        <% end %>
      </ul>
    </div>

    <!-- CONTENU PUBLIC -->
    <div class="px-4 py-2 sidebar-section">
      <div class="text-sm font-medium text-gray-600 mb-1 sidebar-text">Contenu Public</div>
      <ul class="sidebar-menu">
        <% if current_user.can_manage_gallery? %>
        <li><%= link_to admin_gallery_photos_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-images mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Galerie photos</span>
            <% end %>
        </li>
        <% end %>
        <!-- Pages statiques (hub link) -->
        <% if current_user.can_manage_board_members? || current_user.can_manage_partners? || current_user.can_manage_opening_hours? %>
        <li><%= link_to admin_hubs_pages_path, class: "sidebar-link flex items-center justify-between" do %>
              <span class="flex items-center flex-1">
                <i class="fas fa-file-alt mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Pages statiques</span>
              </span>
              <i class="fas fa-chevron-right text-xs ml-auto flex-shrink-0 sidebar-icon hidden-chevron"></i>
            <% end %>
        </li>
        <% end %>
      </ul>
    </div>

    <!-- OUTILS -->
    <div class="px-4 py-2 sidebar-section">
      <div class="text-sm font-medium text-gray-600 mb-1 sidebar-text">Outils</div>
      <ul class="sidebar-menu">
        <% if current_user.can_manage_notepad? %>
        <li><%= link_to edit_admin_notepad_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-sticky-note mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Bloc notes</span>
            <% end %>
        </li>
        <% end %>
        <!-- Import/Export -->
        <% if current_user.can_administer? %>
        <li><%= link_to admin_imports_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-exchange-alt mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Import/Export</span>
            <% end %>
        </li>
        <li><%= link_to admin_bug_reports_path, class: "sidebar-link flex items-center" do %>
              <i class="fas fa-bug mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Rapports de bug</span>
            <% end %>
        </li>
        <% end %>
      </ul>
    </div>

    <div class="border-t border-gray-200 mt-2 pt-2 px-4 sidebar-section">
      <div class="text-sm font-medium text-gray-600 mb-1 sidebar-text">
        Navigation
      </div>
      <ul class="sidebar-menu">
        <li><%= link_to user_path(current_user), class: "sidebar-link flex items-center" do %>
              <i class="fas fa-user mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Votre Profil</span>
            <% end %>
        </li>
        <li><%= button_to admin_session_path, method: :delete, class: "sidebar-link w-full text-left flex items-center cursor-pointer" do %>
              <i class="fas fa-sign-out-alt mr-2 sidebar-icon"></i> <span class="sidebar-text" data-sidebar-target="text">Se déconnecter</span>
            <% end %>
        </li>
      </ul>
    </div>
  </aside>
