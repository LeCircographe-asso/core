<% content_for :title, t("admin.bug_reports.title") %>

<div class="min-h-screen py-6">
  <div class="page-container">
    <%= render 'shared/breadcrumbs' %>

    <div class="admin-page-header">
      <div class="px-6 py-4">
        <h1 class="text-2xl font-bold text-white"><%= t("admin.bug_reports.title") %></h1>
        <p class="text-white/80 mt-1"><%= t("admin.bug_reports.subtitle") %></p>
      </div>
    </div>

    <% if current_user.super_admin? %>
      <div class="admin-metric-card mb-6 p-6">
        <%= form_with url: admin_bug_report_widget_setting_path, method: :patch, class: "flex flex-wrap items-center gap-4" do %>
          <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700">
            <%= check_box_tag :enabled, "1", @widget_setting.enabled? %>
            <%= t("admin.bug_reports.widget_toggle.label") %>
          </label>
          <%= submit_tag t("admin.bug_reports.widget_toggle.submit"), class: "px-3 py-1.5 text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#194A45] rounded-md cursor-pointer" %>
          <span class="text-xs text-gray-500"><%= t("admin.bug_reports.widget_toggle.hint") %></span>
        <% end %>
      </div>
    <% end %>

    <div class="admin-metric-card p-6">
      <div class="flex flex-wrap gap-2 mb-4">
        <%= link_to t("admin.bug_reports.filters.all"), admin_bug_reports_path,
            class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-[#1F5C55] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
        <% BugReport.statuses.each_key do |status| %>
          <%= link_to t("admin.bug_reports.statuses.#{status}"), admin_bug_reports_path(status: status, source: params[:source]),
              class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == status ? 'bg-[#1F5C55] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-2 mb-4">
        <% BugReport.sources.each_key do |source| %>
          <%= link_to t("admin.bug_reports.sources.#{source}"), admin_bug_reports_path(status: params[:status], source: params[:source] == source ? nil : source),
              class: "px-3 py-1.5 rounded-full text-xs font-medium border #{params[:source] == source ? 'border-orange-400 bg-orange-50 text-orange-700' : 'border-gray-200 text-gray-500 hover:bg-gray-50'}" %>
        <% end %>
      </div>

      <% if @bug_reports.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead>
              <tr class="text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.date") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.author") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.device") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.note") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.page") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.screenshot") %></th>
                <th class="py-2 pr-4"><%= t("admin.bug_reports.table.status") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @bug_reports.each do |bug_report| %>
                <tr>
                  <td class="py-2 pr-4 whitespace-nowrap text-gray-600">
                    <%= l(bug_report.created_at.to_date, format: :short) %>
                    <% if bug_report.automatic? %>
                      <span class="ml-1 inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-medium text-orange-700"><%= t("admin.bug_reports.sources.automatic") %></span>
                      <% if bug_report.occurrence_count > 1 %>
                        <span class="ml-1 text-[11px] text-gray-400">×<%= bug_report.occurrence_count %></span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap">
                    <% if bug_report.person %>
                      <%= link_to bug_report.person.full_name, admin_member_path(bug_report.person), class: "text-[#1F5C55] hover:underline" %>
                    <% else %>
                      <span class="text-gray-400"><%= t("admin.bug_reports.table.anonymous") %></span>
                    <% end %>
                    <% if bug_report.reporter_role.present? %>
                      <span class="ml-1 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600">
                        <%= t("admin.bug_reports.roles.#{bug_report.reporter_role}") %>
                      </span>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap text-gray-600">
                    <% if bug_report.device_type.present? %>
                      <span class="inline-flex items-center gap-1">
                        <i class="fas <%= bug_report.device_type == "mobile" ? "fa-mobile-screen-button" : "fa-desktop" %>" aria-hidden="true"></i>
                        <%= t("admin.bug_reports.device_types.#{bug_report.device_type}") %>
                      </span>
                      <% if bug_report.display_mode.present? %>
                        <span class="text-gray-400">· <%= t("admin.bug_reports.display_modes.#{bug_report.display_mode}") %></span>
                      <% end %>
                      <% if bug_report.viewport_width.present? %>
                        <div class="text-[11px] text-gray-400"><%= bug_report.viewport_width %>×<%= bug_report.viewport_height %></div>
                      <% end %>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4 max-w-sm">
                    <p class="line-clamp-2 text-gray-800"><%= bug_report.note %></p>
                    <% if bug_report.js_errors.present? %>
                      <details class="mt-1">
                        <summary class="cursor-pointer text-xs font-medium text-amber-700"><%= t("admin.bug_reports.table.js_errors_toggle", count: bug_report.js_errors.size) %></summary>
                        <ul class="mt-1 space-y-1 rounded-lg bg-amber-50 p-2 text-[11px] text-amber-900">
                          <% bug_report.js_errors.each do |err| %>
                            <li class="break-words">
                              <span class="font-mono text-amber-700">[<%= err["type"] %>]</span>
                              <%= err["message"] %>
                              <% if err["source"].present? %>— <%= err["source"] %><%= ":#{err['line']}" if err["line"].present? %><% end %>
                              <% if err["count"].to_i > 1 %><span class="text-amber-600">(×<%= err["count"] %>)</span><% end %>
                              <% if err["stack"].present? %>
                                <pre class="mt-1 max-h-40 overflow-y-auto rounded bg-white/60 p-1.5 text-[10px] leading-snug text-amber-800"><%= err["stack"] %></pre>
                              <% end %>
                            </li>
                          <% end %>
                        </ul>
                      </details>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4 max-w-xs truncate text-gray-500"><%= bug_report.page_url %></td>
                  <td class="py-2 pr-4">
                    <% if bug_report.screenshot.attached? %>
                      <%= link_to t("admin.bug_reports.table.view_screenshot"), rails_blob_path(bug_report.screenshot, disposition: "attachment"), class: "text-[#1F5C55] hover:underline", target: "_blank", rel: "noopener" %>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4">
                    <%= form_with url: admin_bug_report_path(bug_report, filter_status: params[:status], filter_source: params[:source]), method: :patch do |f| %>
                      <%= f.select :status, BugReport.statuses.keys.map { |s| [ t("admin.bug_reports.statuses.#{s}"), s ] },
                          { selected: bug_report.status },
                          { onchange: "this.form.requestSubmit()", class: "text-sm border border-gray-200 rounded-md px-2 py-1" } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-4">
          <%== pagy_nav(@pagy) %>
        </div>
      <% else %>
        <p class="text-sm text-gray-600"><%= t("admin.bug_reports.empty") %></p>
      <% end %>
    </div>
  </div>
</div>
