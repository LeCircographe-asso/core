<div class="min-h-screen py-2">
  <div class="page-container max-w-5xl">
    <!-- Breadcrumbs -->
    <%= render 'shared/breadcrumbs' %>
    
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#1F5C55] to-teal-600 rounded-lg shadow-lg mb-3">
      <div class="px-4 py-3">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
          <div>
            <h1 class="text-lg font-bold text-white">Horaires d'ouverture</h1>
            <p class="text-white/80 text-xs">Ces horaires sont affichés sur le site public</p>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-white/20 text-white mt-1">
              <i class="fas fa-calendar-week mr-1"></i>
              Semaine du <%= Date.current.beginning_of_week.strftime("%d/%m") %> au <%= Date.current.end_of_week.strftime("%d/%m/%Y") %>
            </span>
          </div>
          <div>
            <%= link_to edit_admin_opening_hours_path, class: "inline-flex items-center px-3 py-1.5 border border-white/30 text-sm font-medium rounded-md text-white hover:bg-white/10 focus:outline-none" do %>
              <i class="fas fa-edit mr-1.5"></i> Modifier
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Opening hours display -->
    <div class="surface-card">
      <%= render 'shared/opening_hours', schedule: @opening_hours, closure: @exceptional_closure %>
    </div>
  </div>
</div>
