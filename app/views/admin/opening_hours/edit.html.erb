<% content_for :title, "Modification des horaires d'ouverture" %>

<div class="min-h-screen py-3">
  <div class="max-w-6xl mx-auto px-4">
    <!-- En-tête -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-4 ">
      <div class="bg-gradient-to-r from-[#1F5C55] to-teal-600 px-6 py-2.5">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div>
            <h1 class="text-xl font-bold text-white">Modifier les horaires d'ouverture</h1>
            <p class="text-white/80 text-sm">Ces horaires seront affichés sur le site public</p>
          </div>
          <div class="text-white text-sm bg-white/20 px-3 py-1.5 rounded-lg">
            <div class="flex items-center">
              <i class="fas fa-info-circle mr-2"></i>
              <span>Format: <span class="font-mono bg-white/20 px-1 rounded">HH:MM - HH:MM</span> ou <span class="font-mono bg-white/20 px-1 rounded">Fermé</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenu principal en deux colonnes -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- Colonne de gauche - Formulaire -->
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="px-4 py-2 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-base font-medium text-gray-900">Formulaire de modification</h2>
          <div class="flex gap-2">
            <%= link_to admin_dashboard_index_path, class: "text-gray-500 hover:text-gray-700" do %>
              <i class="fas fa-arrow-left"></i> Retour
            <% end %>
          </div>
        </div>
        
        <div class="p-3">
          <!-- Formulaire -->
          <%= form_with url: admin_opening_hours_path, method: :patch, id: "opening-hours-form" do |form| %>
            <div class="overflow-hidden rounded-lg border border-gray-200">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/3">Jour</th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-2/3">Horaires</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 text-sm">
                  <% @opening_hours.each do |day, hours| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-3 py-2 whitespace-nowrap">
                        <div class="flex items-center">
                          <% icon_class = case day 
                             when "lundi", "mardi", "mercredi", "jeudi", "vendredi" then "fas fa-briefcase"
                             when "samedi", "dimanche" then "fas fa-umbrella-beach"
                             end %>
                          <i class="<%= icon_class %> text-gray-500 mr-2 text-xs"></i>
                          <span class="font-medium text-gray-700"><%= day.capitalize %></span>
                        </div>
                      </td>
                      <td class="px-3 py-2 whitespace-nowrap">
                        <div class="relative">
                          <%= text_field_tag "opening_hours[#{day}]", hours, 
                              class: "text-sm block w-full px-2 py-1.5 text-gray-700 placeholder-gray-400 bg-white border border-gray-300 rounded-md focus:border-[#1F5C55] focus:ring-1 focus:ring-[#1F5C55] focus:outline-none time-input", 
                              placeholder: "ex: 14:00 - 22:00 ou Fermé",
                              data: { day: day } %>
                          <div class="text-xs text-red-500 hidden error-message" data-error-for="<%= day %>"></div>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="flex justify-end gap-2 mt-3">
              <%= form.submit "Enregistrer", class: "px-4 py-1.5 text-sm font-medium text-white bg-[#1F5C55] rounded-md hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-0 focus:ring-[#1F5C55]" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Colonne de droite - Aperçu -->
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="px-4 py-2 border-b border-gray-200">
          <h2 class="text-base font-medium text-gray-900">Aperçu des horaires</h2>
        </div>
        <div class="p-3">
          <div class="bg-white rounded-lg shadow-sm p-3">
            <h3 class="text-base font-semibold mb-2 text-[#1F5C55] text-center">Horaires d'ouverture</h3>
            <table class="w-full border-collapse preview-table text-sm">
              <thead>
                <tr>
                  <th class="border-b border-[#1F5C55]/20 py-1.5 text-center font-medium text-gray-600">Jour</th>
                  <th class="border-b border-[#1F5C55]/20 py-1.5 text-center font-medium text-gray-600">Horaires</th>
                </tr>
              </thead>
              <tbody>
                <% @opening_hours.each do |day, hours| %>
                  <tr class="border-b border-gray-100">
                    <% 
                      is_weekend = ["samedi", "dimanche"].include?(day)
                      is_today = Time.zone.now.strftime('%A').downcase == day
                      row_classes = "hover:bg-gray-50"
                      row_classes += " bg-[#1F5C55]/5" if is_today
                    %>
                    <td class="<%= row_classes %> py-1.5 text-center">
                      <div class="flex items-center justify-center">
                        <% 
                          icon_class = case day 
                          when "lundi", "mardi", "mercredi", "jeudi", "vendredi" then "fas fa-briefcase"
                          when "samedi", "dimanche" then "fas fa-umbrella-beach"
                          end
                        %>
                        <i class="<%= icon_class %> text-gray-500 mr-1.5 text-xs"></i>
                        <span class="<%= is_weekend ? 'font-medium text-[#1F5C55]' : '' %> <%= is_today ? 'font-bold' : '' %>">
                          <%= day.capitalize %>
                          <% if is_today %>
                            <span class="ml-1 text-xs bg-[#1F5C55] text-white px-1 py-0.5 rounded-full text-[10px]">Aujourd'hui</span>
                          <% end %>
                        </span>
                      </div>
                    </td>
                    <td class="<%= row_classes %> py-1.5 text-center preview-hours" data-preview-for="<%= day %>">
                      <% if hours.downcase == "fermé" %>
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          <i class="fas fa-times-circle mr-1 text-xs"></i>
                          Fermé
                        </span>
                      <% else %>
                        <span class="text-gray-800">
                          <i class="far fa-clock text-[#1F5C55] mr-1 text-xs"></i>
                          <%= hours %>
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const timeInputs = document.querySelectorAll('.time-input');
  const previewHours = document.querySelectorAll('.preview-hours');
  const form = document.getElementById('opening-hours-form');
  
  // Mise à jour de l'aperçu en temps réel
  timeInputs.forEach(input => {
    input.addEventListener('input', function() {
      const day = this.dataset.day;
      const previewElement = document.querySelector(`[data-preview-for="${day}"]`);
      
      if (this.value.toLowerCase() === "fermé") {
        previewElement.innerHTML = `
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
            <i class="fas fa-times-circle mr-1 text-xs"></i>
            Fermé
          </span>
        `;
      } else {
        previewElement.innerHTML = `
          <span class="text-gray-800">
            <i class="far fa-clock text-[#1F5C55] mr-1 text-xs"></i>
            ${this.value}
          </span>
        `;
      }
    });
  });
  
  // Validation du formulaire
  form.addEventListener('submit', function(event) {
    let isValid = true;
    const timeFormat = /^(([0-1]?[0-9]|2[0-3]):[0-5][0-9] - ([0-1]?[0-9]|2[0-3]):[0-5][0-9]|Fermé)$/i;
    
    timeInputs.forEach(input => {
      const day = input.dataset.day;
      const errorElement = document.querySelector(`[data-error-for="${day}"]`);
      
      errorElement.classList.add('hidden');
      input.classList.remove('border-red-500');
      
      if (!timeFormat.test(input.value)) {
        errorElement.textContent = "Format invalide";
        errorElement.classList.remove('hidden');
        input.classList.add('border-red-500');
        isValid = false;
      }
    });
    
    if (!isValid) {
      event.preventDefault();
    }
  });
});
</script>