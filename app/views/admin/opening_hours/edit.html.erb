<% content_for :title, "Modification des horaires d'ouverture" %>

<div class="min-h-screen py-6">
  <div class="max-w-3xl mx-auto">
    <!-- En-tête -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="bg-gradient-to-r from-[#1F5C55] to-teal-600 px-6 py-4">
        <h1 class="text-2xl font-bold text-white">Modifier les horaires d'ouverture</h1>
        <p class="text-white/80 mt-1">Ces horaires seront affichés sur le site public</p>
      </div>

      <div class="p-6">
        <!-- Instructions -->
        <div class="mb-6 bg-blue-50 p-4 rounded-lg">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">Instructions</h3>
              <div class="mt-2 text-sm text-blue-700">
                <ul class="list-disc pl-5 space-y-1">
                  <li>Utilisez le format <span class="font-mono bg-white px-1 rounded">HH:MM - HH:MM</span> pour les heures d'ouverture</li>
                  <li>Utilisez <span class="font-mono bg-white px-1 rounded">Fermé</span> pour les jours sans ouverture</li>
                  <li>Les changements seront immédiatement visibles sur le site</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulaire -->
        <%= form_with url: admin_opening_hours_path, method: :patch, id: "opening-hours-form", class: "space-y-6" do |form| %>
          <div class="overflow-hidden rounded-lg border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/3">Jour</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-2/3">Horaires</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @opening_hours.each do |day, hours| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center">
                        <% icon_class = case day 
                           when "lundi", "mardi", "mercredi", "jeudi", "vendredi" then "fas fa-briefcase"
                           when "samedi", "dimanche" then "fas fa-umbrella-beach"
                           end %>
                        <i class="<%= icon_class %> text-gray-500 mr-2"></i>
                        <span class="font-medium text-gray-700"><%= day.capitalize %></span>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="relative">
                        <%= text_field_tag "opening_hours[#{day}]", hours, 
                            class: "block w-full px-4 py-2 text-gray-700 placeholder-gray-400 bg-white border border-gray-300 rounded-lg focus:border-[#1F5C55] focus:ring-[#1F5C55] focus:outline-none focus:ring focus:ring-opacity-40 time-input", 
                            placeholder: "ex: 14:00 - 22:00 ou Fermé",
                            data: { day: day } %>
                        <div class="text-xs text-red-500 hidden error-message" data-error-for="<%= day %>"></div>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="flex justify-end gap-4">
            <%= link_to "Annuler", admin_dashboard_index_path, class: "px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
            <%= form.submit "Enregistrer les modifications", class: "px-5 py-2.5 text-sm font-medium text-white bg-[#1F5C55] rounded-lg hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]" %>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Aperçu -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Aperçu des horaires</h2>
        <p class="text-sm text-gray-500">Voici comment vos horaires apparaîtront sur le site</p>
      </div>
      <div class="p-6">
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-semibold mb-4 text-[#1F5C55] text-center">Horaires d'ouverture</h3>
          <table class="w-full border-collapse preview-table">
            <thead>
              <tr>
                <th class="border-b py-2 text-center">Jour</th>
                <th class="border-b py-2 text-center">Horaires</th>
              </tr>
            </thead>
            <tbody>
              <% @opening_hours.each do |day, hours| %>
                <tr>
                  <td class="py-2 text-center"><%= day.capitalize %></td>
                  <td class="py-2 text-center preview-hours" data-preview-for="<%= day %>"><%= hours %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const timeInputs = document.querySelectorAll('.time-input');
  const previewHours = document.querySelectorAll('.preview-hours');
  const form = document.getElementById('opening-hours-form');
  
  // Mise à jour de l'aperçu en temps réel
  timeInputs.forEach(input => {
    input.addEventListener('input', function() {
      const day = this.dataset.day;
      const previewElement = document.querySelector(`[data-preview-for="${day}"]`);
      previewElement.textContent = this.value;
    });
  });
  
  // Validation du formulaire
  form.addEventListener('submit', function(event) {
    let isValid = true;
    const timeFormat = /^(([0-1]?[0-9]|2[0-3]):[0-5][0-9] - ([0-1]?[0-9]|2[0-3]):[0-5][0-9]|Fermé)$/;
    
    timeInputs.forEach(input => {
      const day = input.dataset.day;
      const errorElement = document.querySelector(`[data-error-for="${day}"]`);
      
      errorElement.classList.add('hidden');
      input.classList.remove('border-red-500');
      
      if (!timeFormat.test(input.value)) {
        errorElement.textContent = "Format invalide. Utilisez 'HH:MM - HH:MM' ou 'Fermé'";
        errorElement.classList.remove('hidden');
        input.classList.add('border-red-500');
        isValid = false;
      }
    });
    
    if (!isValid) {
      event.preventDefault();
    }
  });
});
</script>