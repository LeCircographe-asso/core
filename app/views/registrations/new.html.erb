<div class="bg-white w-full max-w-full h-full flex flex-col lg:flex-row overflow-hidden">
    <!-- background image in mobile version -->
    <div class="lg:hidden absolute inset-0 z-0 opacity-20">
        <%= image_tag("about.jpg", alt: "", class: "w-full h-full object-cover") %>
    </div>
    
    <!-- Image section (left) - visible only on desktop -->
    <div class="hidden lg:block lg:w-1/2 overflow-hidden">
        <div class="h-full w-full">
            <%= image_tag("about.jpg", alt: "Circographe Image", class: "w-full h-full object-cover") %>
        </div>
    </div>

    <!-- Form section (right) -->
    <div class="flex items-center justify-center w-full lg:w-1/2 p-4 overflow-y-auto overflow-x-hidden relative z-10">
        <div class="w-full max-w-md bg-white bg-opacity-95 p-5 rounded-lg shadow-sm">
            <div class="text-center mb-4">
                <h1 class="text-2xl font-bold text-gray-700">S'inscrire au Circographe</h1>
            </div>

            <!-- Messages d'erreur -->
            <% if flash[:alert] %>
                <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded relative" role="alert">
                    <p class="font-bold">Erreur :</p>
                    <p><%= flash[:alert] %></p>
                    
                    <!-- Lien d'aide dynamique -->
                    <% if flash[:help_link] %>
                        <div class="mt-2 text-center">
                            <%= link_to flash[:help_link][:text], 
                                        flash[:help_link][:url], 
                                        class: "text-brand-primary hover:underline font-semibold text-sm" %>
                        </div>
                    <% end %>
                </div>
            <% end %>

            <%= form_with model: @user, url: registration_path, method: "post", class: "signup-form space-y-3" do |form| %>
            <!-- Email field -->
            <div>
                <label for="signup_email_address" class="block mb-1 text-sm text-gray-800">Adresse Email</label>
                <%= form.email_field :email_address, required: true, placeholder: "example@example.com", maxlength: 72, id: "signup_email_address", class: "auth-field" %>
            </div>

            <!-- Password Field -->
            <div class="relative" data-controller="password">
                <label for="password" class="block mb-1 text-sm text-gray-800">Mot de passe</label>
                <%= form.password_field :password, required: true, placeholder: "Votre mot de passe", maxlength: 72, id: "password", class: "auth-field password-field" %>
                <span class="toggle-password absolute inset-y-0 right-0 flex items-center pr-3 mt-7" data-action="click->password#toggle">
                    <i class="fa fa-eye text-gray-500" id="password-icon"></i>
                </span>
            </div>

            <!-- Password Confirmation -->
            <div class="relative" data-controller="password">
                <label for="password_confirmation" class="block mb-1 text-sm text-gray-800">Confirmer votre mot de passe</label>
                <%= form.password_field :password_confirmation, required: true, placeholder: "Confirmer votre mot de passe", maxlength: 72, id: "password_confirmation", class: "auth-field password-field" %>
                <span class="toggle-password absolute inset-y-0 right-0 flex items-center pr-3 mt-7" data-action="click->password#toggle">
                    <i class="fa fa-eye text-gray-500" id="password_confirmation-icon"></i>
                </span>
            </div>

            <div class="space-y-3 mt-2">
                <!--Combined Checkbox Terms of Service and Privacy Policy -->
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        <%= form.check_box :cgu, id: "cgu", class: "h-4 w-4 text-[#5836A5] border-gray-300 rounded focus:ring-[#5836A5] focus:ring-offset-0" %>
                        <%= form.hidden_field :privacy_policy, value: '1' %>
                    </div>
                    <div class="ml-2 text-sm">
                        <label for="cgu" class="text-sm text-gray-800">J'accepte les <a href="<%= page_path('terms') %>" class="text-brand-accent hover:underline focus:outline-brand-accent outline-offset-1" target="_blank">Conditions Générales d'Utilisation</a> et la <a href="<%= page_path('privacy_policy') %>" class="text-brand-accent hover:underline focus:outline-brand-accent outline-offset-1" target="_blank">Politique de Confidentialité</a></label>
                        <% if @user.errors[:cgu].any? || @user.errors[:privacy_policy].any? %>
                        <p class="text-red-500 text-xs"><%= @user.errors[:cgu].first || @user.errors[:privacy_policy].first %></p>
                        <% end %>
                    </div>
                </div>

                <!-- Newsletter -->
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        <%= form.check_box :newsletter_subscribed, class: "h-4 w-4 text-[#5836A5] border-gray-300 rounded focus:ring-[#5836A5] focus:ring-offset-0" %>
                    </div>
                    <div class="ml-2 text-sm">
                        <%= form.label :newsletter_subscribed, "S'inscrire à la newsletter", class: "text-sm text-gray-800" %>
                    </div>
                </div>
            </div>

            <!-- Submit button -->
            <div class="mt-4">
                <%= form.submit "S'inscrire", class: "w-full btn-primary justify-center rounded-lg shadow-lg" %>
            </div>
            
            <% if account_claim_enabled? %>
            <!-- Lien revendication de compte -->
            <div class="mt-3 text-center">
                  <p class="text-sm text-gray-600">
                    <%= t("sessions.new.account_claim_lead") %>
                    <%= link_to t("sessions.new.account_claim_recover_link"), new_account_claim_path,
                                class: "text-brand-primary hover:underline font-medium" %>
                  </p>
            </div>
            <% end %>
            <% end %>
        </div>
    </div>
</div>
