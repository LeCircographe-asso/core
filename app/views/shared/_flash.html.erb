<% flash.each do |type, message| %>
<% modifier = case type.to_s
   when 'notice' then 'flash-notice'
   when 'success' then 'flash-success'
   when 'alert' then 'flash-alert'
   when 'error' then 'flash-error'
   when 'warning' then 'flash-warning'
   else 'flash-info'
   end
%>
<div class="flash-notification <%= modifier %>"
     data-controller="flash"
     data-flash-duration-value="8000"
     data-flash-exit-duration-value="350">
  <div class="flash-notification__body">
    <div class="flex-shrink-0 pt-0.5">
      <% case type.to_s %>
      <% when 'notice', 'success' %>
        <svg class="h-7 w-7 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% when 'alert', 'error' %>
        <svg class="h-7 w-7 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% when 'warning' %>
        <svg class="h-7 w-7 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
        </svg>
      <% else %>
        <svg class="h-7 w-7 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% end %>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-base font-medium leading-relaxed text-gray-900"><%= message %></p>
    </div>
    <div class="flex-shrink-0 flex">
      <button type="button" class="rounded-md inline-flex text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              data-action="click->flash#close">
        <span class="sr-only"><%= t("views.shared.flash.close") %></span>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>
  <div class="flash-progress-track" aria-hidden="true">
    <div class="flash-progress-fill" data-flash-target="progress"></div>
  </div>
</div>
<% end %>
