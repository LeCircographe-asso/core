                <% if authenticated? && Current.user %>
                <div class="flex items-center space-x-3 p-4 bg-gray-50 rounded-lg">
                    <%= image_tag("users.png", alt: "photo de profil", class: "w-10 h-10 rounded-full") %>
                    <div>
                        <div class="font-medium">
                            <% if Current.user.first_name.present? || Current.user.last_name.present? %>
                            <%= [Current.user.first_name, Current.user.last_name].compact.join(' ') %>
                            <% else %>
                            <%= t("views.shared.navbar.user") %>
