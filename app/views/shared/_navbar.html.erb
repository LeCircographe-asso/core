                <div class="grid grid-cols-2 gap-3">
                    <%= link_to t("views.shared.navbar.profile"), user_path(Current.user), class: "text-center py-2 px-4 bg-gray-100 rounded-lg hover:bg-gray-200", data: { turbo_preload: "false" } %>
