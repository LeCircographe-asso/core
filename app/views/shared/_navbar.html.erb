                                <li>
                                    <%= link_to t("views.shared.navbar.circus"), page_path('association', anchor: 'le-cirque'), class: "block", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'le-cirque', 'nav-active-active-classes': 'nav-active-link' } %>
                                </li>
                                <li>
                                    <%= link_to t("views.shared.navbar.graphic_arts"), page_path('association', anchor: 'les-arts-graphiques'), class: "block", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'les-arts-graphiques', 'nav-active-active-classes': 'nav-active-link' } %>
                                </li>
                                <li>
                                    <%= link_to t("views.shared.navbar.how_it_works"), page_path('association', anchor: 'fonctionnement'), class: "block", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'fonctionnement', 'nav-active-active-classes': 'nav-active-link' } %>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Our accordion news -->
                <div class="border-b border-gray-200">
                    <h2 id="accordion-actualites-heading">
