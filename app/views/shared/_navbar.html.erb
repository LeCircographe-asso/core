                    <%= button_to t("views.shared.navbar.logout"), session_path, method: :delete, class: "text-center py-2 px-4 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 col-span-2 cursor-pointer" %>
                </div>
                <% end %>
