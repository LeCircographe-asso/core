                      <%= link_to t("views.shared.navbar.sign_up"), new_registration_path, class: "flex h-full min-h-[2.75rem] w-full items-center justify-center text-center text-sm font-bold px-3 py-2 tracking-wide text-white bg-[#1F5C55] border-2 border-[#1F5C55] rounded-lg shadow-lg hover:bg-gray-100 hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300" %>
