                            <li>
                                <%= link_to t("views.shared.navbar.circus"), page_path('association', anchor: 'le-cirque'), class: "block px-4 py-2 hover:bg-gray-100", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'le-cirque', 'nav-active-active-classes': 'nav-active-link' } %>
                            </li>
                            <li>
                                <%= link_to t("views.shared.navbar.graphic_arts"), page_path('association', anchor: 'les-arts-graphiques'), class: "block px-4 py-2 hover:bg-gray-100", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'les-arts-graphiques', 'nav-active-active-classes': 'nav-active-link' } %>
                            </li>
                            <li>
                                <%= link_to t("views.shared.navbar.how_it_works"), page_path('association', anchor: 'fonctionnement'), class: "block px-4 py-2 hover:bg-gray-100", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('association'), 'nav-active-anchor': 'fonctionnement', 'nav-active-active-classes': 'nav-active-link' } %>
                            </li>
                        </ul>
                    </div>
                </li>

                <li>
                    <%= link_to t("views.shared.navbar.activities"), page_path('news'), class: "block py-2 text-gray-900 hover:text-indigo-700", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('news'), 'nav-active-active-classes': 'nav-active-link' } %>
                </li>

                <li>
                    <%= link_to t("views.shared.navbar.join"), page_path('become_member'), class: "block py-2 text-gray-900 hover:text-indigo-700", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('become_member'), 'nav-active-active-classes': 'nav-active-link' } %>
                </li>

                <!-- About -->
                <li class="group relative">
                    <%= link_to page_path('about'), class: "block py-2 text-gray-900 hover:text-indigo-700 group-hover:text-indigo-700", data: { 'nav-active-target': 'link', 'nav-active-path': page_path('about'), 'nav-active-active-classes': 'nav-active-link', 'nav-active-starts-with': 'true' } do %>
