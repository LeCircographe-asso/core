<section class="py-12 flex justify-center">
    <div class="overflow-hidden bg-gray-100/90 w-full max-w-7xl mx-auto flex flex-col lg:flex-row shadow-[0_4px_30px_rgba(0,0,0,0.1)] rounded-2xl backdrop-blur-xl">
        <div class="w-full lg:w-1/2 h-screen/2 lg:h-auto">
            <div class="h-full">
                <%= image_tag image, class: "w-full h-full object-cover", alt: "Artiste réalisant une performance acrobatique lors des entraînements libres" %>
            </div>
        </div>

        <div class="w-full justify-items-center lg:w-1/2 px-6 py-12 lg:py-24">
            <div class="text-center lg:text-left">
                <h2 class="text-2xl font-semibold text-gray-800 dark:text-black md:text-3xl">
                    <%= title %>
                </h2>
            </div>

            <div class="mt-8 text-center lg:text-center">
                <p class="text-black dark:text-black">
                    <%= description %>
                </p>
            </div>

            <div class="mt-8 text-center lg:text-left">
                <%= link_to button_text, link, class: "inline-flex items-center justify-center px-6 py-2 text-sm text-white duration-300 bg-[#6b47b8] border-2 border-[#6b47b8] rounded-lg hover:bg-gray-100 hover:text-[#1F5C55] hover:border-[#1F5C55] focus:ring focus:ring-gray-300 focus:ring-opacity-80" %>
            </div>
        </div>
    </div>
</section>