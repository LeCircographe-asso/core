<% show_account_settings_link = local_assigns.fetch(:show_account_settings_link, true) %>
<% wrapper_classes = local_assigns.fetch(:wrapper_classes, "max-w-lg mx-auto mb-12") %>
<% person = @user.person %>
<% current_membership = person&.current_membership %>
<% recent_membership = person&.most_recent_membership %>
<% membership_lapsed = person.present? && current_membership.blank? && recent_membership.present? %>
<% avatar_src, avatar_alt = membership_card_avatar_source_and_alt(@user) %>

<%= turbo_stream_from person if person.present? %>

<div class="bg-white rounded-xl shadow-lg overflow-hidden <%= wrapper_classes %> w-full">

  <%# ━━━ BANDEAU + AVATAR — NE PAS TOUCHER ━━━ %>
  <div class="relative w-full">
    <div class="h-24 w-full bg-gradient-to-r from-[#1F5C55] to-[#194A45] rounded-t-xl">
      <div class="absolute top-3 left-3 sm:left-4 z-10 px-3 py-1.5 rounded-lg bg-white/15 backdrop-blur-sm border border-white/20 text-left shadow-sm max-w-[calc(100%-7rem)] sm:max-w-none">
        <span class="block text-xs uppercase tracking-wider text-white/80 font-medium leading-tight"><%= t("users.space.membership_card.member_number_label") %></span>
        <span class="block text-sm font-semibold text-white tabular-nums tracking-tight truncate" title="<%= person&.formatted_member_number %>"><%= person&.formatted_member_number %></span>
      </div>
      <div class="absolute top-3 right-3 sm:right-4 px-3 py-1 text-sm font-semibold text-white rounded-full <%= membership_card_role_badge_classes(@user.system_role) %>">
        <%= @user.role_humanized %>
      </div>
    </div>
    <div class="absolute -bottom-12 left-1/2 -translate-x-1/2">
      <div class="h-24 w-24 rounded-full border-4 border-white overflow-hidden bg-white">
        <%= image_tag avatar_src, alt: avatar_alt, class: "h-full w-full object-cover" %>
      </div>
    </div>
  </div>
  <%# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ %>

  <%# ── Identité ── %>
  <div class="pt-14 px-4 pb-2 sm:pt-16 sm:px-5 sm:pb-3 text-center border-b border-gray-200">
    <h2 class="text-base font-bold text-gray-900 leading-tight"><%= membership_card_display_name(@user) %></h2>
    <p class="text-sm text-gray-400 mt-0.5 truncate"><%= @user.email_address %></p>
  </div>

  <%# ── Adhésion + Cotisation (streamable) ── %>
  <%= render "shared/membership_status_tiles", person: person %>

  <%# ── Derniers paiements (streamable) ── %>
  <%= render "shared/recent_payments_list", person: person %>

  <%# ── Coordonnées (infos perso) ── %>
  <% contact_error_fields = %i[phone address zip_code town country] %>
  <% contact_errors = @user.errors.attribute_names.any? { |n| contact_error_fields.include?(n) } %>
  <%= turbo_frame_tag ProfileSectionDomIds::CONTACT_SECTION do %>
    <div id="contact" class="border-b border-gray-200 px-4 py-2.5 sm:px-5 sm:py-3 scroll-mt-28"
         data-controller="section-edit"
         data-section-edit-editing-value="<%= contact_errors %>"
         data-section-edit-warning-message-value="<%= t("users.space.unsaved_changes_warning") %>"
         data-section-edit-modify-label-value="<%= t("users.space.edit") %>"
         data-section-edit-accept-label-value="<%= t("users.space.accept") %>"
         data-section-edit-preview-title-value="<%= t("users.space.preview_submit_title") %>"
         data-section-edit-preview-intro-value="<%= t("users.space.preview_contact_intro") %>"
         data-section-edit-preview-confirm-label-value="<%= t("users.space.preview_confirm") %>"
         data-section-edit-preview-back-label-value="<%= t("users.space.preview_back") %>"
         data-section-edit-yes-label-value="<%= t("users.space.yes") %>"
         data-section-edit-no-label-value="<%= t("users.space.no") %>">

      <div class="flex items-center justify-between gap-3 mb-2 sm:mb-2.5">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#1F5C55]/70"><%= t("users.space.contact_heading") %></p>
        <div class="flex items-center gap-3">
          <div data-section-edit-target="modifyWrap">
            <button type="button" data-section-edit-target="modifyButton" data-action="section-edit#handleModifyClick"
                    class="text-sm font-medium text-[#1F5C55] hover:underline disabled:opacity-40">
              <%= t("users.space.edit") %>
            </button>
          </div>
          <div data-section-edit-target="cancelWrap" class="hidden">
            <button type="button" data-section-edit-target="cancelButton" data-action="section-edit#cancelEdit"
                    class="text-sm text-gray-400 hover:text-gray-600">
              <%= t("users.space.cancel") %>
            </button>
          </div>
          <div data-section-edit-target="acceptWrap" class="hidden">
            <button type="button" data-section-edit-target="acceptButton" data-action="section-edit#handleAcceptClick"
                    data-loading-text="<%= t("users.space.saving") %>"
                    class="inline-flex items-center rounded-md px-3 py-1 text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#1F5C55]/90 shadow-sm">
              <%= t("users.space.accept") %>
            </button>
          </div>
        </div>
      </div>

      <div data-section-edit-target="read" class="grid grid-cols-2 gap-x-3 gap-y-1.5 sm:gap-x-4 sm:gap-y-2">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("users.space.field_phone") %></p>
          <p class="text-sm font-medium text-gray-700 mt-0.5"><%= @user.phone.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("users.space.field_address") %></p>
          <p class="text-sm font-medium text-gray-700 mt-0.5 truncate"><%= @user.address.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("users.space.field_zip") %></p>
          <p class="text-sm font-medium text-gray-700 mt-0.5"><%= @user.zip_code.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("users.space.field_town") %></p>
          <p class="text-sm font-medium text-gray-700 mt-0.5"><%= @user.town.presence || "—" %></p>
        </div>
        <div class="col-span-2">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("users.space.field_country") %></p>
          <p class="text-sm font-medium text-gray-700 mt-0.5"><%= @user.country.presence || "—" %></p>
        </div>
      </div>

      <div data-section-edit-target="edit" class="hidden">
        <%= render "users/coordinates_form", user: @user, form_class: "space-y-4" %>
      </div>
    </div>
  <% end %>

  <%# ── Newsletter ── %>
  <div class="border-b border-gray-200 px-4 py-2 sm:px-5 sm:py-2.5 flex justify-between items-center gap-3">
    <span class="text-xs font-semibold uppercase tracking-widest text-[#1F5C55]/70"><%= t("users.space.newsletter_row_label") %></span>
    <span class="text-sm font-semibold <%= @user.newsletter_subscribed ? 'text-green-700' : 'text-gray-400' %>">
      <%= @user.newsletter_subscribed ? t("users.space.newsletter_subscribed_yes") : t("users.space.newsletter_subscribed_no") %>
    </span>
  </div>

  <%# ── Actions ── %>
  <div class="px-3 py-2.5 sm:px-4 sm:py-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-2">
    <% if defined?(form) && form.present? %>
      <%= form.submit "Enregistrer", class: "flex-1 text-center py-2.5 px-4 rounded-lg text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#1F5C55]/90 shadow-sm" %>
    <% else %>
      <% unless current_membership.present? %>
        <%= link_to(membership_lapsed ? "Renouveler mon adhésion" : "Adhérer",
            page_path("become_member"),
            class: "flex-1 flex items-center justify-center py-2.5 px-4 rounded-lg text-sm font-semibold text-white bg-[#1F5C55] hover:bg-[#1F5C55]/90 shadow-sm") %>
      <% end %>
      <% if @user.can_access_admin_zone? %>
        <%= link_to "Espace administration", admin_root_path,
            class: "flex-1 flex items-center justify-center py-2.5 px-4 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
      <% end %>
      <% if show_account_settings_link %>
        <%= link_to t("users.space.membership_card_settings_link"), settings_path,
            class: "flex-1 flex items-center justify-center py-2.5 px-4 rounded-lg border border-gray-200 text-sm font-medium text-gray-500 bg-white hover:bg-gray-50" %>
      <% end %>
    <% end %>
  </div>

</div>
