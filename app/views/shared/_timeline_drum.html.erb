<%#
  Tambour d'années (ordinateur) : les années sont posées sur un cylindre qui tourne
  (molette, glisser, clic, flèches ↑ ↓). L'année de face est sélectionnée (violet, comme les
  filtres du site) et sa carte s'affiche à côté. De haut en bas : de la plus récente à la plus
  ancienne, en partant de l'année en cours.
  Locals :
    entries     — Array<{ year:, title:, body:, status: :past|:present|:future }>
    show_future — Boolean (default: true)
%>
<% entries     ||= [] %>
<% show_future = local_assigns.fetch(:show_future, true) %>
<% visible     = (show_future ? entries : entries.reject { |e| e[:status] == :future }).sort_by { |e| e[:year].to_s }.reverse %>
<% start_index = visible.index { |e| e[:status] == :present } || visible.index { |e| e[:status] != :future } || 0 %>
<% uid = "tl-drum-#{SecureRandom.hex(3)}" %>

<div class="grid grid-cols-[13rem_minmax(0,1fr)] items-center gap-10"
     data-controller="timeline-drum"
     data-timeline-drum-index-value="<%= start_index %>"
     aria-label="<%= t("views.shared.timeline.label") %>">
  <div class="flex flex-col items-center gap-1">
    <button type="button" class="tl-ribbon-arrow" data-timeline-drum-target="prev" data-action="timeline-drum#previous" aria-label="<%= t("views.shared.timeline.newer_year") %>">
      <svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 10L8 6L12 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <div class="tl-drum"
         role="tablist"
         aria-orientation="vertical"
         aria-label="<%= t("views.shared.timeline.years") %>"
         data-timeline-drum-target="drum"
         data-action="wheel->timeline-drum#wheel:!passive keydown->timeline-drum#key pointerdown->timeline-drum#grab pointermove->timeline-drum#drag pointerup->timeline-drum#release pointercancel->timeline-drum#release">
      <div class="tl-drum__cylinder">
        <% visible.each_with_index do |entry, i| %>
          <button type="button"
                  role="tab"
                  id="<%= uid %>-tab-<%= i %>"
                  aria-controls="<%= uid %>-panel-<%= i %>"
                  aria-selected="<%= i == start_index %>"
                  tabindex="<%= i == start_index ? 0 : -1 %>"
                  class="faq-tab tl-drum__year <%= 'tl-ribbon-year--future' if entry[:status] == :future %>"
                  <%= "data-active" if i == start_index %>
                  data-timeline-drum-target="year"
                  data-action="timeline-drum#choose"
                  data-index="<%= i %>"><%= entry[:year] %></button>
        <% end %>
      </div>
    </div>

    <button type="button" class="tl-ribbon-arrow" data-timeline-drum-target="next" data-action="timeline-drum#next" aria-label="<%= t("views.shared.timeline.older_year") %>">
      <svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

  <div>
    <% visible.each_with_index do |entry, i| %>
      <% status = (entry[:status] || :past).to_sym %>
      <div id="<%= uid %>-panel-<%= i %>"
           role="tabpanel"
           aria-labelledby="<%= uid %>-tab-<%= i %>"
           class="tl-card tl-card--<%= status %> tl-drum-panel"
           data-timeline-drum-target="panel"
           <%= "hidden" unless i == start_index %>>
        <p class="text-sm font-semibold tracking-[0.2em] text-brand-primary/70"><%= entry[:year] %></p>
        <% if status == :present %>
          <span class="tl-badge tl-badge--present mt-2"><%= t("views.shared.timeline.present") %></span>
        <% elsif status == :future %>
          <span class="tl-badge tl-badge--future mt-2"><%= t("views.shared.timeline.future") %></span>
        <% end %>
        <h3 class="mt-1 text-xl font-semibold text-gray-800 leading-snug mb-2"><%= entry[:title] %></h3>
        <p class="text-base text-gray-600 leading-relaxed"><%= entry[:body] %></p>
      </div>
    <% end %>
  </div>
</div>
