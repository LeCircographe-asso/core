<%
  height = local_assigns.fetch(:height, 320)
  caption = local_assigns.fetch(:caption, "Bus 15 (Tiss\u00e9o) \u2014 dessert le boulevard de Suisse sur toute sa longueur (arr\u00eats selon ton sens de marche). Infos : tisseo.fr")
%>
<%# Carte centrée sur 97 bis bd de Suisse (quartier Minimes) — coordonnées approx. %>
<div class="rounded-2xl overflow-hidden border border-gray-200 shadow-inner">
  <iframe
    src="https://www.openstreetmap.org/export/embed.html?bbox=1.407%2C43.612%2C1.432%2C43.622&layer=mapnik&marker=43.61701%2C1.41911"
    width="100%"
    height="<%= height %>"
    style="border:0;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title="Carte — 97 bis Boulevard de Suisse, Toulouse"></iframe>
</div>
<% if caption.present? %>
  <p class="text-sm text-gray-500 mt-3"><%= caption %></p>
<% end %>
