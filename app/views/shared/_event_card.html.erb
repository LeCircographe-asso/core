<div class="w-full rounded-2xl bg-white shadow-md overflow-hidden flex flex-col">
  <div class="aspect-[3/2] overflow-hidden bg-gray-100 shrink-0">
    <%= image_tag(
          event.picture_url.presence || hero_image("event_card_#{event.id || event.object_id}".to_sym),
          alt: event.title,
          class: "w-full h-full object-cover transition-transform duration-300 hover:scale-105",
          loading: "lazy",
          decoding: "async"
        ) %>
  </div>

  <div class="flex flex-col flex-1 p-5 gap-3">
    <h5 class="text-lg font-semibold text-gray-900 leading-snug line-clamp-2">
      <%= event.title %>
    </h5>
    <% description = event.middle_description.presence || event.upper_description.presence || event.description.presence %>
    <% if description.present? %>
      <p class="text-sm text-gray-600 leading-normal line-clamp-3 flex-1"><%= description %></p>
    <% end %>
    <% if event.date.present? %>
      <p class="text-xs font-medium text-brand-primary/70 uppercase tracking-[0.15em]">
        <%= l(event.date.in_time_zone(Time.zone), format: "%d %B %Y") %>
      </p>
    <% end %>
  </div>

  <div class="px-5 pb-5">
    <%= link_to "Voir l'événement", event_path(event),
         class: "block w-full text-center rounded-xl bg-brand-primary py-2.5 text-sm font-semibold text-white transition-colors duration-300 hover:bg-[#194A45] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary",
         data: { turbo_frame: "_top" } %>
  </div>
</div>
