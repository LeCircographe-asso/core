<%# Mobile (< md) : le pied de page est une seule tuile blanche opaque (pas de transparence, contrairement aux encarts) qui fait la hauteur de l’écran (100svh). %>
<footer class="bg-white mt-auto w-full max-md:flex max-md:min-h-[100svh] max-md:flex-col max-md:rounded-t-[28px] max-md:shadow-[0_-8px_24px_rgba(0,0,0,0.08)]">
    <div id="newsletter-footer" class="mx-auto w-full px-4 sm:px-6 py-5 lg:py-6 max-w-screen-xl max-md:flex max-md:flex-1 max-md:flex-col max-md:gap-5 max-md:pt-10 max-md:pb-6">
        <div class="flex flex-col gap-8 max-md:my-auto lg:flex-row lg:justify-between lg:gap-10 lg:items-start">
            <div class="w-full lg:max-w-sm lg:shrink-0 pb-5 md:pb-6 border-b border-gray-100 lg:pb-0 lg:border-0">
                <span class="block text-base font-semibold text-gray-900 text-balance max-lg:text-center"><%= t("views.shared.footer.newsletter_cta") %></span>
                <div class="mt-3">
                    <%= form_with url: newsletter_signup_path, model: User.new, method: :post, class: "flex flex-row flex-wrap items-center gap-2" do |f| %>
                    <label for="user_email_address" class="sr-only"><%= t("views.shared.footer.email_placeholder") %></label>
                    <%= f.email_field :email_address,
                        placeholder: t("views.shared.footer.email_placeholder"),
                        required: true,
                        autocomplete: "email",
                        aria: { required: "true" },
                        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-md focus:border-[#5836A5] focus:ring-[#5836A5] focus:ring-1 focus:outline-none block p-2 min-h-11 flex-1 min-w-[10rem] min-[480px]:min-w-[12rem] min-[480px]:max-w-xs" %>

                    <%# Honeypot field - hidden from humans but bots will fill it %>
                    <div class="hidden" aria-hidden="true">
                        <%= f.text_field :website,
                            tabindex: "-1",
                            autocomplete: "off",
                            aria: { hidden: "true" } %>
                    </div>

                    <%= f.submit t("views.shared.footer.sign_up"),
                        class: "px-6 py-2 min-h-11 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-md shadow-lg hover:bg-white hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300 text-sm w-auto shrink-0 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1F5C55] cursor-pointer" %>
                    <% end %>
                    <%# Mobile : icônes à taille normale (24px) dans des zones tactiles de 44px %>
                    <%= render "shared/footer_social_icons",
                               wrapper_class: "flex md:hidden w-full justify-center items-center gap-6 mt-4",
                               icon_class: "w-6 h-6",
                               link_class: "flex size-11 shrink-0 items-center justify-center rounded-full text-gray-500 hover:text-[#1F5C55] hover:bg-[#1F5C55]/10 active:bg-[#1F5C55]/15 transition-colors touch-manipulation" %>
                </div>
            </div>
            <%# 3 colonnes dès le mobile : le pied de page tient sur un écran %>
            <div class="grid grid-cols-3 gap-x-3 gap-y-6 sm:gap-x-8 md:gap-x-8 md:gap-y-6 md:px-0 w-full lg:flex-1 lg:max-w-3xl min-w-0">
                <div class="min-w-0 text-left">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.discover") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1 max-md:space-y-0 max-md:leading-tight [&_a]:inline-flex [&_a]:items-center max-md:[&_a]:min-h-11">
                        <li><%= link_to t("views.shared.footer.about"), page_path("about"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.place"), page_path("association"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.activities"), page_path("news"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div class="min-w-0 text-left">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.participate") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1 max-md:space-y-0 max-md:leading-tight [&_a]:inline-flex [&_a]:items-center max-md:[&_a]:min-h-11">
                        <li><%= link_to t("views.shared.footer.join"), page_path("become_member"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.contact"), page_path("contact_us"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.map"), page_path("contact_us", anchor: "map"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div class="min-w-0 text-left">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.resources") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1 max-md:space-y-0 max-md:leading-tight [&_a]:inline-flex [&_a]:items-center max-md:[&_a]:min-h-11">
                        <li><%= link_to t("views.shared.footer.faq"), page_path("faq"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.terms"), page_path("terms"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.privacy"), page_path("privacy_policy"), class: "hover:underline" %></li>
                    </ul>
                </div>
            </div>
        </div>
        <hr class="my-8 border-gray-200 mx-auto max-w-full max-md:w-full" />
        <div class="flex flex-col items-center gap-2 md:gap-4 sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-6 sm:gap-y-3">
            <div class="flex justify-center order-1 sm:order-none">
                <%= link_to root_path, class: "inline-flex min-h-11 items-center" do %>
                <%= image_tag "logo.webp", alt: "Logo Circographe", class: "h-8 md:h-10" %>
                <% end %>
            </div>
            <span class="text-sm text-gray-500 text-center order-3 sm:order-none max-w-prose px-2">© <%= Time.zone.now.year %> <%= link_to t("views.shared.footer.brand"), root_path, class: "hover:underline" %>. <%= t("views.shared.footer.all_rights_reserved") %></span>
            <%= render "shared/footer_social_icons", wrapper_class: "hidden md:flex justify-center flex-wrap gap-[50px] order-2 sm:order-none" %>
        </div>
    </div>
</footer>