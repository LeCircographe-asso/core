<footer class="bg-white dark:bg-gray-900">
    <div class="mx-auto w-full max-w-screen-xl p-3 py-5 lg:py-6">
        <div class="md:flex md:justify-between">
            <div class="mb-4 md:mb-0 flex flex-col md:w-1/3">
                <span class="self-center text-base font-semibold whitespace-nowrap dark:text-white">Restez informé en souscrivant à notre newsletter</span>
                <div class="mt-3">
                    <%= form_with url: users_path, model: User, method: :post, class: "flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-2" do |f| %>
                    <%= f.email_field :email_address, 
                        placeholder: "Votre Adresse Email", 
                        required: true,
                        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white w-full sm:w-64" %>
                    <%= f.submit "S'inscrire", 
                        class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-md text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800 w-full sm:w-auto" %>
                    <% end %>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:gap-3 sm:grid-cols-3 md:w-3/5">
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase dark:text-white">Liens rapides</h2>
                    <ul class="text-gray-500 dark:text-gray-400 text-sm">
                        <li class="mb-1">
                            <%= link_to "Accueil", root_path, class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Nos Actualités", page_path("blog_newsletter"), class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Devenir Membre", page_path("become_member"), class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Nous contacter", page_path("contact"), class: "hover:underline" %>
                        </li>
                    </ul>
                </div>
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase dark:text-white">Informations</h2>
                    <ul class="text-gray-500 dark:text-gray-400 text-sm">
                        <li class="mb-1">
                            <%= link_to "Le Lieu", page_path("le_lieu"), class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Le Cirque", page_path("le_cirque"), class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Les Arts Graphiques", page_path("le_graff"), class: "hover:underline" %>
                        </li>
                        <li class="mb-1">
                            <%= link_to "Infos Pratiques", page_path("useful_information"), class: "hover:underline" %>
                        </li>
                    </ul>
                </div>
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase dark:text-white">Mentions légales</h2>
                    <ul class="text-gray-500 dark:text-gray-400 text-sm">
                        <li class="mb-1">
                            <%= link_to "CGU", page_path("cgu"), class: "hover:underline" %>
                        </li>
                        <li>
                            <%= link_to "Politique de confidentialité", page_path("privacy-policy"), class: "hover:underline" %>
                        </li>
                        <li class="mt-1">
                            <%= link_to "F.A.Q", page_path("faq"), class: "hover:underline" %>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <hr class="my-4 border-gray-200 sm:mx-auto dark:border-gray-700" />
        <div class="sm:flex sm:items-center sm:justify-between">
            <div class="flex items-center">
                <%= link_to root_path do %>
                    <%= image_tag "Le-Circographe-crop.png", alt: "Logo Circographe", class: "h-10 mr-3" %>
                <% end %>
            </div>
            <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400 mx-auto">© 2025 <%= link_to "Le Circographe", root_path, class: "hover:underline" %>. Tout Droits Réservés.
            </span>
            <div class="flex mt-2 sm:justify-center sm:mt-0 space-x-5">
                <%= link_to "https://www.facebook.com/lecircographe/?locale=fr_FR", target: "_blank", class: "text-gray-500 hover:text-gray-900 dark:hover:text-white" do %>
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 8 19">
                    <path fill-rule="evenodd" d="M6.135 3H8V0H6.135a4.147 4.147 0 0 0-4.142 4.142V6H0v3h2v9.938h3V9h2.021l.592-3H5V3.591A.6.6 0 0 1 5.592 3h.543Z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only">Facebook page</span>
                <% end %>
                <%= link_to "https://www.instagram.com/lecircographe/", target: "_blank", class: "text-gray-500 hover:text-gray-900 dark:hover:text-white" do %>
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
