<footer class="bg-white mt-auto w-full">
    <div id="newsletter-footer" class="mx-auto w-full px-4 sm:px-6 py-5 lg:py-6 max-w-screen-xl">
        <div class="flex flex-col md:flex-row md:justify-between">
            <div class="mb-6 md:mb-0 md:w-1/3">
                <span class="text-base font-semibold text-left"><%= t("views.shared.footer.newsletter_cta") %></span>
                <div class="mt-3">
                    <%= form_with url: newsletter_signup_path, model: User.new, method: :post, class: "flex flex-col sm:flex-row items-start sm:items-center gap-2" do |f| %>
                    <%= f.email_field :email_address, 
                        placeholder: t("views.shared.footer.email_placeholder"), 
                        required: true,
                        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-md focus:border-[#5836A5] focus:ring-[#5836A5] focus:ring-1 focus:outline-none block p-2 w-full sm:w-64" %>
                    
                    <%# Honeypot field - hidden from humans but bots will fill it %>
                    <div class="hidden">
                        <%= f.text_field :website, 
                            tabindex: "-1",
                            autocomplete: "off" %>
                    </div>
                    
                    <%= f.submit t("views.shared.footer.sign_up"), 
                        class: "px-6 py-2 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-md shadow-lg hover:bg-white hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300 text-sm w-full sm:w-auto focus:outline-none cursor-pointer" %>
                    <% end %>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 md:w-3/5">
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.discover") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1">
                        <li><%= link_to t("views.shared.footer.about"), page_path("about"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.place"), page_path("association"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.activities"), page_path("news"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.participate") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1">
                        <li><%= link_to t("views.shared.footer.join"), page_path("become_member"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.contact"), page_path("contact_us"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.map"), page_path("contact_us", anchor: "map"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div>
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.resources") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1">
                        <li><%= link_to t("views.shared.footer.faq"), page_path("faq"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.terms"), page_path("terms"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.privacy"), page_path("privacy_policy"), class: "hover:underline" %></li>
                    </ul>
                </div>
            </div>
        </div>
        <hr class="footer-divider border-gray-200 sm:mx-auto mt-8 mb-8" />
        <div class="flex flex-col items-center sm:flex-row sm:justify-between">
            <div class="flex justify-center mb-3 sm:mb-0">
                <%= link_to root_path do %>
                <%= image_tag "logo.webp", alt: "Logo Circographe", class: "h-10" %>
                <% end %>
            </div>
            <span class="text-sm text-gray-500 text-center mb-3 sm:mb-0">© 2025 <%= link_to t("views.shared.footer.brand"), root_path, class: "hover:underline" %>. <%= t("views.shared.footer.all_rights_reserved") %></span>
            <div class="flex justify-center space-x-5">
                <%= link_to "https://www.facebook.com/lecircographe/?locale=fr_FR", target: "_blank", class: "text-gray-500 hover:text-gray-900" do %>
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 8 19">
                    <path fill-rule="evenodd" d="M6.135 3H8V0H6.135a4.147 4.147 0 0 0-4.142 4.142V6H0v3h2v9.938h3V9h2.021l.592-3H5V3.591A.6.6 0 0 1 5.592 3h.543Z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only">Facebook page</span>
                <% end %>
                <%= link_to "https://www.instagram.com/lecircographe/", target: "_blank", class: "text-gray-500 hover:text-gray-900" do %>
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.09 1.064.077 1.791.232 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.233.636.388 1.363.465 2.427.077 1.067.09 1.407.09 4.123v.08c0 2.643-.012 2.987-.09 4.043-.077 1.064-.232 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.233-1.363.388-2.427.465-1.067.077-1.407.09-4.123.09h-.08c-2.643 0-2.987-.012-4.043-.09-1.064-.077-1.791-.232-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.233-.636-.388-1.363-.465-2.427-.077-1.024-.087-1.379-.087-4.808v-.63c0-2.43.013-2.784.09-3.808.077-1.064.232-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.233 1.363-.388 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only">Instagram page</span>
                <% end %>
                <%= link_to "https://wa.me/33612345678", target: "_blank", class: "text-gray-500 hover:text-gray-900" do %>
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 448 512">
                    <path fill-rule="evenodd" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only">WhatsApp page</span>
                <% end %>
            </div>
        </div>
    </div>
</footer>