<footer class="bg-white mt-auto w-full">
    <div id="newsletter-footer" class="mx-auto w-full px-4 sm:px-6 py-5 lg:py-6 max-w-screen-xl">
        <div class="flex flex-col gap-6 md:gap-8 lg:flex-row lg:justify-between lg:gap-10 lg:items-start">
            <div class="w-full lg:max-w-sm lg:shrink-0 pb-6 border-b border-gray-100 lg:pb-0 lg:border-0">
                <span class="text-base font-semibold text-gray-900"><%= t("views.shared.footer.newsletter_cta") %></span>
                <div class="mt-3">
                    <%= form_with url: newsletter_signup_path, model: User.new, method: :post, class: "flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2" do |f| %>
                    <%= f.email_field :email_address, 
                        placeholder: t("views.shared.footer.email_placeholder"), 
                        required: true,
                        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-md focus:border-[#5836A5] focus:ring-[#5836A5] focus:ring-1 focus:outline-none block p-2 w-full min-w-0 sm:flex-1 sm:min-w-[12rem] sm:max-w-xs" %>
                    
                    <%# Honeypot field - hidden from humans but bots will fill it %>
                    <div class="hidden">
                        <%= f.text_field :website, 
                            tabindex: "-1",
                            autocomplete: "off" %>
                    </div>
                    
                    <%= f.submit t("views.shared.footer.sign_up"), 
                        class: "px-6 py-2 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-md shadow-lg hover:bg-white hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300 text-sm w-full sm:w-auto shrink-0 focus:outline-none cursor-pointer" %>
                    <% end %>
                    <%# Mobile : grandes icônes, étalées sous le bouton (largeur pleine) pour aérer avant les liens %>
                    <%= render "shared/footer_social_icons",
                               wrapper_class: "flex md:hidden w-full justify-between items-center flex-nowrap mt-6 pt-3 pb-4 px-2 sm:px-4 min-h-[5.5rem]",
                               icon_class: "w-16 h-16",
                               link_class: "flex shrink-0 items-center justify-center min-w-[3.5rem] min-h-[3.5rem] p-2 rounded-2xl text-gray-600 hover:text-[#1F5C55] hover:bg-[#1F5C55]/10 active:bg-[#1F5C55]/15 transition-colors touch-manipulation" %>
                </div>
            </div>
            <%# Mobile : 2 col avec plus d’air au centre + léger retrait des bords ; md+ : 3 colonnes %>
            <div class="grid grid-cols-2 gap-x-10 gap-y-6 max-md:px-2 md:grid-cols-3 md:gap-x-8 md:gap-y-6 md:px-0 w-full lg:flex-1 lg:max-w-3xl min-w-0">
                <div class="min-w-0 text-left max-md:pl-1">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.discover") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1">
                        <li><%= link_to t("views.shared.footer.about"), page_path("about"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.place"), page_path("association"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.activities"), page_path("news"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div class="min-w-0 text-right md:text-left max-md:pr-1">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.participate") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1 [&_a]:inline-block">
                        <li><%= link_to t("views.shared.footer.join"), page_path("become_member"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.contact"), page_path("contact_us"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.map"), page_path("contact_us", anchor: "map"), class: "hover:underline" %></li>
                    </ul>
                </div>
                <div class="col-span-2 md:col-span-1 min-w-0 text-center md:text-left">
                    <h2 class="mb-2 text-sm font-semibold text-gray-900 uppercase"><%= t("views.shared.footer.resources") %></h2>
                    <ul class="text-gray-500 text-sm space-y-1">
                        <li><%= link_to t("views.shared.footer.faq"), page_path("faq"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.terms"), page_path("terms"), class: "hover:underline" %></li>
                        <li><%= link_to t("views.shared.footer.privacy"), page_path("privacy_policy"), class: "hover:underline" %></li>
                    </ul>
                </div>
            </div>
        </div>
        <hr class="footer-divider border-gray-200 mx-auto max-w-full mt-8 mb-6 md:mb-8" />
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-6 sm:gap-y-3">
            <div class="flex justify-center order-1 sm:order-none">
                <%= link_to root_path do %>
                <%= image_tag "logo.webp", alt: "Logo Circographe", class: "h-10" %>
                <% end %>
            </div>
            <span class="text-sm text-gray-500 text-center order-3 sm:order-none max-w-prose px-2">© <%= Time.zone.now.year %> <%= link_to t("views.shared.footer.brand"), root_path, class: "hover:underline" %>. <%= t("views.shared.footer.all_rights_reserved") %></span>
            <%= render "shared/footer_social_icons", wrapper_class: "hidden md:flex justify-center flex-wrap gap-[50px] order-2 sm:order-none" %>
        </div>
    </div>
</footer>