<div id="pwa-install-banner"
     data-controller="pwa-banner"
     class="fixed bottom-0 inset-x-0 z-[60] translate-y-full transition-transform duration-300 ease-out will-change-transform"
     hidden
     aria-live="polite"
     role="region"
     aria-label="Proposition d'installation">

  <div class="relative bg-white border-t border-gray-200 shadow-2xl pwa-safe-area-bottom">

    <%# Dismiss button %>
    <button type="button"
            class="absolute top-3 right-3 rounded-lg p-1.5 text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            data-action="pwa-banner#dismiss"
            aria-label="Fermer">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.75.75 0 1 1 1.06 1.06L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"/>
      </svg>
    </button>

    <div class="max-w-lg mx-auto px-4 pt-3 pb-4 pr-12">

      <%# App identity row %>
      <div class="flex items-center gap-3">
        <img src="/icon.png"
             alt=""
             aria-hidden="true"
             class="w-11 h-11 rounded-2xl shadow-sm flex-shrink-0 object-cover">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-gray-900 leading-snug">Le Circographe</p>
          <p class="text-xs text-gray-400 mt-0.5 leading-snug">Horaires · Accès · Infos de l'asso</p>
        </div>
      </div>

      <%# Chrome/Android: install button %>
      <button type="button"
              class="mt-3 w-full flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#194A45] active:scale-[0.98] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
              data-action="pwa-banner#install"
              data-pwa-banner-target="installBtn"
              hidden>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Ajouter à l'écran d'accueil
      </button>

      <%# Android manual (HTTP / prompt non déclenché): instructions menu ⋮ %>
      <div data-pwa-banner-target="androidHint" hidden>
        <button type="button"
                class="mt-3 w-full flex items-center justify-center gap-2 rounded-xl border border-brand-primary/25 bg-brand-primary/8 px-4 py-2.5 text-sm font-semibold text-brand-primary active:scale-[0.98] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
                data-action="pwa-banner#toggleAndroidInstructions">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Ajouter à l'écran d'accueil
        </button>

        <div class="mt-3 rounded-xl bg-gray-50 border border-gray-100 p-3.5 space-y-3"
             data-pwa-banner-target="androidInstructions"
             hidden>
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Dans Chrome Android :</p>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">1</span>
            <p class="text-sm text-gray-700 leading-snug">
              Touche
              <svg class="inline w-4 h-4 text-gray-600 align-text-bottom mx-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
              <strong>⋮</strong> en haut à droite de Chrome
            </p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">2</span>
            <p class="text-sm text-gray-700 leading-snug">Choisis <strong>Ajouter à l'écran d'accueil</strong></p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">3</span>
            <p class="text-sm text-gray-700 leading-snug">Touche <strong>Ajouter</strong> pour confirmer</p>
          </div>
        </div>
      </div>

      <%# iOS: expandable instructions %>
      <div data-pwa-banner-target="iosHint" hidden>
        <button type="button"
                class="mt-3 w-full flex items-center justify-center gap-2 rounded-xl border border-brand-primary/25 bg-brand-primary/8 px-4 py-2.5 text-sm font-semibold text-brand-primary active:scale-[0.98] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
                data-action="pwa-banner#toggleIosInstructions">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          Installer sur iPhone / iPad
        </button>

        <div class="mt-3 rounded-xl bg-gray-50 border border-gray-100 p-3.5 space-y-3"
             data-pwa-banner-target="iosInstructions"
             hidden>
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Comment faire dans Safari :</p>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">1</span>
            <p class="text-sm text-gray-700 leading-snug">
              Touche l'icône
              <svg class="inline w-4 h-4 text-blue-500 align-text-bottom mx-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2L8 6h3v9h2V6h3L12 2zm-7 14v2h14v-2H5z"/></svg>
              <strong>Partager</strong> en bas de l'écran
            </p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">2</span>
            <p class="text-sm text-gray-700 leading-snug">Choisis <strong>Sur l'écran d'accueil</strong></p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="shrink-0 w-5 h-5 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center mt-0.5">3</span>
            <p class="text-sm text-gray-700 leading-snug">Touche <strong>Ajouter</strong> en haut à droite</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
