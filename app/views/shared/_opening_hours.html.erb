<% bare = local_assigns.fetch(:bare, false) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% wrapper_classes = bare ? "" : "bg-white rounded-lg shadow-md p-4" %>
<% schedule = local_assigns[:horaires] || @horaires %>
<% badge_margin = compact ? "mb-1.5 sm:mb-2" : "mb-2 sm:mb-4" %>
<% cell_py = compact ? "py-1 sm:py-2" : "py-1.5 sm:py-3" %>
<% head_py = compact ? "py-1 sm:py-1.5" : "py-1 sm:py-2" %>

<% inner = capture do %>
  <div class="text-center <%= badge_margin %>">
    <span class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full text-xs sm:text-sm font-medium bg-brand-primary/10 text-brand-primary">
      <i class="fas fa-calendar-week mr-1.5 sm:mr-2 text-[0.85em] sm:text-base"></i>
      Semaine du <%= Date.current.beginning_of_week.strftime("%d/%m") %> au <%= Date.current.end_of_week.strftime("%d/%m/%Y") %>
    </span>
  </div>

  <% if schedule.present? %>
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="border-b-2 border-brand-primary/20 <%= head_py %> text-center font-medium text-gray-600">Jour</th>
          <th class="border-b-2 border-brand-primary/20 <%= head_py %> text-center font-medium text-gray-600">Horaires</th>
        </tr>
      </thead>
      <tbody>
        <% schedule.each do |day, hours| %>
          <tr class="border-b border-gray-100">
            <% 
              is_weekend = ["samedi", "dimanche"].include?(day.to_s)
              is_today = Time.zone.now.strftime('%A').downcase == day.to_s
              row_classes = "hover:bg-gray-50"
              row_classes += " bg-brand-primary/5" if is_today
            %>
            <td class="<%= row_classes %> <%= cell_py %> text-center">
              <div class="flex items-center justify-center">
                <% 
                  icon_class = case day.to_s
                  when "lundi", "mardi", "mercredi", "jeudi", "vendredi" then "fas fa-briefcase"
                  when "samedi", "dimanche" then "fas fa-umbrella-beach"
                  end
                %>
                <i class="<%= icon_class %> text-gray-500 mr-2 hidden sm:inline"></i>
                <span class="<%= is_weekend ? 'font-medium text-brand-primary' : '' %> <%= is_today ? 'font-bold' : '' %>">
                  <%= day.to_s.capitalize %>
                  <% if is_today %>
                    <span class="ml-1 text-xs bg-brand-primary text-white px-1.5 py-0.5 rounded-full">Aujourd'hui</span>
                  <% end %>
                </span>
              </div>
            </td>
            <td class="<%= row_classes %> <%= cell_py %> text-center">
              <% if hours.to_s.downcase == "fermé" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  <i class="fas fa-times-circle mr-1"></i>
                  Fermé
                </span>
              <% else %>
                <span class="text-gray-800">
                  <i class="far fa-clock text-brand-primary mr-1 hidden sm:inline"></i>
                  <%= hours %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center py-4 text-gray-500">
      <i class="fas fa-clock text-brand-primary text-4xl mb-2"></i>
      <p>Aucun horaire n'est disponible pour le moment.</p>
    </div>
  <% end %>
<% end %>

<% if bare %>
  <div class="<%= compact ? 'space-y-1.5 sm:space-y-2' : 'space-y-2 sm:space-y-4' %>">
    <%= inner %>
  </div>
<% else %>
  <div class="<%= wrapper_classes %>">
    <%= inner %>
</div> 
<% end %>