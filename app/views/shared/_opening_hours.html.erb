<%# Params: schedule (hash), compact (bool), table (bool), show_freshness (bool), closure (ExceptionalClosure) %>
<% schedule       = local_assigns[:schedule] || local_assigns[:horaires] || @opening_hours || @horaires %>
<% compact        = local_assigns.fetch(:compact, false) %>
<% table          = local_assigns.fetch(:table, false) %>
<% show_freshness = local_assigns.fetch(:show_freshness, false) %>
<% closure        = local_assigns[:closure] %>
<% closed_now     = closure&.in_effect? %>
<% updated_at     = show_freshness ? OpeningHour.latest_update_entry&.updated_at : nil %>
<% px             = compact ? "px-3" : "px-4" %>
<% py             = compact ? "py-2" : "py-2.5" %>
<% grid_dim_class = closed_now ? "opacity-40 grayscale-[.4]" : "" %>

<%
  # La fermeture exceptionnelle prime sur la fraîcheur : c'est l'info la plus pertinente
  # à ce moment-là, pas la peine d'afficher les deux pastilles à la fois.
  status_badge = capture do
    if closed_now
      concat content_tag(:div, class: "flex justify-center #{compact ? 'mt-1.5' : 'mt-2.5'}") {
        content_tag(:span, class: "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200") do
          concat content_tag(:i, nil, class: "fas fa-umbrella-beach", "aria-hidden": true)
          label_part = [ closure.label.presence, closure.ends_on.present? ? "jusqu'au #{l(closure.ends_on, format: '%d/%m')}" : nil ].compact.join(" — ")
          concat [ "Fermeture exceptionnelle", label_part.presence ].compact.join(" · ")
        end
      }
    elsif show_freshness
      concat content_tag(:div, class: "flex justify-center #{compact ? 'mt-1.5' : 'mt-2.5'}") {
        content_tag(:span, class: "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-brand-primary/10 text-brand-primary") do
          concat content_tag(:i, nil, class: "far fa-clock", "aria-hidden": true)
          concat "Mis à jour #{updated_at.present? ? l(updated_at.in_time_zone(Time.zone), format: '%-d/%m %H:%M') : '—'}"
        end
      }
    end
  end
%>

<% if table %>

  <%# ── Variante table (home page) ── %>
  <% badge_margin = compact ? "mb-1.5 sm:mb-2" : "mb-2 sm:mb-3" %>
  <% cell_py      = compact ? "py-1.5 sm:py-2" : "py-2 sm:py-3" %>
  <% head_py      = compact ? "py-1 sm:py-1.5" : "py-1.5 sm:py-2" %>

  <div class="<%= compact ? 'space-y-1.5 sm:space-y-2' : 'space-y-2 sm:space-y-3' %>">
    <div class="text-center <%= badge_margin %>">
      <span class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full text-xs sm:text-sm font-medium bg-brand-primary/10 text-brand-primary">
        <i class="fas fa-calendar-week mr-1.5 sm:mr-2 text-[0.85em]" aria-hidden="true"></i>
        Semaine du <%= Date.current.beginning_of_week.strftime("%d/%m") %> au <%= Date.current.end_of_week.strftime("%d/%m/%Y") %>
      </span>
    </div>

    <% if schedule.present? %>
      <table class="w-full border-collapse <%= grid_dim_class %>">
        <caption class="sr-only">Horaires d'ouverture de la semaine</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b-2 border-brand-primary/20 <%= head_py %> text-center text-sm font-medium text-gray-600">Jour</th>
            <th scope="col" class="border-b-2 border-brand-primary/20 <%= head_py %> text-center text-sm font-medium text-gray-600">Horaires</th>
          </tr>
        </thead>
        <tbody>
          <% schedule.each do |day, hours| %>
            <%
              is_weekend = ["samedi", "dimanche"].include?(day.to_s)
              is_today   = Time.zone.now.strftime("%A").downcase == day.to_s
              is_closed  = hours.to_s.downcase == "fermé"
              icon_class = is_weekend ? "fas fa-umbrella-beach" : "fas fa-briefcase"
              row_bg     = is_today ? "bg-brand-primary/5" : "hover:bg-gray-50"
            %>
            <tr class="border-b border-gray-100 <%= row_bg %>">
              <td class="<%= cell_py %> text-center">
                <div class="flex items-center justify-center gap-1.5 sm:gap-2">
                  <i class="<%= icon_class %> text-gray-400 text-xs hidden sm:inline" aria-hidden="true"></i>
                  <span class="text-sm <%= is_weekend ? 'font-medium text-brand-primary' : 'text-gray-700' %> <%= is_today ? 'font-bold' : '' %>">
                    <%= day.to_s.capitalize %>
                  </span>
                  <% if is_today %>
                    <span class="ml-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-white bg-brand-primary px-1.5 py-0.5 rounded-full">Aujourd'hui</span>
                  <% end %>
                </div>
              </td>
              <td class="<%= cell_py %> text-center">
                <% if is_closed %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">
                    <i class="fas fa-times-circle" aria-hidden="true"></i>
                    Fermé
                  </span>
                <% else %>
                  <span class="text-sm text-gray-800 tabular-nums">
                    <i class="far fa-clock text-brand-primary mr-1 hidden sm:inline" aria-hidden="true"></i>
                    <%= hours %>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-4 text-gray-500">
        <i class="fas fa-clock text-brand-primary text-3xl mb-2" aria-hidden="true"></i>
        <p class="text-sm">Aucun horaire disponible pour le moment.</p>
      </div>
    <% end %>

    <%= status_badge %>
  </div>

<% else %>

  <%# ── Variante liste (autres pages) ── %>
  <% if schedule.present? %>
    <div class="divide-y divide-gray-50 <%= grid_dim_class %>">
      <% schedule.each do |day, hours| %>
        <% is_today   = Time.zone.now.strftime("%A").downcase == day.to_s %>
        <% is_closed  = hours.to_s.downcase == "fermé" %>
        <% is_weekend = ["samedi", "dimanche"].include?(day.to_s) %>
        <% row_bg     = is_today ? "bg-[#1F5C55]/[0.06] border-l-2 border-[#1F5C55]" : "" %>
        <% name_cls   = is_today ? "text-[#1F5C55] font-bold" : (is_weekend ? "text-gray-500" : "text-gray-900") %>
        <% time_cls   = is_today ? "text-[#1F5C55]/80 font-semibold" : "text-gray-600 font-semibold" %>
        <div class="flex items-center gap-3 <%= px %> <%= py %> <%= row_bg %>">
          <span class="w-24 shrink-0 text-sm <%= name_cls %>"><%= day.to_s.capitalize %></span>
          <% if is_closed %>
            <span class="text-sm font-medium text-gray-400">Fermé</span>
          <% else %>
            <span class="text-sm tabular-nums <%= time_cls %>"><%= hours %></span>
          <% end %>
          <% if is_today %>
            <span class="ml-auto text-[10px] font-semibold uppercase tracking-wider text-[#1F5C55] bg-[#1F5C55]/[0.08] border border-[#1F5C55]/20 px-2 py-0.5 rounded-md">Aujourd'hui</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="<%= px %> py-6 text-sm text-gray-500 text-center">Aucun horaire disponible.</p>
  <% end %>

  <%= status_badge %>

<% end %>
