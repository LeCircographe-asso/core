<%
  # Accepts schedules passed as parameters or uses @schedules
  schedule = local_assigns[:horaires] || @horaires
%>
<% if schedule.present? %>
  <div class="p-3">
    <div class="text-center mb-3">
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-[#1F5C55]/10 text-[#1F5C55]">
        <i class="fas fa-calendar-week mr-1"></i>
        Semaine du <%= Date.current.beginning_of_week.strftime("%d/%m") %> au <%= Date.current.end_of_week.strftime("%d/%m/%Y") %>
      </span>
    </div>
    
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="border-b border-[#1F5C55]/20 py-2 text-center font-medium text-gray-600 text-sm">Jour</th>
          <th class="border-b border-[#1F5C55]/20 py-2 text-center font-medium text-gray-600 text-sm">Horaires</th>
        </tr>
      </thead>
      <tbody>
        <% schedule.each do |day, hours| %>
          <tr class="border-b border-gray-100">
            <% 
              is_weekend = ["samedi", "dimanche"].include?(day.to_s)
              is_today = Time.zone.now.strftime('%A').downcase == day.to_s
              row_classes = "hover:bg-gray-50"
              row_classes += " bg-[#1F5C55]/5" if is_today
            %>
            <td class="<%= row_classes %> py-2 text-center">
              <div class="flex items-center justify-center">
                <% 
                  icon_class = case day.to_s
                  when "lundi", "mardi", "mercredi", "jeudi", "vendredi" then "fas fa-briefcase"
                  when "samedi", "dimanche" then "fas fa-umbrella-beach"
                  end
                %>
                <i class="<%= icon_class %> text-gray-500 mr-2 text-sm"></i>
                <span class="<%= is_weekend ? 'font-medium text-[#1F5C55]' : '' %> <%= is_today ? 'font-bold' : '' %> text-sm">
                  <%= day.to_s.capitalize %>
                  <% if is_today %>
                    <span class="ml-1 text-xs bg-[#1F5C55] text-white px-1.5 py-0.5 rounded-full">Aujourd'hui</span>
                  <% end %>
                </span>
              </div>
            </td>
            <td class="<%= row_classes %> py-2 text-center">
              <% if hours.to_s.downcase == "fermé" %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  <i class="fas fa-times-circle mr-1"></i>
                  Fermé
                </span>
              <% else %>
                <span class="text-gray-800 text-sm">
                  <i class="far fa-clock text-[#1F5C55] mr-1"></i>
                  <%= hours %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-4 text-gray-500">
    <i class="fas fa-clock text-[#1F5C55] text-3xl mb-2"></i>
    <p class="text-sm">Aucun horaire n'est disponible pour le moment.</p>
  </div>
<% end %>
