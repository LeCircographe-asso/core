<% slider_options = {
  loop: true,
  slidesPerView: 3,
  spaceBetween: 20,
  breakpoints: {
    1920 => { slidesPerView: 3, spaceBetween: 30 },
    1028 => { slidesPerView: 2, spaceBetween: 30 },
    990 => { slidesPerView: 1, spaceBetween: 0 }
  }
} %>

<div class="w-full relative">
    <div class="swiper multiple-slide-carousel swiper-container relative"
         data-controller="slider"
         data-slider-options-value="<%= slider_options.to_json %>">
        <div class="swiper-wrapper mb-16">
            <% images.each_with_index do |image, index| %>
            <div class="swiper-slide">
                <div class="public-carousel-media rounded-2xl flex justify-center items-center overflow-hidden">
                    <%= image_tag image,
                                  alt: "Carousel Image",
                                  class: "object-cover w-full h-full",
                                  loading: (index.zero? ? "eager" : "lazy"),
                                  decoding: "async" %>
                </div>
            </div>
            <% end %>
        </div>
        <%= render "shared/carousel_arrows", icon_class: "h-5 w-5 !text-black hover:!text-gray-800", prev_label: "Photo précédente", next_label: "Photo suivante" %>
    </div>
</div>
