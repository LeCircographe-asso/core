<%# Bloc FAQ intégré à une page (ex. « Avant de te déplacer » sur /adhesion) : même liste que la
    page /faq (shared/faq_list), plus un lien vers toute la FAQ. %>
<% label = local_assigns[:label] %>
<% title = local_assigns.fetch(:title) %>
<% subtitle = local_assigns[:subtitle] %>
<% footer = local_assigns[:footer] %>
<% id = local_assigns.fetch(:id, "faq-section") %>
<% faqs = local_assigns.fetch(:faqs, []) %>
<% card_class = local_assigns.fetch(:card_class, "public-card-shell") %>
<% centered = local_assigns.fetch(:header_align, "center") != "left" %>

<section class="<%= card_class %>" aria-labelledby="<%= id %>">
  <header class="<%= centered ? 'text-center' : 'text-left' %> mb-4 space-y-2">
    <% if label.present? %>
      <p class="section-eyebrow"><%= label %></p>
    <% end %>
    <h2 id="<%= id %>" class="text-2xl font-semibold text-gray-800"><%= title %></h2>
    <% if subtitle.present? %>
      <p class="text-gray-600 <%= centered ? 'max-w-2xl mx-auto' : 'max-w-prose' %>"><%= subtitle %></p>
    <% end %>
  </header>

  <%= render "shared/faq_list", faqs: faqs %>

  <div class="mt-4 space-y-2 <%= centered ? 'text-center' : 'text-left' %>">
    <% if footer.present? %>
      <p class="text-sm text-gray-500"><%= footer %></p>
    <% end %>
    <%= link_to t("views.shared.faq_section.all_faq"), page_path("faq"), class: "inline-flex min-h-11 items-center text-sm font-semibold text-brand-primary hover:underline" %>
  </div>
</section>
