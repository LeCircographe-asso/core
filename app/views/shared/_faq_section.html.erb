<% label = local_assigns[:label] %>
<% title = local_assigns.fetch(:title) %>
<% subtitle = local_assigns[:subtitle] %>
<% footer = local_assigns[:footer] %>
<% id = local_assigns.fetch(:id, "faq-section") %>
<% faqs = local_assigns.fetch(:faqs, []) %>
<% card_class = local_assigns.fetch(:card_class, "public-surface p-6 sm:p-8") %>
<% centered = local_assigns.fetch(:header_align, "center") != "left" %>

<section class="<%= card_class %>" aria-labelledby="<%= id %>" data-controller="accordion" data-accordion-animate-value="true">
  <header class="<%= centered ? 'text-center' : 'text-left' %> mb-6 space-y-2">
    <% if label.present? %>
      <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70"><%= label %></p>
    <% end %>
    <h2 id="<%= id %>" class="text-2xl font-semibold text-gray-800"><%= title %></h2>
    <% if subtitle.present? %>
      <p class="text-gray-600 <%= centered ? 'max-w-2xl mx-auto' : 'max-w-prose' %>"><%= subtitle %></p>
    <% end %>
  </header>

  <div class="space-y-4">
    <% faqs.each_with_index do |faq, index| %>
      <div class="group p-4 bg-white border border-gray-100 rounded-2xl shadow-sm transition hover:border-[#1F5C55]/40 focus-within:border-[#1F5C55]/40">
        <h3 id="<%= id %>-heading-<%= index %>">
          <button type="button"
                  class="flex items-center justify-between w-full text-left text-lg font-semibold text-gray-800 transition-colors group-hover:text-[#1F5C55] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#5836A5] focus-visible:ring-offset-2 focus-visible:ring-offset-white rounded-xl px-1 py-1"
                  data-accordion-target="#<%= id %>-body-<%= index %>"
                  aria-expanded="false"
                  aria-controls="<%= id %>-body-<%= index %>">
            <span><%= faq[:question] %></span>
            <svg data-accordion-icon class="w-4 h-4 rotate-180 shrink-0 transition-transform group-hover:text-[#1F5C55]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5" />
            </svg>
          </button>
        </h3>
        <div id="<%= id %>-body-<%= index %>" class="hidden mt-3 text-gray-600" aria-labelledby="<%= id %>-heading-<%= index %>">
          <% if faq[:answer_html].present? %>
            <p><%= faq[:answer_html] %></p>
          <% else %>
            <p><%= faq[:answer] %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if footer.present? %>
    <p class="mt-4 text-sm text-gray-500 <%= centered ? 'text-center' : 'text-left' %>"><%= footer %></p>
  <% end %>
</section>
