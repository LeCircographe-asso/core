<div data-controller="bug-report">
  <button type="button"
          data-action="bug-report#open"
          data-bug-report-target="trigger"
          aria-haspopup="dialog"
          class="fixed bottom-5 right-5 z-[100] inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#1F5C55] text-white shadow-lg ring-1 ring-black/5 transition-[background-color,bottom] duration-300 hover:bg-[#17433e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1F5C55]"
          title="<%= t("bug_reports.widget.button_title") %>"
          aria-label="<%= t("bug_reports.widget.button_title") %>">
    <i class="fas fa-bug" aria-hidden="true"></i>
  </button>

  <div id="bug-report-modal"
       class="hidden fixed inset-0 z-[125] flex items-center justify-center px-4 py-6"
       role="dialog"
       aria-modal="true"
       aria-labelledby="bug-report-modal-title"
       data-bug-report-target="panel">
    <div class="absolute inset-0 bg-gray-900/65" data-action="click->bug-report#close"></div>

    <div class="relative flex w-full max-w-md max-h-[90vh] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-gray-200 focus:outline-none"
         data-bug-report-target="dialog"
         tabindex="-1">
      <div class="min-h-0 overflow-y-auto px-6 py-5 space-y-4">
        <header class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-medium uppercase tracking-[0.35em] text-brand-primary/70 break-words" id="bug-report-modal-title">
              <%= t("bug_reports.widget.title") %>
            </p>
            <p class="mt-1 text-sm text-gray-600 break-words"><%= t("bug_reports.widget.intro") %></p>
          </div>
          <button type="button"
                  data-action="bug-report#close"
                  class="ml-3 flex shrink-0 items-center justify-center rounded-full p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-400"
                  aria-label="<%= t("bug_reports.widget.close") %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </header>

        <div id="bug_report_modal_body">
          <%= render "bug_reports/form" %>
        </div>
      </div>
    </div>
  </div>
</div>
