<div class="py-8">
  <div class="page-container max-w-md">
    <div class="public-surface-bordered p-6 sm:p-8">
      <h1 class="text-2xl font-bold mb-4 text-gray-800">Revendiquer ma fiche adhérent</h1>
      
      <div class="mb-6 rounded-2xl border border-brand-primary/15 bg-brand-primary/5 p-4">
        <p class="text-sm text-brand-primary">
          Vous avez déjà une fiche adhérent au Circographe mais pas de compte web ?
          Entrez l'email de votre fiche pour la lier à votre compte.
        </p>
      </div>
      
      <%= form_with url: account_claims_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :email, "Email de votre fiche adhérent", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email,
                            required: true,
                            placeholder: "john@example.com",
                            class: "auth-field" %>
          <p class="text-xs text-gray-500 mt-1">
            L'email utilisé pour les communications du Circographe
          </p>
        </div>
        
        <%= f.submit "Revendiquer ma fiche",
                     class: "w-full btn-primary justify-center rounded-lg shadow-lg" %>
      <% end %>
      
      <div class="mt-6 text-sm text-gray-600">
        <p class="font-semibold mb-2">Comment ça marche ?</p>
        <ol class="list-decimal list-inside space-y-1 text-xs">
          <li>Entrez l'email de votre fiche adhérent</li>
          <li>Nous vous envoyons un email de confirmation</li>
          <li>Cliquez sur le lien (valable 24h)</li>
          <li>Votre historique est lié à votre compte</li>
        </ol>
      </div>
    </div>
  </div>
</div>
