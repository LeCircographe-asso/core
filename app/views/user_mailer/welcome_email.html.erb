<h1 style="font-size: 22px; color: #1F5C55; margin: 0 0 16px;"><%= t("mailers.user_mailer.welcome_email.title") %></h1>
<p><%= t("mailers.user_mailer.welcome_email.greeting", name: @user.full_name.presence || t("mailers.user_mailer.welcome_email.fallback_name")) %></p>
<p><%= t("mailers.user_mailer.welcome_email.intro") %></p>

<%= render "membership_info", membership: @membership, member_number: @user.person&.member_number %>

<p>
  <a href="<%= @url %>" style="display: inline-block; background: #1F5C55; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none;"><%= t("mailers.user_mailer.welcome_email.cta") %></a>
</p>

<% if @user.newsletter_subscribed && @unsubscribe_url %>
  <p style="font-size: 13px; color: #6b7280;">
    <%= t("mailers.user_mailer.newsletter.subscribed") %>
    <a href="<%= @unsubscribe_url %>" style="color: #6b7280;"><%= t("mailers.user_mailer.newsletter.unsubscribe") %></a>
  </p>
<% end %>

<p><%= t("mailers.user_mailer.signature") %></p>
