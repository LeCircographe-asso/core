<% content_for :title, t("users.space.page_title") %>

<div class="max-w-6xl mx-auto px-4 sm:px-0 w-full pb-12">
  <header class="mb-5 flex items-center justify-between gap-3">
    <h1 class="text-xl sm:text-2xl font-semibold text-gray-900">
      <%= t("users.space.page_title") %>
    </h1>
    <p class="text-xs sm:text-sm text-gray-500 text-right">
      <%= t("users.space.quick_hint") %>
    </p>
  </header>

  <section id="overview" class="scroll-mt-28 mb-6">
    <%= render "shared/membershipcard",
        show_account_settings_link: false,
        wrapper_classes: "max-w-none mb-0" %>
  </section>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <section id="contact" class="scroll-mt-28" aria-labelledby="heading-contact">
      <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden h-full">
        <header class="px-4 sm:px-5 py-3 border-b border-gray-200 bg-gray-50">
          <h2 id="heading-contact" class="text-base font-semibold text-gray-900">
            <%= t("users.space.contact_heading") %>
          </h2>
          <p class="text-xs text-gray-500 mt-1"><%= t("users.space.contact_intro") %></p>
        </header>
        <div class="px-4 sm:px-5 py-4">
          <%= render "coordinates_form" %>
        </div>
      </div>
    </section>

    <section id="account" class="scroll-mt-28">
      <%= render "settings/account_panel", user: @user, embedded: true, compact: true %>
    </section>
  </div>
</div>
