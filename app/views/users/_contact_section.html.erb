<% user = local_assigns.fetch(:user, @user) %>
<% frame_id = local_assigns.fetch(:frame_id, ProfileSectionDomIds::CONTACT_SECTION) %>
<% contact_error_fields = %i[phone address zip_code town country] %>
<% contact_errors = user.errors.attribute_names.any? { |name| contact_error_fields.include?(name) } %>

<%= turbo_frame_tag frame_id do %>
  <section id="contact" class="scroll-mt-28" aria-labelledby="heading-contact">
    <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden h-full"
         data-controller="section-edit"
         data-section-edit-editing-value="<%= contact_errors %>"
         data-section-edit-warning-message-value="<%= t("users.space.unsaved_changes_warning") %>">
      <header class="px-4 sm:px-5 py-3 border-b border-gray-200 bg-gray-50">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="heading-contact" class="text-base font-semibold text-gray-900">
              <%= t("users.space.contact_heading") %>
            </h2>
            <p class="text-xs text-gray-500 mt-1"><%= t("users.space.contact_intro") %></p>
          </div>
          <button type="button"
                  data-section-edit-target="editButton"
                  data-action="section-edit#startEdit"
                  class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <%= t("users.space.edit") %>
          </button>
          <button type="button"
                  data-section-edit-target="cancelButton"
                  data-action="section-edit#cancelEdit"
                  class="hidden items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <%= t("users.space.cancel") %>
          </button>
        </div>
      </header>
      <div class="px-4 sm:px-5 py-4">
        <div data-section-edit-target="read" class="grid gap-3 text-sm">
          <div class="flex justify-between gap-3 border-b border-gray-100 pb-2">
            <span class="text-gray-500"><%= t("users.space.field_phone") %></span>
            <span class="font-medium text-gray-800"><%= user.phone.presence || "-" %></span>
          </div>
          <div class="flex justify-between gap-3 border-b border-gray-100 pb-2">
            <span class="text-gray-500"><%= t("users.space.field_address") %></span>
            <span class="font-medium text-gray-800"><%= user.address.presence || "-" %></span>
          </div>
          <div class="flex justify-between gap-3 border-b border-gray-100 pb-2">
            <span class="text-gray-500"><%= t("users.space.field_zip") %></span>
            <span class="font-medium text-gray-800"><%= user.zip_code.presence || "-" %></span>
          </div>
          <div class="flex justify-between gap-3 border-b border-gray-100 pb-2">
            <span class="text-gray-500"><%= t("users.space.field_town") %></span>
            <span class="font-medium text-gray-800"><%= user.town.presence || "-" %></span>
          </div>
          <div class="flex justify-between gap-3">
            <span class="text-gray-500"><%= t("users.space.field_country") %></span>
            <span class="font-medium text-gray-800"><%= user.country.presence || "-" %></span>
          </div>
        </div>

        <div data-section-edit-target="edit" class="hidden">
          <%= render "users/coordinates_form",
              user: user,
              form_class: "space-y-5",
              submit_class: "w-full inline-flex justify-center py-2.5 px-5 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#1F5C55] hover:bg-[#1F5C55]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55] transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
