<% chip = "inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 hover:border-[#1F5C55] hover:text-[#1F5C55] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-[#1F5C55]" %>
<% chip_dev = "#{chip} border-amber-200 text-amber-900 hover:border-amber-400 hover:text-amber-950 focus:ring-amber-400" %>

<div class="max-w-2xl mx-auto mb-4 px-4 sm:px-0 w-full">
  <div class="rounded-xl border border-gray-200 bg-white/95 px-4 py-3 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">
      <%= t("users.show.shortcuts_title") %>
    </p>
    <nav class="flex flex-wrap gap-2" aria-label="<%= t("users.show.shortcuts_title") %>">
      <%= link_to t("users.show.shortcut_home"), root_path, class: chip %>
      <%= link_to t("users.show.shortcut_edit_profile"), edit_user_path(@user), class: chip %>
      <%= link_to t("views.shared.navbar.settings"), settings_path, class: chip %>
      <%= link_to t("views.shared.navbar.activities"), page_path("news"), class: chip %>
      <%= link_to t("views.shared.navbar.contact"), page_path("contact_us"), class: chip %>
      <%= link_to t("views.shared.navbar.faq"), page_path("faq"), class: chip %>
      <% if dev_quick_login_nav_visible? %>
        <%= link_to t("dev.quick_login.nav_link"), dev_quick_login_path, class: chip_dev %>
      <% end %>
    </nav>
  </div>
</div>
