<% content_for :title, "Le Circographe – #{@event.title}" %>

<div class="page-container mb-16 fade-in">
  <div class="mb-5">
    <%= link_to page_path("news", anchor: "evenements"),
          class: "inline-flex items-center gap-2 text-sm font-medium text-brand-primary/80 hover:text-brand-primary transition-colors" do %>
      <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>
      Retour aux événements
    <% end %>
  </div>

  <%= turbo_stream_from @event %>

  <article class="public-surface-bordered overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_3fr]">

      <div class="relative aspect-[4/3] md:aspect-auto overflow-hidden bg-gray-100 md:min-h-[28rem]">
        <%= image_tag(
              @event.picture_url.presence || hero_image("event_show_#{@event.id}".to_sym),
              alt: @event.title,
              class: "w-full h-full object-cover"
            ) %>
      </div>

      <div class="flex flex-col gap-5 p-6 sm:p-8">

        <div class="space-y-2">
          <span class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-amber-800">
            Démo UX/UI · événement fictif
          </span>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug"><%= @event.title %></h1>
        </div>

        <% event_time = @event.date&.in_time_zone(Time.zone) %>
        <div class="flex flex-col gap-2 text-sm text-gray-600">
          <% if event_time.present? %>
            <div class="inline-flex items-center gap-2.5">
              <i class="far fa-clock w-4 text-center text-brand-primary" aria-hidden="true"></i>
              <span><%= l(event_time, format: "%A %d %B %Y à %H:%M") %></span>
            </div>
          <% end %>
          <% if @event.location.present? %>
            <div class="inline-flex items-center gap-2.5">
              <i class="fas fa-location-dot w-4 text-center text-brand-primary" aria-hidden="true"></i>
              <span><%= @event.location %></span>
            </div>
          <% end %>
          <%= render "events/interest_count", event: @event, count: @event.people.count %>
        </div>

        <% descriptions = [@event.upper_description, @event.middle_description, @event.bottom_description, @event.description].compact_blank %>
        <% if descriptions.any? %>
          <div class="flex-1 space-y-3 text-sm text-gray-700 leading-relaxed">
            <% descriptions.each do |desc| %>
              <p><%= desc %></p>
            <% end %>
          </div>
        <% end %>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 mt-auto">
          <div class="flex-1">
            <% if current_user %>
              <%= render "events/interest_button" %>
            <% else %>
              <%= link_to new_session_path, class: "public-cta block w-full text-center" do %>
                <i class="fas fa-heart mr-2" aria-hidden="true"></i>
                Se connecter pour marquer son intérêt
              <% end %>
            <% end %>
          </div>
        </div>

      </div>
    </div>
  </article>
</div>
