<div class="relative min-h-screen overflow-hidden bg-white lg:flex">
    <!-- Background image in mobile version -->
    <div class="lg:hidden absolute inset-0 z-0 opacity-20">
        <%= image_tag("about.jpg", alt: "", class: "w-full h-full object-cover") %>
    </div>
    
    <!-- Image section (left) - visible only on desktop-->
    <div class="hidden overflow-hidden lg:block lg:w-1/2">
        <div class="h-full w-full">
            <%= image_tag("about.jpg", alt: "Circographe Image", class: "w-full h-full object-cover") %>
        </div>
    </div>

    <!-- Form section (right) -->
    <div class="relative z-10 flex w-full items-center justify-center px-4 py-8 lg:w-1/2 lg:px-6">
        <div class="public-surface-bordered w-full max-w-md p-5 sm:p-6">
            <div class="text-center mb-4">
                <h1 class="text-2xl font-bold text-gray-700">Se connecter</h1>
            </div>

            <%= form_with url: session_url, class: "signup-form space-y-4", data: { turbo: false } do |form| %>
            <!-- Email field -->
            <div>
                <label for="email_address" class="block mb-2 text-sm text-gray-800">Adresse Email</label>
                <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "jean@example.com", value: params[:email_address], id: "email_address", class: "auth-field" %>
            </div>

            <!-- Password Field -->
            <div class="relative" data-controller="password">
                <div class="flex justify-between mb-2">
                    <label for="password" class="text-sm text-gray-800">Mot de passe</label>
                    <%= link_to "Mot de passe oublié ?", new_password_path, class: "text-sm text-gray-400 hover:text-brand-accent hover:underline focus:outline-brand-accent outline-offset-1" %>
                </div>
                <%= form.password_field :password, required: true, placeholder: "Mot de passe", maxlength: 72, id: "password", class: "auth-field password-field" %>
                <span class="toggle-password absolute inset-y-0 right-0 flex items-center pr-3 mt-7" data-action="click->password#toggle">
                    <i class="fa fa-eye text-gray-500" id="password-icon"></i>
                </span>
            </div>

            <!-- Submit button -->
            <div>
                <%= form.submit "Se connecter", class: "w-full btn-primary justify-center rounded-lg shadow-lg" %>
            </div>

            <!-- Register Link -->
            <div class="text-center">
                <% if public_registration_enabled? %>
                  <%= link_to t("sessions.new.sign_up_prompt"), new_registration_path, class: "text-sm text-gray-400 hover:text-brand-accent hover:underline focus:outline-brand-accent outline-offset-1" %>
                <% else %>
                  <p class="text-sm text-gray-500"><%= t("sessions.new.registration_closed_hint") %></p>
                <% end %>
            </div>
            
            <% if account_claim_enabled? %>
            <!-- Lien revendication de compte -->
            <div class="text-center mt-2">
                  <p class="text-sm text-gray-600">
                    <%= t("sessions.new.account_claim_lead") %>
                    <%= link_to t("sessions.new.account_claim_recover_link"), new_account_claim_path,
                                class: "text-brand-primary hover:underline font-medium" %>
                  </p>
            </div>
            <% end %>
            <% end %>
        </div>
    </div>
</div>
