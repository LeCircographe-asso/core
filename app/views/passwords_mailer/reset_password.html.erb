  <div class="email-container">
    <div class="header">
      Reset Your Password
    </div>
    <div class="content">
      <p>
        You requested a password reset. You can reset your password within the next 15 minutes by clicking the button below:
      </p>
      <p>
        <a href="<%= edit_password_url(@user.password_reset_token) %>" class="button">Reset Password</a>
      </p>
      <p>
        If you did not request a password reset, please ignore this email.
      </p>
    </div>
    <div class="footer">
      <p>Thank you,<br>
      The Support Team.</p>
    </div>
  </div>
</body>
</html>
