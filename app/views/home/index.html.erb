<% content_for :title, "Le Circographe - Accueil" %>
<% content_for :background_image, "background.webp" %>

<div class="relative w-full" data-home-animations-scope>
  <section class="relative flex min-h-[calc(100dvh-3.6rem)] w-full flex-col items-center justify-start px-4 pt-[4.5rem] pb-16 text-center sm:min-h-[calc(100dvh-4.2rem)] sm:px-6 sm:pt-28 sm:pb-20 md:px-10 md:pt-[min(7.5rem,13vh)] lg:px-12">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/60 via-black/35 to-black/10"></div>

    <div class="relative flex w-full max-w-full min-w-0 flex-col items-center gap-5 -translate-y-3 sm:gap-7 sm:-translate-y-8 md:gap-8">
      <p class="hero-kicker w-full max-w-full px-2 opacity-0 text-xs font-semibold uppercase leading-normal tracking-[0.2em] text-white/75 text-shadow-hero [overflow-wrap:anywhere] sm:px-0 sm:text-sm sm:tracking-[0.38em]">
        Toulouse · Cirque · Atelier · Vie associative
      </p>
      <h1 id="title" class="home-hero-title font-circographe w-full max-w-[min(100%,52rem)] min-w-0 whitespace-normal break-words text-[clamp(2.75rem,9vw+1rem,6rem)] font-bold text-white max-sm:tracking-[0.02em] tracking-[0.05em] md:tracking-[0.07em] leading-[1.05] sm:leading-[1.06] opacity-0 transition-opacity duration-500 text-shadow-hero">
        <span class="home-hero-title-word">Le</span>
        <span class="home-hero-title-word">Circographe</span>
      </h1>
      <p class="hero-intro max-w-[min(100%,30rem)] px-2 text-sm leading-normal text-white/90 opacity-0 sm:px-0 sm:text-base md:text-lg">
        Un lieu vivant pour s'entraîner et se rencontrer.
      </p>
    </div>

    <div class="main-button relative mt-8 flex w-full max-w-sm flex-col items-stretch gap-3 opacity-0 transition-opacity duration-500 sm:mt-10 sm:max-w-none sm:flex-row sm:items-center sm:justify-center">
      <%= link_to "Découvrir l'association", page_path('association'),
                  class: "inline-flex w-full min-w-0 items-center justify-center rounded-full border-2 border-white/60 bg-white/18 px-5 py-3 text-base font-medium text-white shadow-md backdrop-blur-sm transition-colors duration-300 hover:border-[#1F5C55] hover:bg-[#1F5C55] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1F5C55] sm:w-auto sm:min-w-[15rem] sm:px-8 sm:py-4 sm:text-lg" %>
      <%= link_to "Voir les horaires", "#opening-hours",
                  class: "inline-flex w-full min-w-0 items-center justify-center rounded-full border-2 border-white/60 bg-white/10 px-5 py-3 text-base font-medium text-white backdrop-blur-sm transition-colors duration-300 hover:border-[#5836A5] hover:bg-[#5836A5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5836A5] sm:w-auto sm:min-w-[15rem] sm:px-8 sm:py-4 sm:text-lg" %>
    </div>

    <%= render "shared/scroll_hint_arrow", section_id: "opening-hours", position_class: "absolute bottom-6 left-1/2 -translate-x-1/2 sm:bottom-28 md:bottom-32" %>

  </section>

  <section class="w-full px-4 sm:px-6 lg:px-8 flex justify-center">
    <div id="main-content" class="w-full max-w-5xl space-y-12 mt-12 sm:mt-16 transition-opacity duration-500">
      <section class="relative bg-transparent" aria-labelledby="community-highlights">
        <h2 id="community-highlights" class="sr-only">Informations clés</h2>

        <div class="grid gap-8 lg:gap-10 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] items-start" data-gsap-reveal>
          <article class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-[#0C2F2B] via-[#194A45] to-brand-primary text-white shadow-2xl p-5 sm:p-8 lg:p-10" data-gsap-reveal-item>
            <header class="space-y-2 sm:space-y-3 text-center lg:text-left">
              <p class="text-sm leading-normal uppercase tracking-[0.35em] text-white/75">Horaires</p>
              <h2 id="opening-hours" class="text-xl sm:text-3xl font-semibold leading-normal">Quand passer nous voir ?</h2>
              <p class="text-sm sm:text-base text-white/80 max-w-2xl mx-auto lg:mx-0 leading-normal">
                Retrouve les créneaux d'accueil de la semaine et prépare ta prochaine visite au Circographe.
              </p>
            </header>

            <div class="mt-4 sm:mt-7 bg-white/95 text-gray-900 rounded-[20px] shadow-xl p-4 sm:p-6">
              <%= render "shared/opening_hours", schedule: @opening_hours, table: true, compact: true, show_freshness: true %>
            </div>

            <section class="relative mt-4 rounded-[20px] border border-white/20 bg-white/10 p-4 text-left shadow-lg backdrop-blur-sm"
                     data-controller="pwa-install"
                     data-pwa-install-target="container"
                     hidden>
              <button type="button"
                      class="absolute top-3 right-3 text-white/40 hover:text-white/70 transition-colors rounded p-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
                      data-action="pwa-install#dismiss"
                      aria-label="Fermer la suggestion">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.75.75 0 1 1 1.06 1.06L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"/>
                </svg>
              </button>
              <p class="text-xs leading-normal uppercase tracking-[0.32em] text-white/70">Accès rapide</p>
              <h3 class="mt-2 text-lg font-semibold text-white">Ajoute Le Circographe à ton écran d'accueil</h3>
              <p class="mt-2 text-sm leading-6 text-white/85">
                Pratique pour retrouver les horaires, l'accès et les infos utiles en un tap.
              </p>
              <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
                <button type="button"
                        class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-[#194A45] transition-colors duration-300 hover:bg-[#F7F4EE]"
                        data-action="pwa-install#install"
                        data-pwa-install-target="button">
                  Installer l'application
                </button>
                <p class="text-xs leading-5 text-white/70" data-pwa-install-target="status">
                  Disponible quand ton navigateur autorise l'installation.
                </p>
              </div>
              <div class="mt-4 rounded-2xl bg-white/12 p-3 text-sm leading-6 text-white/90"
                   data-pwa-install-target="iosHelp"
                   hidden>
                Sur iPhone : ouvre le menu Partager puis choisis <strong>Sur l'écran d'accueil</strong>.
              </div>
            </section>
          </article>

          <div class="flex flex-col gap-5" data-gsap-reveal-item>
            <turbo-frame id="events_upcoming" loading="lazy" src="<%= upcoming_events_path %>" class="block">
          <%= render "home/upcoming_events", events: @upcoming_events %>
        </turbo-frame>
            <div class="text-center">
              <%= link_to page_path("association", anchor: "fonctionnement"),
                          class: "public-cta-pill" do %>
                Découvrir l'autogestion & le bénévolat
              <% end %>
            </div>
          </div>
        </div>
      </section>
      <section class="public-surface p-6 sm:p-8 space-y-4 text-center" aria-labelledby="find-us">
        <h2 id="find-us" class="text-sm font-medium leading-normal uppercase tracking-[0.3em] text-brand-primary/70">Nous trouver</h2>
        <address class="not-italic text-2xl font-semibold text-gray-800">97 bis Boulevard de Suisse, 31200 Toulouse</address>
        <p class="text-gray-600 max-w-2xl mx-auto">Entraînements libres, murs illustrés par les artistes du lieu et une ambiance chaleureuse : passe quand tu veux, on t’accueille avec plaisir.</p>
        <%= link_to "Voir la carte et l'accès", page_path("contact_us", anchor: "map"),
                    class: "public-cta-pill" %>
      </section>
    </div>
  </section>

  <div class="h-16 sm:h-24"></div>
</div>

<style nonce="<%= content_security_policy_nonce %>">
  #title {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
  }
</style>
