<% content_for :title, "Le Circographe - Accueil" %>
<% content_for :background_image, "background_temp.webp" %>

<div class="relative w-full">
  <section class="relative w-full min-h-[calc(100dvh-3.6rem)] sm:min-h-[calc(100dvh-4.2rem)] flex flex-col items-center justify-center text-center px-4 sm:px-6 pt-20 sm:pt-24 pb-12">
    <div class="flex flex-col items-center gap-8 sm:gap-9 -translate-y-6 sm:-translate-y-10">
      <h1 id="title" class="font-circographe text-5xl sm:text-6xl md:text-7xl font-bold text-white tracking-[0.08em] leading-tight opacity-0 transition-opacity duration-500">Le Circographe</h1>

      <div class="main-button opacity-0 transition-opacity duration-500">
        <%= link_to "Découvrir l'association", page_path('association'),
                    class: "px-6 sm:px-8 py-3 sm:py-4 text-lg sm:text-xl font-semibold text-gray-800 bg-white/95 border border-white/80 rounded-full hover:bg-white shadow-md transition" %>
      </div>
    </div>

    <%= render "shared/scroll_hint_arrow", section_id: "main-content", position_class: "absolute bottom-10 sm:bottom-12 left-1/2 -translate-x-1/2" %>
  </section>

  <section class="w-full px-4 sm:px-6 lg:px-8 flex justify-center">
    <div id="main-content" class="w-full max-w-5xl space-y-12 mt-12 sm:mt-16 opacity-0 transition-opacity duration-500">
      <section class="relative bg-transparent" aria-labelledby="community-highlights">
        <h2 id="community-highlights" class="sr-only">Informations clés</h2>

        <div class="grid gap-8 lg:gap-10 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] items-start">
          <article class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-[#1F5C55] via-[#194A45] to-[#0C2F2B] text-white shadow-2xl p-6 sm:p-8 lg:p-10">
            <header class="space-y-3 text-center lg:text-left">
              <p class="text-sm uppercase tracking-[0.35em] text-white/75">Horaires</p>
              <h2 id="opening-hours" class="text-2xl sm:text-3xl font-semibold">Quand passer nous voir ?</h2>
              <p class="text-white/80 max-w-2xl mx-auto lg:mx-0">
                Retrouve les créneaux d'accueil de la semaine et prépare ta prochaine visite sous le chapiteau du Circographe.
              </p>
            </header>

            <div class="mt-6 sm:mt-7 bg-white/95 text-gray-900 rounded-[20px] shadow-xl p-5 sm:p-6">
              <%= render "shared/opening_hours", horaires: @opening_hours, bare: true %>
            </div>
          </article>

          <div class="flex flex-col gap-5">
            <turbo-frame id="events_upcoming" loading="lazy" src="<%= upcoming_events_path %>" class="block">
              <%= render "home/upcoming_events", events: @upcoming_events %>
            </turbo-frame>
            <p class="text-xs text-gray-500 text-center lg:text-left">
              Découvre plus d'activités dans l'onglet « Nos activités » si tu veux planifier ta venue à l'avance.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-4" aria-labelledby="find-us">
        <header class="text-center space-y-2">
          <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Nous trouver</p>
          <h2 id="find-us" class="text-2xl font-semibold text-gray-800">Le Circographe sur la carte</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Chapiteau, ateliers graphiques et convivialité : pousse la porte au 27 bis Allée Maurice Sarraut, Toulouse.</p>
        </header>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-inner">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d858.7320762106817!2d1.422364267936696!3d43.618639564522674!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12aebb1b7b5096ef%3A0x710f3096ea206f0!2sLe%20Circographe!5e0!3m2!1sfr!2sfr!4v1745437455061!5m2!1sfr!2sfr" width="100%" height="340" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>
    </div>
  </section>

  <div class="h-16 sm:h-24"></div>
</div>

<style>
  #title {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
  }
</style>



