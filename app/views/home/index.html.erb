<% content_for :title, "Le Circographe - Accueil" %>
<% content_for :background_image, "background.webp" %>

<div class="relative w-full" data-home-animations-scope>
  <section class="relative w-full min-h-[calc(100dvh-3.6rem)] sm:min-h-[calc(100dvh-4.2rem)] flex flex-col items-center justify-start px-4 sm:px-6 md:px-10 lg:px-12 pt-[4.5rem] sm:pt-28 md:pt-[min(7.5rem,13vh)] pb-16 sm:pb-20 text-center">
    <div class="flex w-full max-w-full min-w-0 flex-col items-center gap-5 sm:gap-7 md:gap-8 -translate-y-5 sm:-translate-y-8">
      <p class="hero-kicker opacity-0 text-xs font-semibold uppercase tracking-[0.38em] text-white/75 sm:text-sm">
        Toulouse · Cirque · Atelier · Vie associative
      </p>
      <h1 id="title" class="text-shadow-hero font-circographe w-full max-w-[min(100%,44rem)] min-w-0 whitespace-normal break-words text-[clamp(2.75rem,7vw+0.85rem,4.5rem)] font-bold text-white max-sm:tracking-[0.03em] tracking-[0.06em] md:tracking-[0.08em] leading-[1.08] max-sm:leading-[1.06] sm:leading-tight opacity-0 transition-opacity duration-500 [overflow-wrap:anywhere]">Le Circographe</h1>
      <p class="hero-intro max-w-[min(100%,30rem)] text-pretty px-2 text-sm leading-6 text-white/90 opacity-0 sm:px-0 sm:text-base md:text-lg">
        Un lieu vivant pour s'entraîner et se rencontrer.
      </p>

      <div class="main-button home-hero-actions">
      <%= link_to "Découvrir l'association", page_path('association'),
                  class: "home-hero-action home-hero-action--primary" %>
      <%= link_to "Nous trouver", page_path("contact_us", anchor: "map"),
                  class: "home-hero-action home-hero-action--secondary" %>
      </div>
    </div>

    <%= render "shared/scroll_hint_arrow", section_id: "main-content", position_class: "absolute bottom-24 sm:bottom-28 md:bottom-32 left-1/2 -translate-x-1/2" %>
  </section>

  <section class="w-full px-4 sm:px-6 lg:px-8 flex justify-center">
    <div id="main-content" class="w-full max-w-5xl space-y-12 mt-12 sm:mt-16 transition-opacity duration-500">
      <section class="relative bg-transparent" aria-labelledby="community-highlights">
        <h2 id="community-highlights" class="sr-only">Informations clés</h2>

        <div class="grid gap-8 lg:gap-10 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] items-start" data-gsap-reveal>
          <article class="home-hours-card" data-gsap-reveal-item>
            <header class="space-y-2 sm:space-y-3 text-center lg:text-left">
              <p class="text-sm uppercase tracking-[0.35em] text-white/75">Horaires</p>
              <h2 id="opening-hours" class="scroll-mt-24 sm:scroll-mt-28 text-xl sm:text-3xl font-semibold leading-snug">Quand passer nous voir ?</h2>
              <p class="text-sm sm:text-base text-white/80 max-w-2xl mx-auto lg:mx-0 leading-snug">
                Retrouve les créneaux d'accueil de la semaine et prépare ta prochaine visite au Circographe.
              </p>
            </header>

            <div class="home-hours-card__panel">
              <%= render "shared/opening_hours", horaires: @opening_hours, bare: true, compact: true %>
            </div>

            <section class="home-pwa-panel"
                     data-controller="pwa-install"
                     data-pwa-install-target="container"
                     hidden>
              <p class="home-pwa-panel__eyebrow">Accès rapide</p>
              <h3 class="home-pwa-panel__title">Ajoute Le Circographe à ton écran d'accueil</h3>
              <p class="home-pwa-panel__copy">
                Pratique pour retrouver les horaires, l'accès et les infos utiles en un tap.
              </p>
              <div class="home-pwa-panel__actions">
                <button type="button"
                        class="home-pwa-panel__button"
                        data-action="pwa-install#install"
                        data-pwa-install-target="button">
                  Installer l'application
                </button>
                <p class="home-pwa-panel__status" data-pwa-install-target="status">
                  Disponible quand ton navigateur autorise l'installation.
                </p>
              </div>
              <div class="home-pwa-panel__ios-help"
                   data-pwa-install-target="iosHelp"
                   hidden>
                Sur iPhone : ouvre le menu Partager puis choisis <strong>Sur l'écran d'accueil</strong>.
              </div>
            </section>
          </article>

          <div class="flex flex-col gap-5" data-gsap-reveal-item>
            <turbo-frame id="events_upcoming" loading="lazy" src="<%= upcoming_events_path %>" class="block">
          <%= render "home/upcoming_events", events: @upcoming_events %>
        </turbo-frame>
          </div>
        </div>
      </section>

        <div class="text-center">
          <%= link_to page_path("association", anchor: "fonctionnement"),
                      class: "public-cta-pill" do %>
            Découvrir l'autogestion & le bénévolat
          <% end %>
        </div>
      <section class="public-surface p-6 sm:p-8 space-y-4 text-center" aria-labelledby="find-us">
        <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Nous trouver</p>
        <h2 id="find-us" class="text-2xl font-semibold text-gray-800">97 bis Boulevard de Suisse, 31200 Toulouse</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Entraînements libres, murs illustrés par les artistes du lieu et une ambiance chaleureuse : passe quand tu veux, on t’accueille avec plaisir.</p>
        <%= link_to "Voir la carte et l'accès", page_path("contact_us", anchor: "map"),
                    class: "public-cta-pill" %>
      </section>
    </div>
  </section>

  <div class="h-16 sm:h-24"></div>
</div>
