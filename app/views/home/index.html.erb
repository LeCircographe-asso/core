<% content_for :title, "Le Circographe - Accueil" %>

<!-- Main container - removed min-h-screen to allow the footer to display -->
<div class="relative overflow-x-hidden overflow-y-auto w-full">

    <!-- The main content -->
    <div id="content" class="relative w-full flex flex-col items-center justify-start text-center px-4 sm:px-6">

        <!-- Large empty space at the top -->
        <div class="h-45"></div>

        <!-- Main title - with plenty of space above -->
        <h1 id="title" class="text-3xl sm:text-4xl md:text-5xl font-bold text-white opacity-0 transition-opacity duration-500 mx-4 break-words bg-black/80">Le Circographe</h1>

        <!-- Large space between title and button -->
        <div class="h-64"></div>

        <!-- Button with large space after the title -->
        <div class="main-button opacity-0 transition-opacity duration-500">
            <%= link_to "Découvrir l'association", page_path('association'),
                class: "px-8 py-4 text-xl font-semibold text-gray-800 bg-white border border-gray-300 rounded-full hover:bg-gray-100 shadow-md" %>
        </div>

        <!-- Animated arrow scrolling to main content -->
        <div class="mt-20 opacity-0 transition-opacity duration-500 scroll-arrow-container">
            <a href="#main-content" class="scroll-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-10 h-10 text-white">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </a>
        </div>

        <!-- Very large space before the cards, but not excessive -->
        <div class="h-64"></div>

        <!-- Contents section (very low on the page) -->
        <div id="main-content" class="grid grid-cols-1 md:grid-cols-2 gap-32 max-w-4xl mb-24 opacity-0 transition-opacity duration-500">

            <!-- Article (without white background) -->
            <div class="p-4 flex flex-col">
                <%= render "shared/event_card", event: @events.last if @events.present? %>
            </div>

            <!-- Schedules -->
            <div>
                <% @horaires = Rails.cache.fetch("opening_hours") || OpeningHoursHelper.default_opening_hours %>
                <%= render 'shared/opening_hours' %>
            </div>
        </div>
            <div class="flex justify-center items-center w-full p-4 map opacity-0 transition-opacity duration-500" id="map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d858.7320762106817!2d1.422364267936696!3d43.618639564522674!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12aebb1b7b5096ef%3A0x710f3096ea206f0!2sLe%20Circographe!5e0!3m2!1sfr!2sfr!4v1745437455061!5m2!1sfr!2sfr" width="800" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        <!-- Extra space before the footer to ensure there is a margin -->
        <div class="h-24"></div>
    </div>
</div>



