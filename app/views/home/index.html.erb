<% content_for :title, "Le Circographe - Accueil" %>

<!-- Conteneur principal - retiré min-h-screen pour permettre au footer de s'afficher -->
<div class="relative overflow-auto">

    <!-- Le contenu principal -->
    <div id="content" class="relative w-full flex flex-col items-center justify-start text-center">

        <!-- Grand espace vide en haut -->
        <div class="h-72"></div>

        <!-- Titre principal - avec beaucoup d'espace au-dessus -->
        <h1 id="title" class="text-5xl font-bold text-black opacity-0 transition-opacity duration-500">Le Circographe</h1>

        <!-- Grand espace entre le titre et le bouton -->
        <div class="h-64"></div>

        <!-- Bouton avec grand espace après le titre -->
        <div class="main-button opacity-0 transition-opacity duration-500">
            <%= link_to "Découvrir l'association", page_path('association'),
                class: "px-8 py-4 text-xl font-semibold text-gray-800 bg-white border border-gray-300 rounded-full hover:bg-gray-100 shadow-md" %>
        </div>

        <!-- Flèche animée qui défile vers le contenu principal -->
        <div class="mt-20 opacity-0 transition-opacity duration-500 scroll-arrow-container">
            <a href="#main-content" class="scroll-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-10 h-10 text-white">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </a>
        </div>

        <!-- Très grand espace avant les cartes, mais pas excessif -->
        <div class="h-64"></div>

        <!-- Section des contenus (très bas sur la page) -->
        <div id="main-content" class="grid grid-cols-1 md:grid-cols-2 gap-32 max-w-4xl mb-24 opacity-0 transition-opacity duration-500">

            <!-- Article (sans background blanc) -->
            <div class="p-4 flex flex-col">
                <%= render "shared/event_card", event: @events.last if @events.present? %>
            </div>

            <!-- Horaires -->
            <div>
                <% @horaires = begin
                    Rails.cache.fetch("opening_hours") || 
                    (defined?(OpeningHoursHelper.default_opening_hours) ? 
                      OpeningHoursHelper.default_opening_hours : 
                      { lundi: "Fermé", mardi: "14:00 - 22:00", mercredi: "14:00 - 22:00", jeudi: "14:00 - 22:00", vendredi: "14:00 - 22:00", samedi: "14:00 - 22:00", dimanche: "14:00 - 22:00" })
                   rescue => e
                     Rails.logger.error("Erreur lors de la récupération des horaires: #{e.message}")
                     { lundi: "Fermé", mardi: "14:00 - 22:00", mercredi: "14:00 - 22:00", jeudi: "14:00 - 22:00", vendredi: "14:00 - 22:00", samedi: "14:00 - 22:00", dimanche: "14:00 - 22:00" }
                   end
                %>
                <%= render 'shared/table' %>
            </div>
        </div>
        
        <!-- Espace supplémentaire avant le footer pour s'assurer qu'il y a une marge -->
        <div class="h-24"></div>
    </div>
</div>



