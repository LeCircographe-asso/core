<% content_for :title, "Le Circographe - Accueil" %>

<!-- Conteneur principal -->
<div class="relative min-h-screen overflow-auto">

    <!-- Le contenu principal -->
    <div id="content" class="relative w-full flex flex-col items-center justify-start text-center h-full">

        <!-- Titre principal -->
        <h1 id="title" class="text-5xl font-bold text-white mt-16 mb-12 opacity-0 transition-opacity duration-500">Le Circographe</h1>

        <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br />

        <!-- Bouton avec animation identique au titre -->
        <div class="mb-32 main-button opacity-0 transition-opacity duration-500">
            <%= link_to "Découvrir l'association", page_path('association'),
                class: "px-8 py-4 text-xl font-semibold text-gray-800 bg-white border border-gray-300 rounded-full hover:bg-gray-100 shadow-md" %>
        </div>

        <!-- Section des contenus (initialement cachée) -->
        <div id="hidden-content" class="grid grid-cols-1 md:grid-cols-2 gap-32 max-w-4xl mt-32 opacity-0 transition-opacity duration-500">

            <!-- Article (sans background blanc) -->
            <div class="p-4 flex flex-col">
                <%= render "shared/event_card", event: @events.last if @events.present? %>
            </div>

            <!-- Horaires -->
            <div>
                <% @horaires = begin
                    Rails.cache.fetch("opening_hours") || 
                    (defined?(OpeningHoursHelper.default_opening_hours) ? 
                      OpeningHoursHelper.default_opening_hours : 
                      { lundi: "Fermé", mardi: "14:00 - 22:00", mercredi: "14:00 - 22:00", jeudi: "14:00 - 22:00", vendredi: "14:00 - 22:00", samedi: "14:00 - 22:00", dimanche: "14:00 - 22:00" })
                   rescue => e
                     Rails.logger.error("Erreur lors de la récupération des horaires: #{e.message}")
                     { lundi: "Fermé", mardi: "14:00 - 22:00", mercredi: "14:00 - 22:00", jeudi: "14:00 - 22:00", vendredi: "14:00 - 22:00", samedi: "14:00 - 22:00", dimanche: "14:00 - 22:00" }
                   end
                %>
                <%= render 'shared/table' %>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.getElementById('title').classList.remove('opacity-0');
        }, 500); // 1 seconde pour le titre

        setTimeout(function() {
            document.querySelector('.main-button').classList.remove('opacity-0');
        }, 1500); // 2.5 secondes pour le bouton

        setTimeout(function() {
            document.getElementById('hidden-content').classList.remove('opacity-0');
        }, 3000); // 5 secondes pour le reste du contenu
    });
</script>