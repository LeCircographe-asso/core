<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<%# Email clients ignore <style> blocks unevenly: keep styles inline. %>
<body style="margin: 0; padding: 0; background: #f5f5f4; font-family: Helvetica, Arial, sans-serif; color: #1f2937; line-height: 1.5;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f5f5f4;">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; background: #ffffff; border-radius: 8px; overflow: hidden;">
          <tr>
            <td style="background: #1F5C55; padding: 16px 24px;">
              <a href="<%= root_url %>" style="text-decoration: none; color: #ffffff; font-size: 18px; font-weight: bold;">
                <img src="<%= root_url %>icon.png" alt="" width="32" height="32" style="vertical-align: middle; border: 0; margin-right: 8px;">
                Le Circographe
              </a>
            </td>
          </tr>
          <tr>
            <td style="padding: 24px;">
              <%= yield %>
            </td>
          </tr>
          <tr>
            <td style="padding: 16px 24px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #6b7280;">
              <a href="<%= root_url %>" style="color: #1F5C55;">lecircographe.fr</a> ·
              <a href="mailto:contact@lecircographe.fr" style="color: #1F5C55;">contact@lecircographe.fr</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
