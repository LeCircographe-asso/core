<!DOCTYPE html>
<html lang="<%= I18n.locale %>">

<head>
    <title><%= content_for(:title) || t("layouts.application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Le Circographe, lieu de cirque vivant, d'entraînement, de rencontres et d'ateliers à Toulouse.">
    <meta name="theme-color" content="#1F5C55">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Circographe">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Leaflet : hors bundle Tailwind (@import après @layer = CSS invalide / carte miniature). %>
    <%= tag.link rel: "stylesheet",
                 href: "https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css",
                 crossorigin: "anonymous",
                 "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flowbite", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%# Removed legacy :app stylesheet link to avoid 404/preload issues %>
    <%= javascript_importmap_tags %>

    <!-- External services -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <%= javascript_include_tag "flowbite.turbo.min", "data-turbo-track": "reload" %>
</head>

<body class="<%= 'dyslexic-font-enabled' if current_user&.dyslexic_font %> <%= controller_name %>-<%= action_name %> flex flex-col min-h-[100dvh] leading-normal">

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#1F5C55] focus:shadow-md focus:ring-2 focus:ring-[#1F5C55]">Aller au contenu principal</a>

    <% if controller_path.start_with?('admin/') %>
    <div class="admin-layout" data-controller="sidebar">
        <%= render 'admin/dashboard/admin_lateral_navbar' %>
        <div class="admin-content" data-sidebar-target="content">
            <%= turbo_frame_tag ProfileSectionDomIds::FLASH_FRAME do %>
            <%= render 'shared/flash' %>
            <% end %>
            <main class="admin-main">
                <%= yield %>
            </main>
        </div>
    </div>

    <% elsif controller_name == 'sessions' && action_name == 'new' || controller_name == 'registrations' && action_name == 'new' || controller_name == 'pages' && action_name == 'terms' || controller_name == 'pages' && action_name == 'privacy_policy' %>
    
    <div class="flex h-[100dvh] flex-col w-full overflow-hidden">
        <header>
            <%= render 'shared/navbar' %>
        </header>
        <%= turbo_frame_tag ProfileSectionDomIds::FLASH_FRAME do %>
        <%= render 'shared/flash' %>
        <% end %>
        <main id="main-content" tabindex="-1" class="flex-1 min-h-0">
            <div class="h-full w-full" data-turbo-page-shell>
            <%= yield %>
            </div>
        </main>
    </div>
    
    <% else %>

    <% member_space_page = controller_name == 'users' && action_name == 'show' || controller_name == 'settings' %>
    <% unless member_space_page %>
    <style nonce="<%= content_security_policy_nonce %>">
      .public-bg-image {
        background-image: url('<%= asset_path(content_for(:background_image) || 'background.webp') %>');
        transform: translateZ(0);
        backface-visibility: hidden;
      }
    </style>
    <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat public-bg-image <%= controller_name == 'home' && action_name == 'index' ? 'home-mobile-background' : '' %>"></div>
    <% end %>
    <div class="fixed inset-0 -z-10 bg-white <%= 'hidden' unless member_space_page %>"></div>
    <header>
        <%= render 'shared/navbar' %>
    </header>
    <div class="flex-grow">
        <%= turbo_frame_tag ProfileSectionDomIds::FLASH_FRAME do %>
        <%= render 'shared/flash' %>
        <% end %>
        <main id="main-content" tabindex="-1" class="<%= controller_name == 'home' && action_name == 'index' ? 'w-full pt-0' : 'page-container space-y-6 pt-8' %>">
        <%# data-turbo-page-shell : transition GSAP au changement de page (turbo_page_reveal.js) %>
        <div class="w-full" data-turbo-page-shell>
            <%= yield %>
        </div>
        </main>
    </div>
    <%= render 'shared/footer' %>
    <% end %>

    <%= render 'shared/confirm_modal' %>
    <%= render 'shared/whatsapp_qr_modal' %>
    <%= render 'shared/bug_report_widget' if bug_report_widget_enabled? %>
    <%# PWA install banner — mobile only, hidden until controller shows it %>
    <% unless controller_path.start_with?('admin/') || (controller_name == 'sessions' && action_name == 'new') || (controller_name == 'registrations' && action_name == 'new') %>
      <%= render 'shared/pwa_install_banner' %>
    <% end %>
    <%= yield :scripts %>
</body>

</html>
