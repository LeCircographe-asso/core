<div class="signin-page">
    <div class="form-group">
        <h1 class="font-bold text-4xl">Réinitialiser votre mot de passe</h1>

        <%= form_with url: passwords_path, method: :post, local: true do |form| %>
        <div class="my-5">
            <%= form.label :email_address, "Adresse email", class: "font-medium" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Entrez votre adresse email", value: params[:email_address], class: "auth-field mt-2" %>
        </div>

        <div class="inline">
            <%= form.submit "Envoyer les instructions", class: "submit-button" %>
        </div>
        <% end %>
    </div>
</div>
