<% content_for :title, t("settings.show.page_title") %>

<div class="page-container max-w-xl pb-16 sm:px-0">
  <div class="mb-4">
    <%= link_to user_path(@user), class: "inline-flex items-center gap-1.5 text-sm font-medium text-[#1F5C55] hover:text-[#1F5C55]/80" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Mon espace
    <% end %>
  </div>
  <%= render "settings/account_section",
      user: @user,
      frame_id: ProfileSectionDomIds::ACCOUNT_SECTION,
      embedded: false,
      compact: false %>
</div>
