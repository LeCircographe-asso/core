<% content_for :title, "Le Circographe - Adhérer" %>

<section class="public-hero-shell mb-8">
  <%= image_tag hero_image(:become_member_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="hero-panel public-hero-panel-centered space-y-3 sm:space-y-4">
    <p class="public-hero-eyebrow">Rejoindre la communauté</p>
    <h1 class="public-hero-title">Adhérer au Circographe</h1>
    <p class="public-hero-body">Une rencontre sur place pour rejoindre la communauté, découvrir le lieu et la vie associative.</p>
  </div>
</section>

<%# Grid 2×2 — croix séparatrice, stagger CSS, pas d’accordéon %>
<section class="fade-in" id="tarifs">
  <div class="public-surface overflow-hidden">

    <%# ── Grille 2×2 ── %>
    <div class="grid grid-cols-1 md:grid-cols-2">

      <%# Q1 — Pourquoi adhérer (haut-gauche) %>
      <div class="tarif-quad space-y-3 p-6 sm:p-8 border-b md:border-r border-gray-200 bg-white">
        <div class="w-6 h-[3px] rounded-full bg-brand-primary mb-1"></div>
        <p class="text-xs font-medium uppercase tracking-[0.32em] text-brand-primary/70">Pourquoi adhérer ?</p>
        <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">Pratiquer, créer, s’entraider</h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-prose">
          Accès aux entraînements libres cirque, création graphique, temps d’accueil en création et programmation collective. Les bénévoles t’expliquent l’autogestion et t’aident à choisir tes créneaux.
        </p>
      </div>

      <%# Q2 — En résumé (haut-droite) %>
      <div class="tarif-quad space-y-4 p-6 sm:p-8 border-b border-gray-200 bg-brand-primary/7">
        <div class="w-6 h-[3px] rounded-full bg-brand-primary mb-1"></div>
        <p class="text-xs font-medium uppercase tracking-[0.32em] text-brand-primary/70">En résumé</p>
        <ul class="space-y-2.5">
          <% [
            "Entraînements libres cirque",
            "Ateliers & temps d’accueil en création (arts graphiques)",
            "Vie associative & bénévolat",
            "Communauté & partage de matériel"
          ].each do |item| %>
            <li class="flex items-start gap-2.5 text-sm text-gray-700">
              <svg class="shrink-0 mt-0.5 w-4 h-4 text-brand-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="8" cy="8" r="7.5" stroke="currentColor" stroke-opacity="0.3"/>
                <path d="M4.5 8L7 10.5L11.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span><%= item %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <%# Q3 — Types & tarifs (bas-gauche) %>
      <div class="tarif-quad space-y-4 p-6 sm:p-8 border-b md:border-b-0 md:border-r border-gray-200 bg-gray-50">
        <div class="w-6 h-[3px] rounded-full bg-gray-400 mb-1"></div>
        <p class="text-xs font-medium uppercase tracking-[0.32em] text-brand-primary/70">Adhésion annuelle</p>
        <h2 class="text-xl font-semibold text-gray-900">Types & tarifs</h2>

        <ul class="divide-y divide-gray-200 -mx-1">
          <li class="flex items-center justify-between gap-4 px-1 py-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-gray-800">Adhésion visiteur</span>
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700">don libre</span>
              </div>
              <p class="text-xs text-gray-500 mt-0.5 leading-normal">Temps ouverts · sans pratique.</p>
            </div>
            <span class="shrink-0 text-sm font-semibold text-gray-400 tabular-nums">
              <% if @visitor_membership_min_price_cents %>
                dès <%= number_to_currency(@visitor_membership_min_price_cents / 100.0, unit: "€", format: "%n %u", precision: 0) %>
              <% else %>
                —
              <% end %>
              <span class="font-normal text-xs text-gray-400"> / an</span>
            </span>
          </li>

          <li class="flex items-center justify-between gap-4 px-1 py-3">
            <div class="min-w-0">
              <span class="text-sm font-semibold text-gray-800">Adhésion cirque</span>
              <p class="text-xs text-gray-500 mt-0.5 leading-normal">Entraînements libres · date à date.</p>
              <% if (reduced = @circus_membership_types["reduced"]) %>
                <span class="inline-block mt-1 text-xs px-2 py-0.5 rounded-full border border-gray-200 text-gray-500">Tarif réduit — <%= number_to_currency(reduced.price_euros, unit: "€", format: "%n %u", precision: 0) %></span>
              <% end %>
            </div>
            <span class="shrink-0 text-sm font-semibold text-brand-primary tabular-nums">
              <% if (standard = @circus_membership_types["standard"]) %>
                <%= number_to_currency(standard.price_euros, unit: "€", format: "%n %u", precision: 0) %>
              <% else %>
                —
              <% end %>
              <span class="font-normal text-xs text-gray-400"> / an</span>
            </span>
          </li>

          <li class="flex items-center justify-between gap-4 px-1 py-3 opacity-50">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-gray-800">Adhésion événement</span>
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 border border-gray-200 text-gray-500">bientôt</span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5 leading-normal">Accès aux événements publics du lieu.</p>
            </div>
            <span class="shrink-0 text-xs text-gray-400">—</span>
          </li>
        </ul>

        <p class="text-xs text-gray-500 bg-brand-primary/5 border border-brand-primary/20 rounded-lg px-3 py-2 leading-normal">
          Paiement sur place — CB ou espèces. Reçu fiscal sur demande.
        </p>
      </div>

      <%# Q4 — Cotisations (bas-droite) %>
      <div class="tarif-quad space-y-4 p-6 sm:p-8 bg-brand-accent/4">
        <div class="w-6 h-[3px] rounded-full mb-1 bg-brand-accent"></div>
        <p class="text-xs font-medium uppercase tracking-[0.32em] text-brand-primary/70">Cotisations</p>
        <h2 class="text-xl font-semibold text-gray-900">Autogestion du lieu</h2>
        <p class="text-xs text-gray-500">Choisis la formule qui colle à ta pratique.</p>

        <% day_formula = @contribution_formulas["day"]
           pack10_formula = @contribution_formulas["pack10"]
           trimester_formula = @contribution_formulas["trimester"]
           annual_formula = @contribution_formulas["annual"] %>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center justify-between py-2 border-b border-gray-50">
            <span class="text-gray-600">Séance libre</span>
            <span class="font-semibold text-gray-800 tabular-nums"><%= day_formula ? number_to_currency(day_formula.price_euros, unit: "€", format: "%n %u", precision: 0) : "—" %></span>
          </li>
          <li class="flex items-center justify-between px-3 py-2 rounded-xl border border-[#5836A5]/20 bg-[#5836A5]/5">
            <div class="min-w-0">
              <span class="font-semibold text-gray-900">Carnet 10 séances</span>
              <span class="ml-2 text-xs font-medium px-1.5 py-0.5 rounded-full bg-[#5836A5]/10 text-[#5836A5]">Populaire</span>
              <p class="text-xs text-gray-500 mt-0.5">Sans expiration.</p>
            </div>
            <span class="font-bold text-[#5836A5] tabular-nums shrink-0 ml-3"><%= pack10_formula ? number_to_currency(pack10_formula.price_euros, unit: "€", format: "%n %u", precision: 0) : "—" %></span>
          </li>
          <li class="flex items-center justify-between py-2 border-b border-gray-50">
            <span class="text-gray-600">Trimestre (3 mois)</span>
            <span class="font-semibold text-gray-800 tabular-nums"><%= trimester_formula ? number_to_currency(trimester_formula.price_euros, unit: "€", format: "%n %u", precision: 0) : "—" %></span>
          </li>
          <li class="flex items-center justify-between px-3 py-2 rounded-xl border border-brand-primary/20 bg-brand-primary/5">
            <div class="min-w-0">
              <span class="font-semibold text-gray-900">Cotisation annuelle</span>
              <p class="text-xs text-gray-500 mt-0.5">Date à date.</p>
            </div>
            <span class="font-bold text-brand-primary tabular-nums shrink-0 ml-3"><%= annual_formula ? number_to_currency(annual_formula.price_euros, unit: "€", format: "%n %u", precision: 0) : "—" %></span>
          </li>
        </ul>
      </div>

    </div><%# /grid 2×2 %>

    <%# Bande "À retenir" %>
    <div class="tarif-note border-t border-gray-200 px-6 sm:px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-xs text-gray-600 leading-relaxed max-w-prose">
        <strong class="text-gray-800">À retenir :</strong> l’adhésion et la cotisation cirque sont deux paiements distincts. Les formules ci-dessus supposent une <strong>adhésion cirque</strong> active.
      </p>
      <%= link_to "Bénévolat & autogestion →", page_path("association", anchor: "fonctionnement"),
                  class: "shrink-0 text-xs font-semibold text-brand-primary hover:underline underline-offset-2 whitespace-nowrap" %>
    </div>

  </div>
</section>

<style nonce="<%= content_security_policy_nonce %>">
  .tarif-quad {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease-out, transform 0.45s ease-out;
  }
  .tarif-note {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  #tarifs.visible .tarif-quad   { opacity: 1; transform: translateY(0); }
  #tarifs.visible .tarif-note   { opacity: 1; transition-delay: 0.35s; }
  #tarifs.visible .tarif-quad:nth-child(1) { transition-delay: 0s; }
  #tarifs.visible .tarif-quad:nth-child(2) { transition-delay: 0.09s; }
  #tarifs.visible .tarif-quad:nth-child(3) { transition-delay: 0.18s; }
  #tarifs.visible .tarif-quad:nth-child(4) { transition-delay: 0.27s; }
</style>

<section class="mt-6 mb-8 fade-in" id="horaires">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-6 items-start">

    <%# FAQ — colonne gauche %>
    <%= render "shared/faq_section",
               id: "adhesion-faq",
               label: "Questions fréquentes",
               title: "Avant de te déplacer",
               subtitle: "Quelques repères pour préparer ton adhésion.",
               faqs: @avant_visite_faqs,
               footer: "Besoin d’un coup de main ? Écris-nous ou passe pendant un créneau d’ouverture.",
               card_class: "public-soft-section",
               header_align: "left" %>

    <%# Panneau latéral : Horaires + Accès dans une seule carte %>
    <% schedule = @opening_hours %>
    <div class="relative rounded-2xl border border-gray-100 bg-white shadow-sm overflow-hidden">
      <%= render "shared/exceptional_closure_ribbon" if @exceptional_closure&.in_effect? %>

      <%# ── En-tête horaires ── %>
      <div class="px-4 pt-4 pb-3 border-b border-gray-100">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-500 mb-1">Créneaux d’accueil</p>
        <div class="flex items-center justify-between gap-3">
          <p class="text-base font-bold text-gray-900 tabular-nums">
            <%= Date.current.beginning_of_week.day %>
            <span class="text-gray-400 font-normal">–</span>
            <%= Date.current.end_of_week.day %> <%= l(Date.current.end_of_week, format: "%B %Y") %>
          </p>
          <button type="button"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 text-xs font-semibold hover:bg-amber-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
                  data-controller="tooltip"
                  data-tooltip-content-value="Créneaux assurés par des bénévoles, susceptibles d’évoluer chaque semaine (généralement mis à jour le lundi soir). Vérifiez avant de vous déplacer.">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 shrink-0" aria-hidden="true">
              <path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" clip-rule="evenodd"/>
            </svg>
            Bénévoles
            <span class="sr-only">— créneaux volatils</span>
          </button>
        </div>
        <div class="mt-3 h-px tarif-divider-gradient"></div>
      </div>

      <%# ── Lignes jours ── %>
      <%= render "shared/opening_hours", schedule: schedule, show_freshness: true, closure: @exceptional_closure %>

      <%# ── Accès (intégré dans la même carte) ── %>
      <div class="border-t border-gray-100 px-4 py-4 space-y-3 bg-gray-50/60">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Accès</p>
        <div>
          <p class="text-sm font-semibold text-gray-900">97 bis bd de Suisse</p>
          <p class="text-sm text-gray-600">31200 Toulouse</p>
          <p class="text-xs text-gray-500 mt-0.5">Bus 15 Tisséo · boulevard de Suisse</p>
        </div>
        <div class="flex gap-2">
          <%= link_to "Carte & contact", page_path("contact_us", anchor: "map"),
                      class: "flex-1 inline-flex items-center justify-center px-3 py-2 text-sm font-semibold text-white bg-[#1F5C55] rounded-lg hover:bg-[#194A45] transition-colors" %>
          <%= link_to "Écrire", page_path("contact_us", anchor: "contact-form"),
                      class: "flex-1 inline-flex items-center justify-center px-3 py-2 text-sm font-semibold text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors" %>
        </div>
      </div>

    </div>

  </div>
</section>
