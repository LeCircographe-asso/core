<% content_for :background_image, "background_temp.webp" %>
<% content_for :title, "Le Circographe - Devenir Membre" %>

<main class="py-12">
    <div class="container mx-auto px-4">

        <h1 class="text-4xl font-bold text-center text-purple-500 bg-white py-4 mb-8 rounded-lg shadow-md">Devenir membre</h1>

        <section class="grid grid-cols-1 gap-8">

            <!-- Section Pourquoi nous rejoindre -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow-md p-6 md:col-span-3 flex">
                    <div class="mr-4 flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <h2 class="text-2xl font-semibold text-gray-800 mb-3">Pourquoi nous rejoindre ?</h2>
                        <p class="text-gray-700 mb-2">Description entrainements libre + lien horaires / Etape 1 Venir ADHERER sur place...</p>
                        <p class="text-gray-600">Sollicitant homines non sunt nisi quam formae rerum principiis opiniones...</p>
                    </div>
                </div>

                <div class="bg-purple-100 rounded-lg shadow-md p-6 md:col-span-1">
                    <h3 class="text-lg font-semibold text-purple-700 mb-3">LES AVANTAGES</h3>
                    <ul class="list-none pl-0">
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Se rendre aux événements
                        </li>
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Visiter un lieu unique
                        </li>
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Participer à une aventure humaine
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Section Les adhésions -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow-md p-6 md:col-span-3 flex">
                    <div class="mr-4 flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <h2 class="text-2xl font-semibold text-gray-800 mb-3">Les adhésions</h2>
                        <p class="text-gray-700 mb-2">Description résidences + lien horaires ou lien page résidence ?!</p>
                        <p class="text-gray-600">Sollicitant homines non sunt nisi quam formae rerum principiis opiniones...</p>
                    </div>
                </div>

                <div class="bg-purple-100 rounded-lg shadow-md p-6 md:col-span-1">
                    <ul class="list-none pl-0">
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Participer aux entraînements libre
                        </li>
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Demander un créneau de résidence
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Section Les cotisations -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow-md p-6 md:col-span-3 flex">
                    <div class="mr-4 flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
                                <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <h2 class="text-2xl font-semibold text-gray-800 mb-3">Les cotisations</h2>
                        <p class="text-gray-700 mb-2">Condition et modalité d'inscription</p>
                        <p class="text-gray-600">Sollicitant homines non sunt nisi quam formae rerum principiis opiniones...</p>
                    </div>
                </div>

                <div class="bg-purple-100 rounded-lg shadow-md p-6 md:col-span-1">
                    <ul class="list-none pl-0">
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Tarifs réduits selon votre situation (voir modalités)
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Section Les résidences -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow-md p-6 md:col-span-3 flex">
                    <div class="mr-4 flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <h2 class="text-2xl font-semibold text-gray-800 mb-3">Les résidences</h2>
                        <p class="text-gray-700 mb-2">S'inscrire sur le site web</p>
                        <p class="text-gray-600">Sollicitant homines non sunt nisi quam formae rerum principiis opiniones...</p>
                    </div>
                </div>

                <div class="bg-purple-100 rounded-lg shadow-md p-6 md:col-span-1">
                    <ul class="list-none pl-0">
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Consulter ses cotisations
                        </li>
                        <li class="flex items-center mb-2">
                            <svg class="w-5 h-5 mr-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Recevoir des notifications push (si PWA)
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <div class="text-center mt-8 space-x-4">
            <%= link_to "Informations Utiles", page_path('useful_information'), class: "px-6 py-3 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-lg shadow-lg hover:bg-white hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300" %>
            <%= link_to "Devenir Membre", new_registration_path, class: "px-6 py-3 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-lg shadow-lg hover:bg-white hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300" %>
        </div>

    </div>
</main>