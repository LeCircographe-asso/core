<% content_for :title, "Le Circographe - Adhérer" %>

<style>
  .timeline-step {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .timeline-step--visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<section class="relative overflow-hidden rounded-[32px] shadow-2xl mb-14">
  <%= image_tag hero_image(:become_member_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="relative hero-panel text-center space-y-4">
    <p class="text-sm uppercase tracking-[0.35em] text-white/70">Rejoindre la communauté</p>
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold">Adhérer au Circographe</h1>
    <p class="max-w-3xl mx-auto text-lg text-white/85 leading-relaxed">Tout commence par une rencontre sur place. Rejoins la communauté du Circographe, découvre le lieu et participe à la vie associative.</p>
  </div>
</section>

<section class="grid grid-cols-1 xl:grid-cols-4 gap-6 fade-in">
  <article class="bg-white/95 rounded-[24px] shadow-lg p-6 xl:col-span-3 space-y-4">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Pourquoi adhérer ?</p>
    <h2 class="text-2xl font-semibold text-gray-800">Un lieu pour pratiquer, créer et s'entraider</h2>
    <p class="text-gray-700">L'adhésion te donne accès aux entraînements libres de cirque, aux temps de création graphique, aux résidences d'artistes et à une programmation collective tout au long de l'année.</p>
    <p class="text-gray-600">Sur place, on t'accueille pour t'expliquer le fonctionnement autogéré du lieu, te présenter l'équipe bénévole et t'aider à trouver les bons créneaux selon ta pratique.</p>
  </article>

  <aside class="bg-gradient-to-br from-[#1F5C55]/75 to-[#2a7d73]/75 rounded-[24px] shadow-xl p-6 space-y-4 backdrop-blur-sm">
    <h3 class="text-xl font-bold text-white">Les avantages adhérent·e</h3>
    <ul class="space-y-3 text-sm text-white">
      <li class="flex items-center gap-3">
        <span class="w-7 h-7 flex-shrink-0 inline-flex items-center justify-center rounded-full bg-white text-[#1F5C55] font-bold shadow-md" style="font-size: 1.125rem; line-height: 1;">✓</span>
        <span class="font-medium">Accès aux entraînements libres de cirque</span>
      </li>
      <li class="flex items-center gap-3">
        <span class="w-7 h-7 flex-shrink-0 inline-flex items-center justify-center rounded-full bg-white text-[#1F5C55] font-bold shadow-md" style="font-size: 1.125rem; line-height: 1;">✓</span>
        <span class="font-medium">Participation aux ateliers & résidences graphiques</span>
      </li>
      <li class="flex items-center gap-3">
        <span class="w-7 h-7 flex-shrink-0 inline-flex items-center justify-center rounded-full bg-white text-[#1F5C55] font-bold shadow-md" style="font-size: 1.125rem; line-height: 1;">✓</span>
        <span class="font-medium">Vie associative & bénévolat (événements, accueil, technique)</span>
      </li>
      <li class="flex items-center gap-3">
        <span class="w-7 h-7 flex-shrink-0 inline-flex items-center justify-center rounded-full bg-white text-[#1F5C55] font-bold shadow-md" style="font-size: 1.125rem; line-height: 1;">✓</span>
        <span class="font-medium">Communauté active pour partager astuces, matériel et projets</span>
      </li>
    </ul>
  </aside>
</section>

<section class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 mt-10 fade-in"
         data-controller="timeline">
  <header class="text-center space-y-3 mb-6">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Comment ça marche ?</p>
    <h2 class="text-2xl font-semibold text-gray-800">Les trois étapes de l'adhésion</h2>
  </header>
  <div class="space-y-6">
    <% [
      { title: "1. Passer nous voir", body: "Viens pendant un créneau d'ouverture, on te présente le lieu et les règles de fonctionnement." },
      { title: "2. Adhérer sur place", body: "On complète ensemble la fiche d'adhésion (assurance comprise)." },
      { title: "3. Participer", body: "Tu peux t'entraîner, aider à l'accueil ou proposer un projet." }
    ].each_with_index do |step, index| %>
      <div class="timeline-step relative pl-8 md:pl-12" data-timeline-target="step">
        <div class="absolute left-0 top-2 w-6 h-6 rounded-full border-2 border-[#1F5C55] bg-white flex items-center justify-center font-semibold text-sm text-[#1F5C55] shadow">
          <%= index + 1 %>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 md:p-6 transition-transform duration-500">
          <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= step[:title] %></h3>
          <p class="text-gray-600"><%= step[:body] %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 fade-in" id="tarifs">
  <article class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-4">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Tarifs & types d'adhésion</p>
    <h2 class="text-2xl font-semibold text-gray-800">Adhésion annuelle</h2>
    <ul class="space-y-3 text-gray-600">
      <li><strong class="text-gray-800">Adhésion classique :</strong> 30 € / an – accès à tous les créneaux selon disponibilités.</li>
      <li><strong class="text-gray-800">Adhésion solidaire :</strong> 15 € / an – pour les étudiant·es, demandeur·euses d'emploi, minimas sociaux (sur présentation d'un justificatif).</li>
      <li><strong class="text-gray-800">Adhésion soutien :</strong> 50 € / an – pour soutenir davantage l'association et ses projets.</li>
    </ul>
    <p class="text-sm text-gray-500 bg-[#1F5C55]/10 border border-[#1F5C55]/20 rounded-2xl px-4 py-3">Le paiement se fait sur place (CB ou espèces). Un reçu fiscal peut être remis sur demande.</p>
  </article>

  <article class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-4">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Bénévolat</p>
    <h2 class="text-2xl font-semibold text-gray-800">Participer à l'autogestion</h2>
    <p class="text-gray-600">Le Circographe vit grâce à ses bénévoles ! Tu peux participer à l'accueil, la communication ou la technique.</p>
  </article>
</section>

<section class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 mt-10 fade-in"
         data-controller="checklist">
  <header class="text-center space-y-3 mb-6">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Avant de venir</p>
    <h2 class="text-2xl font-semibold text-gray-800">Les documents à préparer</h2>
  </header>
  <ul class="grid sm:grid-cols-2 gap-4">
    <% [
      { label: "Pièce d'identité" },
      { label: "Justificatif de domicile (< 3 mois)" },
      { label: "Photo d'identité (format numérique ou papier)" },
      { label: "Certificat médical (pour la pratique aérienne)" },
      { label: "Attestation de responsabilité civile" },
      { label: "Tarif solidaire : justificatif de situation" }
    ].each do |item| %>
      <li class="checklist-item flex items-center gap-3 bg-white rounded-2xl border border-gray-100 p-4 shadow-sm cursor-pointer transition" data-checklist-target="item" data-action="click->checklist#toggle">
        <span class="checklist-indicator w-6 h-6 inline-flex items-center justify-center rounded-full border border-[#1F5C55] text-sm text-[#1F5C55]"></span>
        <span class="text-gray-700"><%= item[:label] %></span>
      </li>
    <% end %>
  </ul>
  <p class="mt-4 text-sm text-gray-500 text-center">Un doute ? Écris-nous via le <%= link_to "formulaire de contact", page_path('contact_us'), class: "text-[#1F5C55] underline" %>.</p>
</section>

<section class="mt-10 fade-in">
  <%= render "shared/faq_section", id: "adhesion-faq", label: "Questions fréquentes", title: "Avant de te déplacer", subtitle: "Quelques repères supplémentaires pour préparer ton adhésion.", faqs: @adhesion_faqs, footer: "Besoin d'un coup de main ? Contacte-nous en amont ou passe pendant un créneau d'ouverture." %>
</section>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 fade-in">
  <article class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-4">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Horaires d'accueil</p>
    <h2 class="text-2xl font-semibold text-gray-800">Passe nous voir sur un créneau d'ouverture</h2>
    <%= render "shared/opening_hours", horaires: @opening_hours %>
  </article>

  <article class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-4">
    <p class="text-sm uppercase tracking-[0.3em] text-[#1F5C55]/70">Nous trouver</p>
    <h2 class="text-2xl font-semibold text-gray-800">Le Circographe sur la carte</h2>
    <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-inner">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d858.7320762106817!2d1.422364267936696!3d43.618639564522674!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12aebb1b7b5096ef%3A0x710f3096ea206f0!2sLe%20Circographe!5e0!3m2!1sfr!2sfr!4v1745437455061!5m2!1sfr!2sfr" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <p class="text-sm text-gray-500">27 bis allée Maurice Sarraut – 31300 Toulouse • Tram T1/T2 – Arrêt Cartoucherie.</p>
  </article>
</section>

<section class="text-center mt-12 mb-12 fade-in">
  <%= link_to "Passer nous voir", page_path('contact_us'), class: "inline-flex items-center gap-2 px-8 py-4 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-full shadow-lg hover:bg-gray-100 hover:text-[#1F5C55] hover:border-[#1F5C55] transition-all duration-300" %>
</section>