
<% content_for :title, "Le Circographe - Contact" %>

<section class="public-hero-shell mb-8 sm:mb-12 lg:mb-14">
  <%= image_tag hero_image(:contact_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="relative hero-panel text-center space-y-4">
    <p class="text-sm uppercase tracking-[0.4em] text-white/70">Écris-nous</p>
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold">Contact</h1>
    <p class="max-w-2xl mx-auto text-base sm:text-lg text-white/85 leading-snug">Adhésion, cotisation (accès cirque), temps d’accueil en création ou locaux : passe aux créneaux ou écris via le formulaire ci-dessous.</p>
  </div>
</section>

<section id="contact-details" class="space-y-12 pb-12 sm:pb-16">
  <%# Ne pas mettre .fade-in sur un ancêtre de Leaflet : translateY + will-change cassent la carte et peuvent provoquer des boucles ResizeObserver. %>
  <div class="fade-in">
  <div class="public-surface overflow-hidden border border-white/70">
    <header class="px-5 sm:px-10 py-6 sm:py-8 text-center sm:text-left bg-white">
      <p class="text-xs uppercase tracking-[0.35em] text-[#5836A5]">Infos pratiques</p>
      <h2 class="mt-2 text-3xl font-semibold text-[#1F5C55]">Horaires, accès et formulaire</h2>
      <p class="mt-3 text-sm sm:text-base text-gray-600">Réponse sous quelques jours ouvrés par message ; conseils sur place aux créneaux d’ouverture.</p>
      <span class="mt-4 inline-block h-1 w-16 bg-[#5836A5] rounded-full"></span>
    </header>

    <div class="px-4 sm:px-10 pb-6 sm:pb-8 grid gap-6 lg:gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div class="space-y-6 order-2 lg:order-1 min-w-0">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-[#1F5C55]/30 bg-white px-5 py-5 shadow-sm sm:col-span-2">
            <p class="text-xs uppercase tracking-[0.25em] text-[#1F5C55] mb-2">Accès</p>
            <p class="font-semibold text-gray-900 leading-relaxed">Bus 15 (Tisséo) — dessert le boulevard de Suisse ; descends à l’arrêt le plus proche de ton numéro.</p>
          </div>
          <div class="rounded-2xl border border-[#5836A5]/30 bg-white px-5 py-5 shadow-sm sm:col-span-2">
            <p class="text-xs uppercase tracking-[0.25em] text-[#5836A5] mb-2">Suivre l'actu</p>
            <div class="flex flex-wrap gap-3 text-sm text-[#1F5C55]">
              <%= link_to "Facebook", "https://www.facebook.com/lecircographe/?locale=fr_FR", target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-3 py-2 rounded-full border border-[#1F5C55]/40 hover:bg-[#1F5C55] hover:text-white transition" %>
              <%= link_to "Instagram", "https://www.instagram.com/lecircographe/", target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-3 py-2 rounded-full border border-[#5836A5]/40 hover:bg-[#5836A5] hover:text-white transition" %>
              <%= link_to "WhatsApp", "https://wa.me/33612345678", target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-3 py-2 rounded-full border border-[#1F5C55]/40 hover:bg-[#1F5C55] hover:text-white transition" %>
            </div>
          </div>
        </div>

        <div id="horaires" class="rounded-2xl border border-[#1F5C55]/25 bg-white px-5 py-6 space-y-3 shadow-sm scroll-mt-24">
          <p class="text-xs uppercase tracking-[0.25em] text-[#1F5C55]">Horaires d'accueil</p>
          <p class="text-sm text-gray-600">Ouverture du mardi au dimanche selon disponibilité bénévoles — Fermé le lundi.</p>
          <%= render "shared/opening_hours", horaires: @opening_hours, bare: true %>
        </div>
      </div>

      <div class="space-y-5 order-1 lg:order-2 min-w-0">
        <div class="rounded-2xl border border-[#5836A5]/30 bg-white px-5 py-5 sm:px-6 sm:py-6 shadow-sm">
          <p class="text-xs uppercase tracking-[0.25em] text-[#5836A5] mb-2">Un doute rapide ?</p>
          <p class="text-gray-700 text-sm sm:text-base leading-relaxed">Aux créneaux : orientation rapide (adhésion, création, technique).</p>
        </div>

        <div id="contact-form" class="scroll-mt-28">
          <%= render "pages/contact/form", contact: @contact || {}, status: nil, embedded: true %>
        </div>
      </div>
    </div>
  </div>
  </div>

  <div class="fade-in space-y-6 max-w-3xl mx-auto lg:max-w-none">
    <p class="text-center text-sm text-gray-600">
      <%= link_to "Questions fréquentes", page_path("faq"), class: "font-semibold text-[#5836A5] hover:text-[#412886] underline-offset-2 hover:underline" %>
      <span class="text-gray-400 mx-1">·</span>
      <%= link_to "contact & projets", page_path("faq", anchor: "faq-contact"), class: "text-[#5836A5] hover:text-[#412886] underline-offset-2 hover:underline" %>
    </p>

    <%= turbo_frame_tag "map" do %>
      <article id="map" class="contact-location-panel">
        <header class="contact-location-panel__header">
          <p class="contact-location-panel__eyebrow">Nous trouver</p>
          <h2 class="contact-location-panel__title">Accès rapide, adresse et repère sur la carte</h2>
          <p class="contact-location-panel__copy">
            Un seul bloc pour comprendre où se situe le lieu, préparer ton trajet et ouvrir directement ton application GPS.
          </p>
        </header>

        <div class="contact-location-panel__body">
          <div class="contact-location-panel__info">
            <section class="contact-location-panel__card contact-location-panel__card--primary">
              <p class="contact-location-panel__card-label contact-location-panel__card-label--primary">Adresse</p>
              <p class="contact-location-panel__address">97 bis boulevard de Suisse, 31200 Toulouse</p>
              <p class="contact-location-panel__details">
                Entrée côté boulevard, à proximité immédiate du périphérique intérieur et du secteur Ernest-Wallon.
              </p>

              <div class="contact-location-panel__actions">
                <%= link_to "Ouvrir l'itinéraire", "https://www.google.com/maps/dir/?api=1&destination=#{ERB::Util.url_encode('97 bis boulevard de Suisse, 31200 Toulouse')}",
                            target: "_blank",
                            rel: "noopener",
                            class: "contact-location-panel__cta contact-location-panel__cta--primary" %>
                <%= link_to "Voir la page contact complète", page_path("contact_us", anchor: "contact-form"),
                            class: "contact-location-panel__cta contact-location-panel__cta--secondary" %>
              </div>
            </section>

            <section class="contact-location-panel__card contact-location-panel__card--secondary">
              <p class="contact-location-panel__card-label contact-location-panel__card-label--accent">Accès</p>
              <ul class="contact-location-panel__meta-list">
                <li class="contact-location-panel__meta-item">
                  <span aria-hidden="true">•</span>
                  <span>Bus 15 (Tisséo) : dessert le boulevard de Suisse sur toute sa longueur.</span>
                </li>
                <li class="contact-location-panel__meta-item">
                  <span aria-hidden="true">•</span>
                  <span>Choisis l’arrêt selon ton sens de marche, puis remonte le boulevard jusqu’au numéro 97 bis.</span>
                </li>
                <li class="contact-location-panel__meta-item">
                  <span aria-hidden="true">•</span>
                  <span>Sur mobile, le bouton itinéraire ouvre directement ton navigateur GPS.</span>
                </li>
              </ul>
            </section>
          </div>

          <div class="contact-location-panel__map-wrap">
            <%= render "shared/map_embed",
                       caption: "Repère visuel du Circographe sur le secteur nord de Toulouse, pour situer rapidement le boulevard de Suisse et son environnement immédiat.",
                       caption_class: "contact-location-panel__map-caption",
                       shell_classes: "h-[clamp(320px,54vw,560px)] min-h-[320px] lg:h-[min(62vh,560px)]" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
