<% events ||= [] %>

<section class="space-y-6">
  <% if events.present? %>
    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6">
      <% events.each do |event| %>
        <%= render "shared/event_card", event: event %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/events_empty_state" %>
  <% end %>
</section>
