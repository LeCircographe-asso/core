<% events ||= [] %>

<section class="space-y-6">
  <% if events.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% events.first(2).each do |event| %>
        <%= render "shared/event_card", event: event %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/events_empty_state" %>
  <% end %>
</section>
