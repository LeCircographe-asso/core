<% content_for :title, "Le Circographe - FAQ" %>

<section class="public-hero-shell mb-10 sm:mb-12">
  <%= image_tag hero_image(:faq_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="hero-panel public-hero-panel-centered">
    <h1 class="public-hero-title">Questions fréquentes</h1>
    <p class="public-hero-body">Peu de blabla — les infos utiles, avec le ton du lieu.</p>
  </div>
</section>

<section class="page-container max-w-6xl mb-10 sm:mb-14"
         data-controller="faq-tabs"
         role="tablist"
         aria-label="Catégories FAQ">

  <%# ── Onglets ── %>
  <div class="flex flex-wrap justify-center gap-2 mb-8">
    <button type="button" role="tab"
            data-faq-tabs-target="tab"
            data-faq-tabs-panel="faq-adhesion"
            data-action="click->faq-tabs#show"
            aria-selected="false"
            class="faq-tab">
      Adhérer &amp; pratiquer
    </button>
    <button type="button" role="tab"
            data-faq-tabs-target="tab"
            data-faq-tabs-panel="faq-contact"
            data-action="click->faq-tabs#show"
            aria-selected="false"
            class="faq-tab">
      Écrire &amp; proposer
    </button>
    <button type="button" role="tab"
            data-faq-tabs-target="tab"
            data-faq-tabs-panel="faq-general"
            data-action="click->faq-tabs#show"
            aria-selected="false"
            class="faq-tab">
      Lieu &amp; horaires
    </button>
  </div>

  <%# ── Panneaux ── %>
  <div class="public-surface-bordered px-6 pt-10 pb-12 sm:px-8 sm:py-10 lg:px-10">

    <article id="faq-adhesion" data-faq-tabs-target="panel" role="tabpanel" aria-labelledby="faq-tab-adhesion" class="space-y-4">
      <%= render "shared/faq_section",
        id: "faq-adhesion-list",
        label: nil,
        title: "Adhérer & pratiquer",
        subtitle: nil,
        faqs: @adhesion_faqs,
        footer: "Tarifs et créneaux : page Adhérer." %>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <%= link_to "Page Adhérer", page_path("become_member"), class: "btn-primary shadow-lg" %>
        <%= link_to "Créneaux & fonctionnement", page_path("association", anchor: "fonctionnement"), class: "btn-tertiary shadow" %>
      </div>
    </article>

    <article id="faq-contact" data-faq-tabs-target="panel" role="tabpanel" aria-labelledby="faq-tab-contact" class="space-y-4">
      <%= render "shared/faq_section",
        id: "faq-contact-list",
        label: nil,
        title: "Écrire & proposer",
        subtitle: nil,
        faqs: @contact_faqs,
        footer: "Formulaire sur la page Contact (bas de page)." %>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <%= link_to "Page Contact", page_path("contact_us", anchor: "contact-form"), class: "btn-primary shadow-lg" %>
        <%= link_to "Horaires", page_path("contact_us", anchor: "horaires"), class: "btn-tertiary shadow" %>
      </div>
    </article>

    <article id="faq-general" data-faq-tabs-target="panel" role="tabpanel" aria-labelledby="faq-tab-general" class="space-y-4">
      <%= render "shared/faq_section",
        id: "faq-general-list",
        label: nil,
        title: "Lieu & horaires",
        subtitle: nil,
        faqs: @general_faqs,
        footer: "Programmation : Nos activités · newsletter en bas de site." %>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <%= link_to "Nos activités", page_path("news"), class: "btn-primary shadow-lg" %>
        <%= link_to "Tarifs / adhérer", page_path("become_member", anchor: "tarifs"), class: "btn-tertiary shadow" %>
      </div>
    </article>

  </div>
</section>
