<% content_for :title, "Le Circographe - FAQ" %>

<section class="py-6 text-center bg-white/95 rounded-lg shadow-md max-w-6xl mx-auto fade-in">
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold text-black">Foire Aux Questions (FAQ)</h1>
</section>

<!-- FAQ Section with Flowbite Accordion -->
<section class="py-12 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl fade-in">
    <div class="px-10 fade-in">
        <h2 class="text-3xl font-semibold mb-8">Questions Fréquemment Posées</h2>

        <div class="space-y-4 fade-in" data-controller="accordion">
            <% (1..10).each do |i| %>
            <div class="p-4 bg-gray-50 rounded-lg shadow fade-in">
                <h3 id="accordion-faq-heading-<%= i %>">
                    <button type="button" 
                        class="flex items-center justify-between w-full text-xl font-semibold text-gray-800" 
                        data-accordion-target="#accordion-faq-body-<%= i %>" 
                        aria-expanded="false" 
                        aria-controls="accordion-faq-body-<%= i %>">
                        <span>Question <%= i %></span>
                        <svg data-accordion-icon class="w-5 h-5 shrink-0 rotate-180 transition-transform duration-200" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </h3>
                <div id="accordion-faq-body-<%= i %>" class="hidden" aria-labelledby="accordion-faq-heading-<%= i %>">
                    <p class="text-gray-700 mt-2">
                        Réponse à la question <%= i %>.
                    </p>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</section>