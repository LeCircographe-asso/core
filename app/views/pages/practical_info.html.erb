<% content_for :title, "Le Circographe - Informations Utiles" %>

<!-- Header Section -->
<section class="py-6 mb-12 text-center bg-white/95 rounded-lg shadow-md max-w-6xl mx-auto fade-in">
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold text-black">Informations Utiles</h1>
</section>

<!-- Address and Hours Section -->
<section class="py-6 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 fade-in">
        <h2 class="text-3xl font-semibold mb-8">Où nous trouver</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 fade-in">
            <!-- Address -->
            <div class="md:col-span-1 fade-in">
                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55]">Adresse</h3>
                <p class="text-gray-700 mb-4">Moyen de transport : Bus Arrêt Le Matisse</p>
                <div class="relative overflow-hidden rounded-lg shadow-md fade-in" style="padding-bottom: 75%;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2888.3717857836123!2d1.4173841909633822!3d43.61962028010457!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12aebb1b7b5096ef%3A0x710f3096ea206f0!2sLe%20Circographe!5e0!3m2!1sfr!2sfr!4v1742812255067!5m2!1sfr!2sfr" width="100%" height="100%" style="border:0; position: absolute; top: 0; left: 0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <!-- Hours of operation -->
            <div class="md:col-span-2 fade-in">
                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55]">Horaires d'ouverture</h3>
                <%= render 'shared/opening_hours', horaires: @opening_hours %>
            </div>
        </div>
    </div>
</section>

<!-- Membership Information Section -->
<section class="py-6 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 fade-in">
        <h2 class="text-3xl font-semibold mb-8">Informations sur l'adhésion</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 fade-in">
            <!-- Left column -->
            <div>
                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55]">Modalités</h3>
                <p class="text-gray-700 mb-4">
                    Pour devenir membre du Circographe, vous devez remplir un formulaire d'inscription et fournir les documents requis. 
                    L'adhésion est valable pour une année civile et peut être renouvelée chaque année.
                </p>

                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55] mt-6">Tarifs</h3>
                <p class="text-gray-700 mb-4">
                    Les tarifs d'adhésion varient selon votre situation. Des tarifs réduits sont disponibles pour les étudiants, 
                    les demandeurs d'emploi et les personnes à faibles revenus. Contactez-nous pour plus d'informations.
                </p>
            </div>

            <!-- Right column -->
            <div>
                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55]">Types d'adhésion</h3>
                <p class="text-gray-700 mb-4">
                    Nous proposons différents types d'adhésion pour répondre à vos besoins : adhésion standard, 
                    adhésion pour les résidents, adhésion familiale, etc. Chaque type d'adhésion offre des avantages spécifiques.
                </p>

                <h3 class="text-xl font-semibold mb-4 text-[#1F5C55] mt-6">Documents requis</h3>
                <ul class="list-disc pl-5 text-gray-700 space-y-2">
                    <li>Pièce d'identité valide</li>
                    <li>Justificatif de domicile de moins de 3 mois</li>
                    <li>Photo d'identité récente</li>
                    <li>Justificatif de situation pour les tarifs réduits (si applicable)</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="py-6 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 text-center fade-in">
        <h2 class="text-3xl font-semibold mb-8">Vous avez des questions ?</h2>
        <p class="text-gray-700 mb-6">
            Consultez notre FAQ pour trouver des réponses aux questions fréquemment posées.
        </p>
        <%= link_to "Consulter la FAQ", page_path('faq'), class: "px-6 py-3 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-lg shadow-lg hover:bg-gray-100 hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300" %>
    </div>
</section>

<!-- Contact Section -->
<section class="py-6 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 text-center fade-in">
        <h2 class="text-3xl font-semibold mb-8">Besoin d'aide ?</h2>
        <p class="text-gray-700 mb-6">
            Notre équipe est là pour vous accompagner dans votre processus d'adhésion. N'hésitez pas à nous contacter pour toute question.
        </p>
        <%= link_to "Nous contacter", page_path('contact_us'), class: "px-6 py-3 tracking-wide text-white font-bold bg-[#1F5C55] border-2 border-[#1F5C55] rounded-lg shadow-lg hover:bg-gray-100 hover:text-[#1F5C55] hover:border-[#1F5C55] transition-colors duration-300" %>
    </div>
</section>