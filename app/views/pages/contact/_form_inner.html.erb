<%# Contenu du turbo-frame #contact_form uniquement (évite la duplication de la carte au stream). %>
<% if local_assigns[:status] == :success %>
  <div class="mt-6 rounded-2xl border border-brand-primary/25 bg-brand-primary/8 px-5 py-8 text-center space-y-3" role="status">
    <p class="text-lg font-semibold text-brand-primary"><%= t("contacts.create.success_title") %></p>
    <p class="text-sm text-gray-700 leading-relaxed"><%= t("contacts.create.sent_notice") %></p>
  </div>
<% else %>
  <%= form_with url: submit_contact_path, method: :post, data: { turbo_stream: true }, class: "space-y-5 mt-5 sm:mt-6" do |form| %>
    <div>
      <%= form.label :name, class: "block mb-1.5 text-sm font-medium text-gray-700" do %>
        <%= t("views.pages.contact.form.name_label") %><span aria-hidden="true" class="text-red-500 ml-0.5">*</span>
      <% end %>
      <%= form.text_field :name, value: contact[:name], placeholder: t("views.pages.contact.form.name_placeholder"), required: true, autocomplete: "name", aria: { required: "true" }, class: "block w-full min-h-[2.75rem] px-4 py-3 text-base text-gray-800 bg-white border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/25 focus:outline-none touch-manipulation" %>
    </div>

    <div>
      <%= form.label :email, class: "block mb-1.5 text-sm font-medium text-gray-700" do %>
        <%= t("views.pages.contact.form.email_label") %><span aria-hidden="true" class="text-red-500 ml-0.5">*</span>
      <% end %>
      <%= form.email_field :email, value: contact[:email], placeholder: t("views.pages.contact.form.email_placeholder"), required: true, autocomplete: "email", aria: { required: "true" }, class: "block w-full min-h-[2.75rem] px-4 py-3 text-base text-gray-800 bg-white border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/25 focus:outline-none touch-manipulation" %>
    </div>

    <div>
      <%= form.label :category, t("views.pages.contact.form.category_label"), class: "block mb-1.5 text-sm font-medium text-gray-700" %>
      <%= form.select :category,
          options_for_select([
            [t("views.pages.contact.form.categories.general"), "general"],
            [t("views.pages.contact.form.categories.technical"), "technical"],
            [t("views.pages.contact.form.categories.creative_hosting"), "creative_hosting"],
            [t("views.pages.contact.form.categories.partnership"), "partnership"]
          ], contact[:category]),
          { include_blank: t("views.pages.contact.form.category_prompt") },
          class: "block w-full min-h-[2.75rem] px-4 py-3 text-base text-gray-800 bg-white border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/25 focus:outline-none touch-manipulation" %>
    </div>

    <div>
      <%= form.label :message, t("views.pages.contact.form.message_label"), class: "block mb-1.5 text-sm font-medium text-gray-700" %>
      <%= form.text_area :message, value: contact[:message], rows: 5, placeholder: t("views.pages.contact.form.message_placeholder"), class: "block w-full px-4 py-3 text-base text-gray-800 bg-white border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/25 focus:outline-none touch-manipulation resize-y min-h-[8rem]" %>
    </div>

    <div class="flex flex-col gap-2 pt-1">
      <%= form.submit t("views.pages.contact.form.submit"), class: "inline-flex items-center justify-center w-full sm:w-auto min-h-[3rem] px-6 py-3 text-base tracking-wide text-white font-bold bg-brand-primary border-2 border-brand-primary rounded-full shadow-md hover:bg-gray-100 hover:text-brand-primary hover:border-brand-primary transition-colors duration-300 cursor-pointer touch-manipulation" %>
      <p data-form-feedback-target="message" class="hidden text-sm text-brand-primary text-center sm:text-left"></p>
    </div>
  <% end %>
<% end %>
