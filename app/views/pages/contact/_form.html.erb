<div class="w-full px-6 sm:px-8 py-8 bg-white/95 shadow-2xl rounded-[28px]" data-controller="form-feedback">
  <h2 class="text-2xl font-semibold text-gray-800">Écris-nous</h2>
  <p class="mt-2 text-gray-600">Une question, un projet de temps d’accueil en création ou un partenariat ? On te répond sous quelques jours ouvrés.</p>

  <%= turbo_frame_tag "contact_form" do %>
    <%= render "pages/contact/form_inner", contact: contact, status: local_assigns[:status] %>
  <% end %>
</div>
