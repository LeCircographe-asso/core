<% content_for :title, t("views.pages.news.page_title") %>

<section class="public-hero-shell mb-14">
  <%= image_tag hero_image(:news_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="hero-panel public-hero-panel-centered">
    <p class="public-hero-eyebrow"><%= t("views.pages.news.eyebrow") %></p>
    <h1 class="public-hero-title"><%= t("views.pages.news.heading") %></h1>
    <p class="public-hero-body-wide"><%= t("views.pages.news.intro") %></p>
  </div>
</section>

<section id="pratiques-regulieres" class="public-section-shell public-anchor-section fade-in">
  <header class="max-w-4xl mx-auto text-center space-y-4">
    <p class="section-eyebrow"><%= t("views.pages.news.circus.eyebrow") %></p>
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t("views.pages.news.circus.heading") %></h2>
    <p class="text-base sm:text-lg text-gray-700 leading-relaxed"><%= t("views.pages.news.circus.intro") %></p>
  </header>
  <div class="max-w-5xl mx-auto mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
    <article class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-100 shadow-sm space-y-4">
      <h3 class="text-xl font-semibold text-gray-900"><%= t("views.pages.news.circus.autonomy.title") %></h3>
      <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.circus.autonomy.body") %></p>
    </article>
    <article class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-100 shadow-sm space-y-4">
      <h3 class="text-xl font-semibold text-gray-900"><%= t("views.pages.news.circus.companies.title") %></h3>
      <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.circus.companies.body") %></p>
    </article>
  </div>
</section>

<section id="arts-graphiques" class="py-12 sm:py-14 lg:py-16 px-4 sm:px-8 fade-in">
  <div class="public-surface max-w-5xl mx-auto overflow-hidden">
    <div class="flex flex-col lg:flex-row">
      <div class="lg:w-2/5 h-60 lg:h-auto">
        <%= image_tag hero_image(:association_graphics_card), class: "w-full h-full object-cover", alt: t("views.pages.news.graphics.image_alt") %>
      </div>
      <div class="lg:w-3/5 p-6 sm:p-8 space-y-4">
        <p id="pratiques-visuelles" class="section-eyebrow"><%= t("views.pages.news.graphics.eyebrow") %></p>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t("views.pages.news.graphics.heading") %></h2>
        <p class="text-base sm:text-lg text-gray-700 leading-relaxed"><%= t("views.pages.news.graphics.body_1") %></p>
        <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.graphics.body_2") %></p>
      </div>
    </div>
  </div>
</section>

<section id="evenements" class="public-section-shell fade-in space-y-10">
  <header class="max-w-4xl mx-auto text-center space-y-4">
    <p class="section-eyebrow"><%= t("views.pages.news.events.eyebrow") %></p>
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t("views.pages.news.events.heading") %></h2>
    <p class="text-base sm:text-lg text-gray-700 leading-relaxed"><%= t("views.pages.news.events.intro") %></p>
  </header>

  <section class="public-card-shell space-y-8"
           data-controller="tabs"
           data-tabs-initial-value="avenir"
           data-tabs-active-class="activities-tab--active">
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="text-left">
        <p class="section-eyebrow"><%= t("views.pages.news.events.filter_eyebrow") %></p>
        <h3 class="text-xl sm:text-2xl font-semibold text-gray-800"><%= t("views.pages.news.events.filter_heading") %></h3>
      </div>
      <div role="tablist" class="flex flex-wrap gap-2" aria-label="<%= t("views.pages.news.events.filter_label") %>">
        <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="avenir"
                class="activities-tab tab-filter"
                data-action="tabs#select">
          <%= t("views.pages.news.events.tabs.upcoming") %>
        </button>
        <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="passes"
                class="activities-tab tab-filter"
                data-action="tabs#select">
          <%= t("views.pages.news.events.tabs.past") %>
        </button>
        <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="actus"
                class="activities-tab tab-filter"
                data-action="tabs#select">
          <%= t("views.pages.news.events.tabs.news") %>
        </button>
      </div>
    </header>

    <div class="space-y-6">
      <div data-tabs-target="panel" data-tabs-name-value="avenir" class="space-y-6" role="tabpanel">
        <turbo-frame id="activities-upcoming" loading="lazy" src="<%= upcoming_events_path %>">
          <%= render "pages/news/events_grid", events: @upcoming_events %>
        </turbo-frame>
      </div>

      <div data-tabs-target="panel" data-tabs-name-value="passes" class="space-y-6 hidden" role="tabpanel" aria-hidden="true">
        <turbo-frame id="activities-past" loading="lazy" src="<%= past_events_path %>">
          <%= render "pages/news/events_grid", events: @past_events %>
        </turbo-frame>
      </div>

      <div data-tabs-target="panel" data-tabs-name-value="actus" class="space-y-6 hidden" role="tabpanel" aria-hidden="true">
        <turbo-frame id="activities-blogs" loading="lazy" src="<%= latest_blogs_path %>">
          <%= render "pages/news/blog_grid", blogs: @latest_posts %>
        </turbo-frame>
      </div>
    </div>
  </section>
</section>

<section id="autres-projets" class="py-12 sm:py-14 lg:py-16 px-4 sm:px-8 fade-in">
  <div class="public-surface max-w-5xl mx-auto overflow-hidden"
       data-controller="accordion"
       data-accordion-animate-value="true">

    <div class="p-8 sm:p-10 text-center space-y-3 border-b border-gray-100">
      <p class="section-eyebrow"><%= t("views.pages.news.projects.eyebrow") %></p>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= t("views.pages.news.projects.heading") %></h2>
      <p class="text-base sm:text-lg text-gray-700 leading-relaxed"><%= t("views.pages.news.projects.intro") %></p>
    </div>

    <article>
      <button type="button"
              class="group w-full flex items-center justify-between gap-4 px-6 sm:px-8 py-5 text-left hover:bg-gray-50 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-primary"
              aria-expanded="true"
              aria-controls="projet-ateliers"
              data-accordion-target="#projet-ateliers">
        <h3 class="text-lg font-semibold text-gray-900 transition-colors duration-200 group-hover:text-brand-accent"><%= t("views.pages.news.projects.workshops.title") %></h3>
        <svg data-accordion-icon class="shrink-0 w-5 h-5 text-brand-primary/70 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="projet-ateliers" class="px-6 sm:px-8 pb-6">
        <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.projects.workshops.body") %></p>
      </div>
    </article>

    <div class="projet-sep" aria-hidden="true"></div>

    <article>
      <button type="button"
              class="group w-full flex items-center justify-between gap-4 px-6 sm:px-8 py-5 text-left hover:bg-gray-50 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-primary"
              aria-expanded="false"
              aria-controls="projet-rencontres"
              data-accordion-target="#projet-rencontres">
        <h3 class="text-lg font-semibold text-gray-900 transition-colors duration-200 group-hover:text-brand-accent"><%= t("views.pages.news.projects.meetings.title") %></h3>
        <svg data-accordion-icon class="shrink-0 w-5 h-5 text-brand-primary/70 rotate-180 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="projet-rencontres" class="px-6 sm:px-8 pb-6 hidden" hidden>
        <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.projects.meetings.body") %></p>
      </div>
    </article>

    <div class="projet-sep" aria-hidden="true"></div>

    <article>
      <button type="button"
              class="group w-full flex items-center justify-between gap-4 px-6 sm:px-8 py-5 text-left hover:bg-gray-50 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-primary"
              aria-expanded="false"
              aria-controls="projet-capsules"
              data-accordion-target="#projet-capsules">
        <h3 class="text-lg font-semibold text-gray-900 transition-colors duration-200 group-hover:text-brand-accent"><%= t("views.pages.news.projects.capsules.title") %></h3>
        <svg data-accordion-icon class="shrink-0 w-5 h-5 text-brand-primary/70 rotate-180 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="projet-capsules" class="px-6 sm:px-8 pb-6 hidden" hidden>
        <p class="text-gray-700 leading-relaxed"><%= t("views.pages.news.projects.capsules.body") %></p>
      </div>
    </article>

  </div>
</section>

<style nonce="<%= content_security_policy_nonce %>">
  .projet-sep {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(31,92,85,0.25) 20%, rgba(31,92,85,0.25) 80%, transparent);
    transform: scaleX(0);
    transform-origin: center;
    animation: sep-grow 0.7s cubic-bezier(0.16,1,0.3,1) forwards;
    animation-play-state: paused;
  }
  .fade-in.visible .projet-sep { animation-play-state: running; }
  .fade-in.visible .projet-sep:nth-of-type(2) { animation-delay: 0.1s; }
  .fade-in.visible .projet-sep:nth-of-type(3) { animation-delay: 0.25s; }
  @keyframes sep-grow {
    to { transform: scaleX(1); }
  }
</style>

<section class="py-10 sm:py-16 fade-in">
  <div class="w-full relative">
    <div class="swiper news-photos-carousel swiper-container relative overflow-hidden rounded-2xl"
         data-controller="slider"
         data-slider-options-value='<%= {
           slidesPerView: 1,
           spaceBetween: 16,
           grabCursor: true,
           watchOverflow: false,
           breakpoints: {
             "768" => { slidesPerView: 2, spaceBetween: 20 },
             "1280" => { slidesPerView: 3, spaceBetween: 24 }
           },
           pagination: { el: ".news-photos-pagination", clickable: true }
         }.to_json %>'>
      <div class="swiper-wrapper mb-4 sm:mb-8">
        <%# Vraies photos de la galerie si elle est peuplée, sinon repli sur le pool générique — même logique que pages/gallery. %>
        <% if @news_carousel_photos.present? %>
          <% @news_carousel_photos.each_with_index do |photo, index| %>
            <div class="swiper-slide">
              <div class="public-carousel-media rounded-2xl flex justify-center items-center overflow-hidden bg-gray-100 select-none">
                <%= image_tag url_for(photo.full),
                              alt: t("views.pages.news.photos.alt", position: index + 1),
                              draggable: false,
                              class: "object-cover w-full h-full",
                              loading: (index.zero? ? "eager" : "lazy"),
                              decoding: "async" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <% news_carousel_image_sources(limit: 12).each_with_index do |filename, index| %>
            <div class="swiper-slide">
              <div class="public-carousel-media rounded-2xl flex justify-center items-center overflow-hidden bg-gray-100 select-none">
                <%= image_tag filename,
                              alt: t("views.pages.news.photos.alt", position: index + 1),
                              draggable: false,
                              class: "object-cover w-full h-full",
                              loading: (index.zero? ? "eager" : "lazy"),
                              decoding: "async" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="news-photos-pagination swiper-pagination !static !relative flex justify-center gap-1.5 py-3 min-h-[2rem]"></div>
      <%= render "shared/carousel_arrows", wrapper_class: "absolute inset-y-0 left-0 right-0 flex justify-between items-center pointer-events-none z-20 px-1 sm:px-2", button_class: "pointer-events-auto touch-manipulation", prev_label: t("views.pages.news.photos.previous"), next_label: t("views.pages.news.photos.next") %>
    </div>
  </div>

  <div class="mt-6 text-center fade-in">
    <%= link_to t("views.pages.news.photos.all"), page_path("gallery"), class: "public-cta-pill" %>
  </div>
</section>

<section class="text-center mt-12 mb-20 space-y-4 fade-in">
  <div class="public-surface max-w-3xl mx-auto px-6 sm:px-10 py-8 space-y-4">
    <p class="text-lg text-gray-700 font-medium"><%= t("views.pages.news.cta.body") %></p>
    <%= link_to t("views.pages.news.cta.button"), page_path("news", anchor: "evenements"), class: "public-cta" %>
  </div>
</section>
