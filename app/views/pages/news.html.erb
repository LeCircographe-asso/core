<% content_for :title, "Le Circographe - Nos activités" %>

        <section class="text-center mb-12 bg-white/95 py-6 rounded-lg shadow-md fade-in">
  <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold text-black">Nos activités</h1>
  <p class="mt-3 max-w-2xl mx-auto text-gray-600">Événements, actualités, ateliers et résidences : toutes les expériences qui font vibrer le Circographe au quotidien.</p>
        </section>

<section class="bg-white/95 rounded-[28px] shadow-lg p-6 sm:p-8 space-y-8 fade-in"
         data-controller="tabs"
         data-tabs-initial-value="avenir"
         data-tabs-active-class="activities-tab--active">
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="text-left">
      <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Programmation</p>
      <h2 class="text-2xl font-semibold text-gray-800">Filtre les activités qui t'intéressent</h2>
        </div>
    <div role="tablist" class="flex flex-wrap gap-2" aria-label="Filtres des activités">
      <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="avenir"
              class="activities-tab inline-flex items-center px-4 py-2 rounded-full border border-brand-primary/40 text-sm font-medium text-gray-700 bg-white hover:bg-brand-primary/10 transition-colors"
              data-action="tabs#select">
        À venir
      </button>
      <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="passes"
              class="activities-tab inline-flex items-center px-4 py-2 rounded-full border border-brand-primary/40 text-sm font-medium text-gray-700 bg-white hover:bg-brand-primary/10 transition-colors"
              data-action="tabs#select">
        Passés
      </button>
      <button type="button" role="tab" data-tabs-target="trigger" data-tabs-name-value="actus"
              class="activities-tab inline-flex items-center px-4 py-2 rounded-full border border-brand-primary/40 text-sm font-medium text-gray-700 bg-white hover:bg-brand-primary/10 transition-colors"
              data-action="tabs#select">
        Actualités
      </button>
            </div>
  </header>

  <div class="space-y-6">
    <div data-tabs-target="panel" data-tabs-name-value="avenir" class="space-y-6" role="tabpanel">
      <turbo-frame id="activities-upcoming" loading="lazy" src="<%= upcoming_events_path %>">
        <%= render "pages/news/events_grid", events: @upcoming_events %>
      </turbo-frame>
    </div>

    <div data-tabs-target="panel" data-tabs-name-value="passes" class="space-y-6 hidden" role="tabpanel" aria-hidden="true">
      <turbo-frame id="activities-past" loading="lazy" src="<%= past_events_path %>">
        <%= render "pages/news/events_grid", events: @past_events %>
      </turbo-frame>
    </div>

    <div data-tabs-target="panel" data-tabs-name-value="actus" class="space-y-6 hidden" role="tabpanel" aria-hidden="true">
      <turbo-frame id="activities-blogs" loading="lazy" src="<%= latest_blogs_path %>">
        <%= render "pages/news/blog_grid", blogs: @latest_posts %>
      </turbo-frame>
    </div>
</div>
</section>

<section class="py-16 bg-white/95 rounded-[28px] shadow-lg mt-12 fade-in">
  <div class="max-w-xl mx-auto px-4 md:px-8 text-center space-y-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 mx-auto text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
        </svg>
    <div class="space-y-3">
      <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Lettre d'information</p>
      <h3 class="text-3xl text-gray-800 font-bold">Abonne-toi à la newsletter</h3>
      <p class="text-black leading-relaxed">Stages, résidences, événements : reçois les actualités chaudes du Circographe directement dans ta boîte mail.</p>
</div>
    <div>
      <%= form_with scope: :user, url: newsletter_signup_path, method: :post, data: { controller: "form-feedback" }, class: "items-center justify-center sm:flex gap-4" do |form| %>
        <%= form.email_field :email_address, placeholder: "Entrez votre email", required: true, class: "text-gray-500 w-full p-3 rounded-full border outline-none focus:border-brand-primary" %>
                    <%= form.hidden_field :website, value: "" %>
        <%= form.submit "S'abonner", class: "w-full sm:w-auto mt-3 sm:mt-0 btn-primary cursor-pointer" %>
        <p data-form-feedback-target="message" class="hidden mt-3 text-sm text-brand-primary"></p>
                <% end %>
      <p class="mt-3 mx-auto text-center max-w-lg text-sm text-black">
        Pas de spam, juste les infos importantes. Consulte notre <%= link_to "Politique de confidentialité", page_path('privacy_policy'), class: "text-brand-primary underline" %>.
                </p>
            </div>
        </div>
</section>

<section class="py-16 fade-in">
        <div class="w-full relative">
    <div class="swiper multiple-slide-carousel swiper-container relative" data-controller="slider" data-slider-options-value='{"breakpoints":{"768":{"slidesPerView":2},"1280":{"slidesPerView":3}}}'>
                <div class="swiper-wrapper mb-12">
                    <div class="swiper-slide">
                        <div class="rounded-2xl h-96 flex justify-center items-center overflow-hidden">
                            <%= image_tag "home1.webp", alt: "Carousel Image 1", class: "object-cover w-full h-full" %>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="rounded-2xl h-96 flex justify-center items-center overflow-hidden">
                            <%= image_tag "home2.webp", alt: "Carousel Image 2", class: "object-cover w-full h-full" %>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="rounded-2xl h-96 flex justify-center items-center overflow-hidden">
                            <%= image_tag "home3.webp", alt: "Carousel Image 3", class: "object-cover w-full h-full" %>
                        </div>
                    </div>
                </div>
                <div class="absolute flex justify-between items-center w-full -translate-x-1/2 left-1/2 top-1/2 -translate-y-1/2 z-50">
                    <button id="slider-button-left" class="swiper-button-prev !border-black !text-black hover:!border-gray-300 hover:!bg-gray-300">
                        <svg class="h-5 w-5 !text-black hover:!text-gray-800" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <button id="slider-button-right" class="swiper-button-next !border-black !text-black hover:!border-gray-300 hover:!bg-gray-300">
                        <svg class="h-5 w-5 !text-black hover:!text-gray-800" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

  <div class="mt-6 text-center fade-in">
    <%= link_to page_path("gallery"), class: "btn-primary inline-flex items-center gap-x-2 text-sm font-medium shadow-2xs" do %>
                Voir toutes les photos
                <svg class="shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            <% end %>
        </div>
</section>