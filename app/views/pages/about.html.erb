<section class="py-6 mb-12 text-center bg-white/95 rounded-lg shadow-md max-w-6xl mx-auto fade-in">
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold text-black">À Propos</h1>
</section>

<!-- Mission Section -->
<section class="py-6 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 fade-in">
        <h2 class="text-3xl font-semibold mb-8">Mission de l'association</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 fade-in">
            <div>
                <p class="text-gray-700 mb-4">
                    Sollicitant homines non sunt nisi quam formae rerum principis optiones. Mors enim est
                    terribilis ut dolorri ataut eise apparet. Sed famse mortis est nasto terribils.
                </p>
            </div>
            <div>
                <p class="text-gray-700 mb-4">
                    Sollicitant homines non sunt nisi quam formae rerum principis optiones. Mors enim est terribilis ut
                    dolorri ataut eise apparet. Sed famse mortis est nasto terribilis. Cum qatur impelluntur turbuntur attl
                    duinos viacamus. Mitis non bibequr nisi nobilc hoc est, in principis inustia.
                </p>
                <p class="text-gray-700 mb-4">
                    Ponam in culpa idiota alitis prevelatis. Principium ponere culpam in se ipatum praeciptum. Neque
                    improperes et alis qui non perfecte ipse docut.
                </p>
                <p class="text-gray-700 mb-4">
                    Quod Enchinrion Epictetus stoici scripist. Indrigo Abela et Technologiae apud Massiachusetts instituta
                    Opera collectio. Ex anglicus Latine transiata sunt.
                </p>
                <p class="text-gray-700">
                    Quidam ais sunt, et non est in nostra poteslate. Quae omnia in nostra sententia, pursut, cupisitatem.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-12 bg-white/95 rounded-lg mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="text-center mb-12 fade-in">
        <h2 class="text-3xl font-semibold">Présentation de l'équipe</h2>
        <h3 class="text-xl text-gray-700 mt-2">Le Conseil d'Administration</h3>
    </div>
    <!-- Thank you text -->
    <div class="px-10 mb-12 fade-in">
        <div class="text-gray-700 text-center max-w-4xl mx-auto">
            <p class="mb-4 text-lg">
                Nous tenons à remercier chaleureusement tous les membres de notre conseil d'administration 
                pour leur engagement, leur dévouement et leur contribution précieuse au développement de notre association.
            </p>
            <p class="mb-4">
                Leur travail bénévole, leur expertise et leur passion sont essentiels à la réussite de nos projets 
                et à la réalisation de notre mission. Sans leur implication constante, rien ne serait possible.
            </p>
            <p>
                C'est grâce à leur engagement que nous pouvons offrir un environnement riche et stimulant 
                où chacun peut s'épanouir et développer ses talents artistiques.
            </p>
        </div>
    </div>

    <!-- Team members grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-6 px-10 fade-in">
        <% ["John Doe", "Amelie Anderson", "Arthur Malo", "Olivia Watson", "Sophie Martin", "Pierre Dubois", "Marie Lefebvre"].each do |name| %>
        <div class="transition-transform duration-300 hover:-translate-y-1 text-center fade-in">
            <div class="mx-auto mb-4 rounded-full overflow-hidden w-32 h-32 bg-gray-200 shadow-md fade-in">
                <%= image_tag "placeholder_avatar.webp", alt: name, class: "w-full h-full object-cover" %>
            </div>
            <h4 class="font-semibold"><%= name %></h4>
            <p class="text-gray-600 text-sm">Rôle dans l'association</p>
            <div class="flex justify-center space-x-2 mt-2 fade-in">
                <a href="#" class="text-gray-500 hover:text-gray-800 transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                    </svg>
                </a>
                <a href="#" class="text-gray-500 hover:text-gray-800 transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                    </svg>
                </a>
                <a href="#" class="text-gray-500 hover:text-gray-800 transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                    </svg>
                </a>
            </div>
        </div>
        <% end %>
    </div>
</section>

<!-- Historical Section -->
<section class="py-12 bg-white/95 rounded-lg shadow-md mx-auto my-10 max-w-6xl backdrop-blur-sm fade-in">
    <div class="px-10 fade-in">
        <h2 class="text-3xl font-semibold text-center mb-6">Historique de l'association</h2>
        <h3 class="text-xl text-gray-700 text-center mb-8">Membres fondateurs</h3>
        <div class="mb-8 fade-in">
            <p class="text-gray-700 text-center max-w-3xl mx-auto">
                Tenete ergo quod si servitus quae natura liber, et aliena tua tunc impeditur. Doloris, et
                turbabuntur, et inveniatis, cum culpa tam de hominibusque. Quod si fibi tantum sit
                propria et aliena quale sit, nemo uniquam vel invitum te continebis.
            </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-3 gap-6 justify-items-center mt-12 fade-in">
            <!-- Founding members -->
            <% 3.times do |i| %>
            <div class="transition-transform duration-300 hover:-translate-y-1 text-center fade-in">
                <div class="mx-auto mb-4 rounded-full overflow-hidden w-24 h-24 bg-gray-200 shadow-md fade-in">
                    <%= image_tag "placeholder_avatar.webp", alt: "Membre fondateur", class: "w-full h-full object-cover" %>
                </div>
                <h4 class="font-semibold text-sm"><%= ["John Doe", "Amelie Anderson", "Arthur Malo"][i] %></h4>
                <p class="text-gray-600 text-xs">Rôle fondateur</p>
                <div class="flex justify-center space-x-2 mt-2 fade-in">
                    <a href="#" class="text-gray-500 hover:text-gray-800 transition-colors duration-200">
