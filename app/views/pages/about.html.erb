<% content_for :title, t("views.pages.about.page_title") %>

<section class="public-hero-shell mb-14">
  <%= image_tag hero_image(:about_hero), class: "absolute inset-0 w-full h-full object-cover hero-img-filter", alt: "" %>
  <div class="hero-overlay"></div>
  <div class="relative hero-panel space-y-6">
    <p class="text-sm uppercase tracking-[0.4em] text-white/70"><%= t("views.pages.about.join_community") %></p>
    <h1 class="font-circographe text-3xl sm:text-4xl lg:text-5xl font-bold"><%= t("views.pages.about.heading") %></h1>
    <p class="max-w-3xl text-lg text-white/85 leading-relaxed"><%= t("views.pages.about.hero_description") %></p>
    <div class="flex flex-wrap gap-4">
      <%= link_to t("views.pages.about.join"), page_path('become_member'), class: "btn-primary shadow-lg" %>
      <%= link_to t("views.pages.about.discover_place"), page_path('association'), class: "btn-secondary shadow-lg" %>
    </div>
  </div>
</section>

<section class="public-surface-bordered p-6 sm:p-10" data-gsap-reveal>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-4" data-gsap-reveal-item>
      <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70"><%= t("views.pages.about.our_mission") %></p>
      <h2 class="text-3xl font-semibold text-gray-900"><%= t("views.pages.about.mission_heading") %></h2>
      <p class="text-gray-700 leading-relaxed"><%= t("views.pages.about.mission_text_1") %></p>
      <p class="text-gray-700 leading-relaxed"><%= t("views.pages.about.mission_text_2") %></p>
    </div>
    <div class="bg-brand-primary/5 border border-brand-primary/20 rounded-3xl p-6 space-y-4" data-gsap-reveal-item>
      <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Nos valeurs</p>
      <ul class="grid grid-cols-2 gap-3 text-gray-900">
        <li class="font-semibold">Accessibilité</li>
        <li class="font-semibold">Transmission</li>
        <li class="font-semibold">Expérimentation</li>
        <li class="font-semibold">Solidarité</li>
      </ul>
    </div>
  </div>
</section>

<section class="public-surface p-6 sm:p-10 mt-12 fade-in">
  <header class="text-center mb-10 space-y-3">
    <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Le Conseil d'administration</p>
    <h2 class="text-3xl font-semibold text-gray-900">Celles et ceux qui font tourner le Circographe</h2>
    <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">Le conseil d’administration coordonne l’autogestion et accompagne les bénévoles au quotidien.</p>
  </header>

  <% social_icons = {
    instagram: tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", class: "w-5 h-5") do
      tag.path(d: "M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h10zm-5 3.5A4.5 4.5 0 1 0 16.5 12 4.505 4.505 0 0 0 12 7.5zm0 2A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5zm5.25-3.75a1.25 1.25 0 1 1-1.25 1.25 1.25 1.25 0 0 1 1.25-1.25z")
    end,
    linkedin: tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", class: "w-5 h-5") do
      safe_join([
        tag.path(d: "M4.98 3.5A2.5 2.5 0 1 1 2.5 6a2.5 2.5 0 0 1 2.48-2.5zM3 8.75h3.96V21H3zm6.75 0H13.5v1.67h.05c.49-.93 1.68-1.9 3.46-1.9C20.4 8.52 21 11 21 14.43V21h-3.96v-5.7c0-1.36-.02-3.11-1.9-3.11-1.9 0-2.19 1.49-2.19 3v5.81H9.75z")
      ])
    end,
    behance: tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", class: "w-5 h-5") do
      tag.path(d: "M4.5 3H11a3.5 3.5 0 0 1 0 7c2.8 0 3.5 1.68 3.5 3.06C14.5 16.61 13.19 18 10.5 18H4.5V3zm3 10.5v2.5H10c1.11 0 1.5-.5 1.5-1.25S11.11 13.5 10 13.5H7.5zm0-6v2.5H10c1.05 0 1.5-.5 1.5-1.25S11.05 7.5 10 7.5H7.5zM17.25 7h4v1.5h-4zm-1.25 5.75A3.25 3.25 0 1 1 22.5 12v.75h-4.75c.1.92.83 1.75 2.25 1.75.93 0 1.88-.39 2.37-.87l1.08 1.92c-.86.79-2.2 1.45-3.7 1.45-2.64 0-4.25-1.73-4.25-3.25z")
    end
  } %>

  <div class="swiper multiple-slide-carousel swiper-container relative" data-controller="slider" data-slider-options-value='{"breakpoints":{"640":{"slidesPerView":1.5},"768":{"slidesPerView":2.2},"1280":{"slidesPerView":3.5}},"spaceBetween":24}'>
    <div class="swiper-wrapper mb-10">
      <% @board_members.each_with_index do |member, index| %>
        <div class="swiper-slide">
          <article class="bg-white rounded-3xl border border-gray-200 shadow-md px-6 py-8 h-full flex flex-col items-center text-center space-y-4">
            <div class="w-32 h-32 rounded-full overflow-hidden bg-gray-100 shadow-inner">
              <%= image_tag member.fetch(:avatar, "placeholder_avatar.webp"),
                            alt: member[:name],
                            class: "w-full h-full object-cover",
                            loading: (index.zero? ? "eager" : "lazy"),
                            decoding: "async" %>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-semibold text-gray-900"><%= member[:name] %></h3>
              <p class="text-sm uppercase tracking-[0.2em] text-brand-primary"><%= member[:role] %></p>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed flex-1"><%= member[:bio] %></p>
            <% if member[:socials].present? %>
              <div class="flex items-center justify-center gap-3 text-gray-400">
                <% member[:socials].each do |platform, url| %>
                  <% icon = social_icons[platform.to_sym] %>
                  <%= link_to url, target: "_blank", rel: "noopener", class: "hover:text-brand-primary transition", aria: { label: "Profil #{platform} de #{member[:name]}" } do %>
                    <%= icon || tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", class: "w-5 h-5") { tag.circle(cx: 12, cy: 12, r: 10) } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
            <span class="text-xs text-gray-400">Bénévole engagé·e</span>
          </article>
        </div>
      <% end %>
    </div>
    <div class="absolute flex justify-between items-center w-full -translate-x-1/2 left-1/2 top-1/2 -translate-y-1/2 z-50">
      <button class="swiper-button-prev swiper-arrow" aria-label="Précédent">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="swiper-button-next swiper-arrow" aria-label="Suivant">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<section class="public-surface-bordered p-6 sm:p-10 mt-12">
  <header class="text-center mb-8 space-y-2">
    <p class="text-sm uppercase tracking-[0.3em] text-brand-primary/70">Notre histoire</p>
    <h2 class="text-3xl font-semibold text-gray-800">Points de repère</h2>
  </header>
  <%#
    Éditer les entrées ici — status: :past | :present | :future
    Passer show_future: false pour masquer les étapes à venir.
  %>
  <%= render "shared/timeline", entries: [
    {
      year:   "2022",
      title:  "Ouverture du hangar",
      body:   "Lancement des créneaux d'entraînement et installation des ateliers graphiques.",
      status: :past
    },
    {
      year:   "2023",
      title:  "Premiers événements publics",
      body:   "Plateaux partagés, expositions et ateliers ouverts au quartier.",
      status: :past
    },
    {
      year:   "2024",
      title:  "Autogestion consolidée",
      body:   "Conseil d'administration élargi et équipes bénévoles structurées.",
      status: :past
    },
    {
      year:   "2025",
      title:  "Nouveaux partenariats & hors les murs",
      body:   "Actions extérieures, collaborations et projets itinérants.",
      status: :past
    },
    {
      year:   "2026",
      title:  "En cours",
      body:   "Saison active : nouvelles collaborations, accueil de compagnies et projets en cours.",
      status: :present
    },
    {
      year:   "2027",
      title:  "À venir",
      body:   "Projets à définir avec la communauté — à mettre à jour ici.",
      status: :future
    }
  ] %>
</section>

<section class="public-surface-bordered p-4 sm:p-10 mt-8 sm:mt-12 fade-in">
  <header class="text-center mb-5 sm:mb-10 space-y-2 sm:space-y-3">
    <p class="text-xs sm:text-sm uppercase tracking-[0.3em] text-brand-primary/70">Partenaires & soutiens</p>
    <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 leading-tight">Ils rendent l'aventure possible</h2>
    <p class="text-sm sm:text-base text-gray-600 max-w-2xl mx-auto leading-snug sm:leading-relaxed">Quelques partenaires mis en avant — la liste complète évolue avec les projets du lieu.</p>
  </header>

  <% partner_link_icon = tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: "1.75", class: "w-5 h-5") do
    safe_join([
      tag.path(stroke_linecap: "round", stroke_linejoin: "round", d: "M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5M7.5 16.5L21 3M15 3h6v6")
    ])
  end %>

  <div class="swiper multiple-slide-carousel swiper-container relative -mx-1 sm:mx-0" data-controller="slider" data-slider-options-value='{"slidesPerView":1,"spaceBetween":12,"breakpoints":{"640":{"slidesPerView":1.45,"spaceBetween":16},"768":{"slidesPerView":2.2,"spaceBetween":20},"1280":{"slidesPerView":3.5,"spaceBetween":24}}}'>
    <div class="swiper-wrapper mb-5 sm:mb-10">
      <% @partners.each_with_index do |partner, index| %>
        <div class="swiper-slide">
          <article class="bg-white rounded-2xl sm:rounded-3xl border border-gray-200 shadow-md px-4 py-5 sm:px-6 sm:py-8 h-full flex flex-col items-center text-center space-y-2.5 sm:space-y-4">
            <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden bg-gray-100 shadow-inner flex items-center justify-center p-3 sm:p-4 shrink-0">
              <% if partner[:logo].present? && asset_available?(partner[:logo]) %>
                <%= image_tag partner[:logo],
                              alt: partner[:name],
                              class: "max-h-full max-w-full object-contain",
                              loading: (index.zero? ? "eager" : "lazy"),
                              decoding: "async" %>
              <% else %>
                <span class="text-xl sm:text-2xl font-semibold text-brand-primary"><%= (partner[:initials].presence || partner[:name].to_s.first(2)).to_s.upcase %></span>
              <% end %>
            </div>
            <div class="space-y-0.5 sm:space-y-1">
              <h3 class="text-base sm:text-lg font-semibold text-gray-900 leading-snug"><%= partner[:name] %></h3>
              <p class="text-xs sm:text-sm uppercase tracking-[0.2em] text-brand-primary"><%= partner[:category] %></p>
            </div>
            <p class="text-xs sm:text-sm text-gray-600 leading-snug sm:leading-relaxed flex-1"><%= partner[:bio].presence || "Partenaire du Circographe." %></p>
            <% if partner[:url].present? %>
              <div class="flex items-center justify-center gap-3 text-gray-400 pt-0.5">
                <%= link_to partner[:url], target: "_blank", rel: "noopener", class: "hover:text-brand-primary transition", aria: { label: "Site web de #{partner[:name]}" } do %>
                  <%= partner_link_icon %>
                <% end %>
              </div>
            <% end %>
            <span class="text-xs text-gray-400 max-sm:hidden">Partenaire</span>
          </article>
        </div>
      <% end %>
    </div>
    <div class="absolute flex justify-between items-center w-full -translate-x-1/2 left-1/2 top-1/2 -translate-y-1/2 z-50">
      <button type="button" class="swiper-button-prev swiper-arrow" aria-label="Partenaire précédent">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="swiper-button-next swiper-arrow" aria-label="Partenaire suivant">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<section class="text-center mt-12 mb-12 fade-in">
  <%= link_to t("views.pages.about.join"), page_path('become_member'), class: "btn-primary px-8 py-4 tracking-wide font-bold shadow-lg" %>
</section>
