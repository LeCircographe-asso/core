<div class="flex items-center justify-end">
  <% actions.each do |action| %>
    <%= link_to action[:url],
                class: action[:class],
                title: action[:title],
                data: action[:data] || {} do %>
      <%= send(action[:icon]) %>
    <% end %>
  <% end %>
  <%# Repère visuel constant : sans ça, une ligne sans action conditionnelle (cas le plus courant)
      ne donne aucun indice que la ligne entière est cliquable pour voir la fiche. %>
  <span class="text-gray-300" title="Voir la fiche" aria-hidden="true">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</div>
