<div id="member-number-change-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 hidden" data-member-number-change-target="modal">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <!-- Header -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Changer le numéro d'adhérent</h3>
        <button type="button" 
                class="text-gray-400 hover:text-gray-600"
                data-action="click->member-number-change#hideChangeForm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Current Number Info -->
      <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <div class="text-sm text-blue-800">
          <strong>Numéro actuel :</strong> <%= current_member_number || "Non assigné" %>
        </div>
      </div>

      <!-- Form -->
      <%= form_with model: person, url: admin_user_path(Admin::Users::PersonRouteKey.call(person)), method: :patch,
          local: false, id: "member-number-change-form",
          data: { "member-number-change-target": "form" } do |form| %>
        
        <div class="space-y-4">
          <!-- Membership Type Selection -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Type d'adhésion pour le nouveau numéro
            </label>
            <%= form.select :new_membership_type, 
                membership_type_options,
                { selected: current_membership_type },
                { 
                  class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-[#1F5C55] focus:border-[#1F5C55]",
                  data: { "member-number-change-target": "membershipTypeSelect", "action": "change->member-number-change#updateSuggestedNumber" }
                } %>
          </div>

          <!-- Suggested Number -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Numéro suggéré
            </label>
            <div class="flex items-center space-x-2">
              <input type="text" 
                     value="<%= suggested_member_number(current_membership_type) %>"
                     readonly
                     class="flex-1 border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-50 text-gray-600"
                     data-member-number-change-target="suggestedNumber">
              <button type="button" 
                      class="px-3 py-2 text-sm font-medium text-[#1F5C55] hover:text-[#194A45] border border-[#1F5C55] rounded-md hover:bg-[#1F5C55] hover:text-white transition-colors duration-200"
                      data-action="click->member-number-change#generateNewNumber">
                Générer
              </button>
            </div>
          </div>

          <!-- Custom Number -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Ou saisir un numéro personnalisé
            </label>
            <%= form.text_field :member_number, 
                placeholder: "Ex: 25C001",
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-[#1F5C55] focus:border-[#1F5C55]",
                data: { "member-number-change-target": "customNumber" } %>
            <p class="text-xs text-gray-500 mt-1">
              Format: YYTNNN (ex: 25C001 pour Cirque, 25U001 pour Basique)
            </p>
          </div>

          <!-- Notes -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Notes (optionnel)
            </label>
            <%= form.text_area :change_notes, 
                placeholder: "Raison du changement...",
                rows: 2,
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-[#1F5C55] focus:border-[#1F5C55]" %>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end space-x-3 mt-6">
          <button type="button" 
                  class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500"
                  data-action="click->member-number-change#hideChangeForm">
            Annuler
          </button>
          <button type="submit" 
                  class="px-4 py-2 text-sm font-medium text-white bg-[#1F5C55] border border-transparent rounded-md hover:bg-[#194A45] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F5C55]">
            Changer le numéro
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
