<svg class="<%= icon_class %>"
     title="<%= icon_title %>"
     fill="none"
     stroke="currentColor"
     viewBox="0 0 24 24"
     <% tooltip_data.each do |key, value| %>
       data-<%= key %>="<%= value %>"
     <% end %>>
  <path stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="<%= svg_path %>" />
</svg>
