<!-- Header with gradient - Same design as membershipcard -->
<div class="relative w-full">
  <div class="h-24 w-full bg-gradient-to-r from-[#1F5C55] to-[#194A45] rounded-t-xl">
    <!-- Member Number Badge - Editable -->
    <div class="absolute top-4 left-4 px-3 py-1 text-xs font-semibold text-white rounded-full bg-white/20">
      <%= render Admin::Users::EditableMemberNumberComponent.new(
        person: person,
        current_user: current_user
      ) %>
    </div>
    
    <!-- User Role Badge -->
    <div class="absolute top-4 right-4 px-3 py-1 text-xs font-semibold text-white rounded-full <%= role_badge_class %>">
      <%= role_text %>
      <% if is_deleted %>
        <span class="ml-1 px-1 py-0.5 text-xs rounded-full bg-red-500 text-white">Supprimé</span>
      <% end %>
    </div>
    
    <!-- Create User Account Button - Top Right -->
    <% if is_person_without_user && !is_deleted %>
      <div class="absolute top-4 right-4 mt-8">
        <%= link_to new_admin_user_path(person_id: person.id), 
            class: "inline-flex items-center px-3 py-1 text-xs font-medium text-white bg-white/20 hover:bg-white/30 rounded-full transition-colors duration-200" do %>
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>
          Créer un espace utilisateur
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Avatar - Same positioning as membershipcard -->
  <div class="absolute -bottom-12 left-1/2 transform -translate-x-1/2">
    <div class="h-24 w-24 rounded-full border-4 border-white overflow-hidden bg-white shadow-lg <%= 'grayscale' if is_deleted %>">
      <%= image_tag avatar_image, alt: avatar_alt, class: "h-full w-full object-cover object-center scale-110" %>
      <% if crown? %>
        <div class="absolute -top-2 left-1/2 -translate-x-1/2">
          <span class="text-yellow-500 text-xl">👑</span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- User Info - Same spacing as membershipcard -->
<div class="pt-16 px-4 sm:px-6 pb-6">
  <div class="text-center mb-4 sm:mb-6">
    <h2 class="text-lg sm:text-xl font-bold text-gray-800">
      <%= user_name %>
    </h2>
    <% if is_deleted %>
      <p class="text-red-500 text-xs mt-1">
        Compte supprimé le <%= user.deleted_at.strftime("%d/%m/%Y à %H:%M") %>
      </p>
    <% end %>
  </div>
</div>
