<!-- Header with gradient and integrated avatar -->
<div class="relative">
  <div class="h-20 w-full bg-gradient-to-r from-[#1F5C55] to-[#194A45] rounded-t-lg flex items-center justify-between px-4">
    <!-- Member Number Badge - Always displayed -->
    <div class="px-2 py-1 text-xs font-semibold text-white rounded-full bg-white/20">
      <% if person.member_number.present? %>
        #<%= person.member_number %>
      <% else %>
        #--
      <% end %>
    </div>
    
    <!-- Avatar integrated in header - Premium medallion -->
    <div class="relative group">
      <!-- Outer glow ring -->
      <div class="h-16 w-16 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-all duration-300">
        <!-- Middle ring -->
        <div class="h-14 w-14 rounded-full bg-white/30 flex items-center justify-center">
          <!-- Inner medallion with premium styling -->
          <div class="h-12 w-12 rounded-full border-2 border-white overflow-hidden bg-white shadow-2xl flex items-center justify-center ring-1 ring-white/50 <%= 'grayscale' if is_deleted %> group-hover:shadow-3xl transition-all duration-300">
            <%= image_tag avatar_image, alt: avatar_alt, class: "h-full w-full object-cover object-center scale-110" %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- User Role Badge -->
    <div class="px-2 py-1 text-xs font-semibold text-white rounded-full <%= role_badge_class %>">
      <%= role_text %>
      <% if is_deleted %>
        <span class="ml-1 px-1 py-0.5 text-xs rounded-full bg-red-500 text-white">Supprimé</span>
      <% end %>
    </div>
  </div>
</div>

<!-- User Info -->
<div class="px-4 py-3">
  <div class="text-center mb-3">
    <h1 class="text-base font-bold text-gray-800 truncate px-2"><%= user_name %></h1>
    <% if is_deleted %>
      <p class="text-red-500 text-xs mt-1">
        Compte supprimé le <%= user.deleted_at.strftime("%d/%m/%Y à %H:%M") %>
      </p>
    <% end %>
  </div>
</div>
