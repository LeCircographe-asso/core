<div class="relative" data-controller="editable-member-number" data-editable-member-number-person-id-value="<%= person.id %>">
  <% if can_edit? %>
    <div class="flex items-center gap-2">
      <%= form_with model: person, url: admin_member_path(person), method: :patch,
          local: false, id: form_id, class: "flex-1",
          data: { "editable-member-number-target": "form" } do |form| %>
        <%= form.text_field :member_number,
            value: member_number,
            id: input_id,
            class: "block text-sm font-semibold text-white tabular-nums tracking-tight bg-transparent border-0 border-b border-white/30 focus:border-white/80 focus:outline-none focus:ring-0 w-24 placeholder-white/40",
            placeholder: "—",
            data: {
              "editable-member-number-target": "input",
              action: "blur->editable-member-number#save keydown->editable-member-number#handleKeydown"
            } %>
      <% end %>
      <button type="button"
          class="shrink-0 text-white/40 hover:text-white/80 text-xs transition-colors leading-none"
          data-action="click->editable-member-number#edit"
          data-editable-member-number-target="editButton">
        ✏️
      </button>
    </div>
  <% else %>
    <span class="block text-sm font-semibold text-white tabular-nums tracking-tight truncate">
      <%= member_number.present? ? member_number : "—" %>
    </span>
  <% end %>
</div>
