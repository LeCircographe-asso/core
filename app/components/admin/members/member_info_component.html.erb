<!-- Mobile-First Info Cards - Responsive Layout -->
<div class="space-y-4 lg:space-y-0 lg:grid lg:grid-cols-2 xl:grid-cols-2 2xl:grid-cols-2 lg:gap-4 xl:gap-6">
  <!-- Basic Info Card -->
  <div class="bg-gray-50 rounded-lg p-4 xl:p-3 border border-gray-200">
    <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-[#1F5C55]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      Informations de base
    </h3>
    <div class="space-y-2">
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Prénom</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(person.first_name) %></span>
      </div>
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Nom</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(person.last_name) %></span>
      </div>
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Date de naissance</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_date(person.birth_date) %></span>
      </div>
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Rôle</span>
        <span class="text-sm font-semibold text-gray-900">
          <% if user&.system_role.present? %>
            <%= display_role %>
          <% else %>
            <span class="text-orange-600 font-medium">Aucun compte</span>
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <!-- Professional Info Card -->
  <div class="bg-gray-50 rounded-lg p-4 xl:p-3 border border-gray-200">
    <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-[#1F5C55]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6" />
      </svg>
      Informations professionnelles
    </h3>
    <div class="space-y-2">
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Profession</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(person.occupation) %></span>
      </div>
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Spécialité</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(person.specialty) %></span>
      </div>
    </div>
  </div>

  <!-- Contact Info Card -->
  <div class="bg-gray-50 rounded-lg p-4 xl:p-3 border border-gray-200">
    <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-[#1F5C55]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Contact
    </h3>
    <div class="space-y-2">
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Email</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(user&.email_address || person.email) %></span>
      </div>
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-gray-600">Téléphone</span>
        <span class="text-sm font-semibold text-gray-900"><%= display_value(person.phone) %></span>
      </div>
      <% if person.address.present? %>
        <div class="py-0.5">
          <span class="text-sm font-medium text-gray-600 block mb-1">Adresse</span>
          <span class="text-sm font-semibold text-gray-900"><%= display_address %></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Preferences Card -->
  <div class="bg-gray-50 rounded-lg p-4 xl:p-3 border border-gray-200">
    <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-[#1F5C55]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Préférences
    </h3>
    <div class="grid grid-cols-2 gap-4">
      <div class="flex items-center py-0.5">
        <div class="h-4 w-4 rounded-full <%= preference_status(person.newsletter_subscribed) %> mr-3 flex-shrink-0"></div>
        <span class="text-sm font-medium text-gray-700">Newsletter</span>
      </div>
      <div class="flex items-center py-0.5">
        <div class="h-4 w-4 rounded-full <%= preference_status(person.image_rights) %> mr-3 flex-shrink-0"></div>
        <span class="text-sm font-medium text-gray-700">Droits image</span>
      </div>
      <div class="flex items-center py-0.5">
        <div class="h-4 w-4 rounded-full <%= preference_status(person.get_involved) %> mr-3 flex-shrink-0"></div>
        <span class="text-sm font-medium text-gray-700">S'impliquer</span>
      </div>
      <div class="flex items-center py-0.5">
        <div class="h-4 w-4 rounded-full <%= preference_status(person.dyslexic_font) %> mr-3 flex-shrink-0"></div>
        <span class="text-sm font-medium text-gray-700">Police dyslexique</span>
      </div>
    </div>
  </div>

  <!-- Internal Notes Card -->
  <% if person.notes.present? %>
  <div class="bg-amber-50 rounded-lg p-4 xl:p-3 border border-amber-200 lg:col-span-2">
    <h3 class="text-sm font-semibold text-amber-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      Notes internes
    </h3>
    <p class="text-sm text-amber-900 whitespace-pre-wrap"><%= person.notes %></p>
  </div>
  <% end %>

  <!-- Reduced Rate Card -->
  <% if person.reduced_rate_eligible %>
  <div class="bg-blue-50 rounded-lg p-4 xl:p-3 border border-blue-200">
    <h3 class="text-sm font-semibold text-blue-800 mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Tarif réduit
    </h3>
    <div class="space-y-2">
      <div class="flex justify-between items-center py-0.5">
        <span class="text-sm font-medium text-blue-700">Justificatif</span>
        <span class="text-sm font-semibold text-blue-900"><%= display_value(person.reduced_rate_reason) %></span>
      </div>
      <% if person.reduced_rate_proof.present? %>
        <div class="flex justify-between items-center py-0.5">
          <span class="text-sm font-medium text-blue-700">Preuve</span>
          <span class="text-sm font-semibold text-blue-900"><%= display_value(person.reduced_rate_proof) %></span>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>
</div>
