# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# Keep assignments plain (KEY=$KEY): Kamal's own resolver for this file — not a real
# shell interpreter — doesn't evaluate if/fi blocks or ${VAR:-default} parameter
# expansion (silently drops the former, leaves the latter's ":-}" as literal text
# appended to the value). Both previously left RAILS_MASTER_KEY/SECRET_KEY_BASE
# broken in CI deploys, undetected because local manual deploys already had these
# exported in the shell. For a local deploy, export them yourself beforehand, e.g.:
#   export RAILS_MASTER_KEY=$(cat config/master.key)

# Registry (GitHub Actions: org secret KAMAL_REGISTRY_PASSWORD; local: export or gh token)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key (GitHub Actions: org secret RAILS_MASTER_KEY; local: export from config/master.key)
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Staging container only (config/deploy.staging.yml env.secret). CI sets org secret; optional locally.
SECRET_KEY_BASE=$SECRET_KEY_BASE
