# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep
# /docs - Commented out, we want to track TDD documentation
/node_modules
/.cursorrules
/.cert

# Add SimpleCov coverage reports to ignore list
/coverage/

# Secrets et configurations sensibles
/.kamal/secrets
/.kamal/secrets.*
/config/credentials/*.key
/config/database.yml.local
/config/secrets.yml
.env.local
.env.production
.env.staging

# Certificats SSL
/.cert/
*.pem
*.key
*.crt
*.p12

# Logs sensibles
/log/production.log
/log/staging.log

# Temporary files
temp_*.rb
test_*.rb
*_status.rb
cookies.txt
db/schema_clean.rb

# CI / linter outputs (never commit these)
rspec.xml
rubocop.json
identifier.sqlite

# IDE files
/.idea

# Cursor IDE — agent plans (local); keep .cursor/rules/ in repo
/.cursor/plans/

# Watchman (not used - we use Tailwind watcher instead)
/watchman
