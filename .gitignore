# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep
# /docs - Commented out, we want to track TDD documentation
/node_modules
/.cursorrules
/.cert

# Add SimpleCov coverage reports to ignore list
/coverage/

# Secrets et configurations sensibles
/.kamal/secrets
/.kamal/secrets.*
/config/credentials/*.key
/config/database.yml.local
/config/secrets.yml
.env.local
.env.production
.env.staging

# Certificats SSL
/.cert/
*.pem
*.key
*.crt
*.p12

# Logs sensibles
/log/production.log
/log/staging.log

# Temporary files
temp_*.rb
test_*.rb
*_status.rb
cookies.txt
db/schema_clean.rb

# IDE files
/.idea

# Watchman (not used - we use Tailwind watcher instead)
/watchman
docs/CONTRIBUTING.md
docs/DOCUMENTATION_ORGANIZATION.md
docs/OPTIMIZATION_SUMMARY.md
docs/PIPELINE_ARCHITECTURE.md
docs/RAKE_TASKS.md
docs/README_SQLITE.md
docs/ROADMAP.md
docs/WORKFLOWS_GUIDE.md
docs/data_integrity.md
docs/data_integrity_implementation.md
docs/documentations/
docs/optionnal/
docs/profile/
